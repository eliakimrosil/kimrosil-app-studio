<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/m3_surface_container_highest" />
            <stroke android:width="1.2dp" android:color="@color/m3_primary" />
            <corners android:radius="12dp" />
            <padding android:bottom="12dp" android:left="16dp" android:right="16dp" android:top="12dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/m3_surface_container" />
            <stroke android:width="1.2dp" android:color="@color/m3_outline" />
            <corners android:radius="12dp" />
            <padding android:bottom="12dp" android:left="16dp" android:right="16dp" android:top="12dp" />
        </shape>
    </item>
</selector>
