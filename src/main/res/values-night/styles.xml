<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Professional Flat Button Style - Eliminates muddy Android elevation shadows -->
    <style name="AppButton" parent="@android:style/Widget.DeviceDefault.Button">
        <item name="android:stateListAnimator">@null</item>
        <item name="android:elevation">0dp</item>
        <item name="android:translationZ">0dp</item>
        <item name="android:textAllCaps">false</item>
    </style>

    <style name="AppTheme" parent="@android:style/Theme.DeviceDefault.DayNight">
        <item name="android:windowActionBar">false</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:colorPrimary">@color/primary_accent</item>
        <item name="android:colorPrimaryDark">@color/bg_surface</item>
        <item name="android:colorAccent">@color/primary_accent</item>
        <item name="android:windowBackground">@color/bg_primary</item>
        <item name="android:statusBarColor">@color/bg_surface</item>
        <item name="android:navigationBarColor">@color/bg_surface</item>
        <item name="android:textColorPrimary">@color/text_primary</item>
        <item name="android:textColorSecondary">@color/text_secondary</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
        <item name="android:buttonStyle">@style/AppButton</item>
    </style>
</resources>
