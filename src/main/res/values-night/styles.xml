<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Adaptive DayNight Theme (Follows System) -->
    <style name="AppTheme" parent="@android:style/Theme.DeviceDefault.DayNight">
        <item name="android:windowActionBar">false</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:colorPrimary">@color/m3_primary</item>
        <item name="android:colorPrimaryDark">@color/m3_surface</item>
        <item name="android:colorAccent">@color/m3_primary</item>
        <item name="android:windowBackground">@color/m3_surface</item>
        <item name="android:statusBarColor">@color/m3_surface</item>
        <item name="android:navigationBarColor">@color/m3_surface</item>
        <item name="android:textColorPrimary">@color/m3_on_surface</item>
        <item name="android:textColorSecondary">@color/m3_on_surface_variant</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
    </style>

    <!-- Explicit Light Theme (Forced Light Mode) -->
    <style name="AppTheme.Light" parent="@android:style/Theme.DeviceDefault.Light">
        <item name="android:windowActionBar">false</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:colorPrimary">@color/m3_primary</item>
        <item name="android:colorPrimaryDark">@color/m3_surface</item>
        <item name="android:colorAccent">@color/m3_primary</item>
        <item name="android:windowBackground">@color/m3_surface</item>
        <item name="android:statusBarColor">@color/m3_surface</item>
        <item name="android:navigationBarColor">@color/m3_surface</item>
        <item name="android:textColorPrimary">@color/m3_on_surface</item>
        <item name="android:textColorSecondary">@color/m3_on_surface_variant</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
    </style>

    <!-- Explicit Dark Theme (Forced Dark Mode) -->
    <style name="AppTheme.Dark" parent="@android:style/Theme.DeviceDefault">
        <item name="android:windowActionBar">false</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:colorPrimary">@color/m3_primary</item>
        <item name="android:colorPrimaryDark">@color/m3_surface</item>
        <item name="android:colorAccent">@color/m3_primary</item>
        <item name="android:windowBackground">@color/m3_surface</item>
        <item name="android:statusBarColor">@color/m3_surface</item>
        <item name="android:navigationBarColor">@color/m3_surface</item>
        <item name="android:textColorPrimary">@color/m3_on_surface</item>
        <item name="android:textColorSecondary">@color/m3_on_surface_variant</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
    </style>
</resources>
