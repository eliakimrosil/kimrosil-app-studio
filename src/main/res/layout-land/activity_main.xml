<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root_layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/bg_main"
    android:padding="14dp">

    <!-- Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingBottom="8dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tv_app_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="PhVat"
                android:textColor="@color/accent_emerald"
                android:textSize="20sp"
                android:textStyle="bold"
                android:letterSpacing="0.02" />

            <TextView
                android:id="@+id/tv_app_subtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/vat_title"
                android:textColor="@color/text_mid"
                android:textSize="11sp" />
        </LinearLayout>

        <Button
            android:id="@+id/btn_toggle_history"
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:text="⏱ History"
            android:textColor="@color/text_mid"
            android:background="@drawable/chip_btn"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:textSize="11sp"
            android:layout_marginEnd="6dp" />

        <Button
            android:id="@+id/btn_theme"
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:text="☀ Light"
            android:textColor="@color/accent_emerald"
            android:background="@drawable/chip_btn"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:textSize="11sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Dual Pane Split -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal"
        android:baselineAligned="false">

        <!-- Left Pane: Input & Adjustments -->
        <ScrollView
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginEnd="8dp"
            android:scrollbars="none">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <!-- Hero Input Card -->
                <LinearLayout
                    android:id="@+id/card_amount"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:background="@drawable/card_background"
                    android:padding="12dp"
                    android:layout_marginBottom="8dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:paddingBottom="4dp">

                        <TextView
                            android:id="@+id/tv_amount_label"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/enter_amount"
                            android:textColor="@color/text_mid"
                            android:textSize="11sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Supports (+ − × ÷)"
                            android:textColor="@color/text_muted"
                            android:textSize="10sp" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/ll_input_box"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:background="@drawable/edittext_bg"
                        android:paddingStart="10dp"
                        android:paddingEnd="10dp">

                        <TextView
                            android:id="@+id/tv_peso_symbol"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="₱"
                            android:textColor="@color/accent_emerald"
                            android:textSize="22sp"
                            android:textStyle="bold" />

                        <EditText
                            android:id="@+id/et_amount"
                            android:layout_width="0dp"
                            android:layout_height="44dp"
                            android:layout_weight="1"
                            android:background="@null"
                            android:hint="0.00"
                            android:textColorHint="@color/text_muted"
                            android:textColor="@color/text_high"
                            android:textSize="22sp"
                            android:textStyle="bold"
                            android:inputType="text"
                            android:digits="0123456789.+-*/ "
                            android:paddingStart="8dp"
                            android:paddingEnd="8dp"
                            android:singleLine="true" />
                    </LinearLayout>

                    <RadioGroup
                        android:id="@+id/rg_vat_mode"
                        android:layout_width="match_parent"
                        android:layout_height="36dp"
                        android:orientation="horizontal"
                        android:layout_marginTop="8dp">

                        <RadioButton
                            android:id="@+id/rb_inclusive"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="1"
                            android:checked="true"
                            android:text="@string/inclusive_label"
                            android:textColor="@color/text_high"
                            android:textSize="12sp"
                            android:gravity="center_vertical" />

                        <RadioButton
                            android:id="@+id/rb_exclusive"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="1"
                            android:text="@string/exclusive_label"
                            android:textColor="@color/text_high"
                            android:textSize="12sp"
                            android:gravity="center_vertical" />
                    </RadioGroup>
                </LinearLayout>

                <!-- Adjustments Card -->
                <LinearLayout
                    android:id="@+id/card_mode"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:background="@drawable/card_background"
                    android:padding="12dp"
                    android:layout_marginBottom="8dp">

                    <Switch
                        android:id="@+id/sw_senior_pwd"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/senior_pwd_label"
                        android:textColor="@color/text_high"
                        android:textSize="12sp" />

                    <LinearLayout
                        android:id="@+id/ll_vat_rate_row"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginTop="6dp">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="VAT Rate:"
                            android:textColor="@color/text_mid"
                            android:textSize="12sp" />

                        <Button
                            android:id="@+id/chip_vat_12"
                            android:layout_width="wrap_content"
                            android:layout_height="28dp"
                            android:text="12% Std"
                            android:background="@drawable/chip_btn"
                            android:textSize="10sp"
                            android:paddingStart="8dp"
                            android:paddingEnd="8dp"
                            android:layout_marginEnd="4dp" />

                        <Button
                            android:id="@+id/chip_vat_0"
                            android:layout_width="wrap_content"
                            android:layout_height="28dp"
                            android:text="0% Exempt"
                            android:background="@drawable/chip_btn"
                            android:textSize="10sp"
                            android:paddingStart="8dp"
                            android:paddingEnd="8dp" />
                    </LinearLayout>

                    <View
                        android:id="@+id/divider_mode"
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="@color/stroke_card"
                        android:layout_marginTop="6dp"
                        android:layout_marginBottom="6dp" />

                    <Switch
                        android:id="@+id/sw_wht"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/wht_label"
                        android:textColor="@color/text_high"
                        android:textSize="12sp" />

                    <LinearLayout
                        android:id="@+id/ll_wht_rate_row"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginTop="6dp"
                        android:visibility="gone">

                        <Button
                            android:id="@+id/chip_wht_none"
                            android:layout_width="0dp"
                            android:layout_height="28dp"
                            android:layout_weight="1"
                            android:text="None"
                            android:background="@drawable/chip_btn"
                            android:textSize="10sp"
                            android:layout_marginEnd="3dp" />

                        <Button
                            android:id="@+id/chip_wht_1"
                            android:layout_width="0dp"
                            android:layout_height="28dp"
                            android:layout_weight="1"
                            android:text="1%"
                            android:background="@drawable/chip_btn"
                            android:textSize="10sp"
                            android:layout_marginEnd="3dp" />

                        <Button
                            android:id="@+id/chip_wht_2"
                            android:layout_width="0dp"
                            android:layout_height="28dp"
                            android:layout_weight="1"
                            android:text="2%"
                            android:background="@drawable/chip_btn"
                            android:textSize="10sp"
                            android:layout_marginEnd="3dp" />

                        <Button
                            android:id="@+id/chip_wht_5"
                            android:layout_width="0dp"
                            android:layout_height="28dp"
                            android:layout_weight="1"
                            android:text="5%"
                            android:background="@drawable/chip_btn"
                            android:textSize="10sp" />
                    </LinearLayout>

                    <!-- Hidden legacy stubs -->
                    <LinearLayout
                        android:id="@+id/card_wht"
                        android:layout_width="0dp"
                        android:layout_height="0dp"
                        android:visibility="gone">
                        <TextView android:id="@+id/tv_wht_label" android:layout_width="0dp" android:layout_height="0dp" />
                        <View android:id="@+id/divider_wht" android:layout_width="0dp" android:layout_height="0dp" />
                    </LinearLayout>
                </LinearLayout>

                <Button
                    android:id="@+id/btn_clear"
                    android:layout_width="match_parent"
                    android:layout_height="40dp"
                    android:text="@string/clear"
                    android:textColor="@color/text_mid"
                    android:background="@drawable/btn_action"
                    android:textSize="12sp" />
            </LinearLayout>
        </ScrollView>

        <!-- Right Pane: Ledger & History -->
        <ScrollView
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:scrollbars="none">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <!-- Ledger Card -->
                <LinearLayout
                    android:id="@+id/card_breakdown"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:background="@drawable/card_background"
                    android:padding="12dp"
                    android:layout_marginBottom="8dp">

                    <TextView
                        android:id="@+id/tv_breakdown_label"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="INVOICE LEDGER"
                        android:textColor="@color/text_muted"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:letterSpacing="0.05"
                        android:paddingBottom="8dp" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:paddingBottom="6dp">

                        <TextView
                            android:id="@+id/tv_vatable_label"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/vatable_sales"
                            android:textColor="@color/text_mid"
                            android:textSize="12sp" />

                        <TextView
                            android:id="@+id/tv_vatable_val"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="₱0.00"
                            android:textColor="@color/text_high"
                            android:textSize="13sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:paddingBottom="6dp">

                        <TextView
                            android:id="@+id/tv_vat_label"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/vat_amount"
                            android:textColor="@color/text_mid"
                            android:textSize="12sp" />

                        <TextView
                            android:id="@+id/tv_vat_val"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="₱0.00"
                            android:textColor="@color/accent_cyan"
                            android:textSize="13sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/ll_discount_row"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:visibility="gone"
                        android:paddingBottom="6dp">

                        <TextView
                            android:id="@+id/tv_discount_label"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/discount_amount"
                            android:textColor="@color/accent_gold"
                            android:textSize="12sp" />

                        <TextView
                            android:id="@+id/tv_discount_val"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="-₱0.00"
                            android:textColor="@color/accent_gold"
                            android:textSize="13sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/ll_wht_result_row"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:visibility="gone"
                        android:paddingBottom="6dp">

                        <TextView
                            android:id="@+id/tv_wht_amount_label"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Less: EWT"
                            android:textColor="@color/accent_orange"
                            android:textSize="12sp" />

                        <TextView
                            android:id="@+id/tv_wht_amount_val"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="-₱0.00"
                            android:textColor="@color/accent_orange"
                            android:textSize="13sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <View
                        android:id="@+id/divider_breakdown"
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="@color/stroke_card"
                        android:layout_marginTop="2dp"
                        android:layout_marginBottom="8dp" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:paddingBottom="4dp">

                        <TextView
                            android:id="@+id/tv_total_label"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/total_amount"
                            android:textColor="@color/text_high"
                            android:textSize="14sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tv_total_val"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="₱0.00"
                            android:textColor="@color/accent_emerald"
                            android:textSize="22sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/ll_net_after_wht_row"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:visibility="gone"
                        android:paddingTop="2dp">

                        <TextView
                            android:id="@+id/tv_net_after_wht_label"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Net Due / Receivable"
                            android:textColor="@color/text_mid"
                            android:textSize="12sp" />

                        <TextView
                            android:id="@+id/tv_net_after_wht_val"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="₱0.00"
                            android:textColor="@color/accent_emerald"
                            android:textSize="14sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/tv_formula_note"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:text="Formula: Net = Amount ÷ 1.12 | VAT = Net × 12%"
                        android:textColor="@color/text_muted"
                        android:textSize="10sp" />
                </LinearLayout>

                <!-- History Card -->
                <LinearLayout
                    android:id="@+id/card_history"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:background="@drawable/card_background"
                    android:padding="12dp"
                    android:layout_marginBottom="8dp"
                    android:visibility="gone">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:paddingBottom="6dp">

                        <TextView
                            android:id="@+id/tv_history_label"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/history_label"
                            android:textColor="@color/text_mid"
                            android:textSize="11sp"
                            android:textStyle="bold" />

                        <Button
                            android:id="@+id/btn_clear_history"
                            android:layout_width="wrap_content"
                            android:layout_height="24dp"
                            android:text="Clear"
                            android:background="@drawable/chip_btn"
                            android:textSize="10sp"
                            android:paddingStart="8dp"
                            android:paddingEnd="8dp" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/ll_history_list"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical" />
                </LinearLayout>

                <Button
                    android:id="@+id/btn_copy"
                    android:layout_width="match_parent"
                    android:layout_height="40dp"
                    android:text="@string/copy"
                    android:textColor="@color/accent_emerald"
                    android:background="@drawable/btn_action"
                    android:textSize="12sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </ScrollView>

    </LinearLayout>
</LinearLayout>
