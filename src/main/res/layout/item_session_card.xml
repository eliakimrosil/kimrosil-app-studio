<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:background="@drawable/bg_card_container"
    android:padding="12dp"
    android:layout_marginBottom="8dp">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvItemSpecies"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Hard Maple — Hand Plane"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="@color/m3_on_surface" />

        <TextView
            android:id="@+id/tvItemMeta"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Janka 1450 lbf • 45° Bed • Oct 10, 16:30"
            android:textSize="12sp"
            android:textColor="@color/m3_on_surface_variant"
            android:layout_marginTop="2dp" />
    </LinearLayout>

    <TextView
        android:id="@+id/tvItemRisk"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="42% Risk"
        android:textSize="13sp"
        android:textStyle="bold"
        android:textColor="#E65100"
        android:layout_marginEnd="8dp" />

    <Button
        android:id="@+id/btnItemDelete"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:minWidth="48dp"
        android:minHeight="48dp"
        android:text="✕"
        android:textSize="14sp"
        android:textColor="@color/m3_on_surface_variant"
        android:background="@drawable/bg_card_outline"
        android:contentDescription="Delete saved planing session from ledger" />
</LinearLayout>