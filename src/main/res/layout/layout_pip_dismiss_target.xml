<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/pipDismissRoot"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:gravity="center_horizontal"
    android:orientation="vertical">

    <FrameLayout
        android:id="@+id/pipDismissBadge"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:background="@drawable/bg_pip_dismiss_target"
        android:elevation="10dp">

        <TextView
            android:id="@+id/tvDismissIcon"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:text="✕"
            android:textColor="#FFFFFF"
            android:textSize="20sp"
            android:textStyle="bold" />
    </FrameLayout>

    <TextView
        android:id="@+id/pipDismissHint"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:background="@drawable/bg_pip_dismiss_label"
        android:letterSpacing="0.06"
        android:paddingStart="8dp"
        android:paddingTop="3dp"
        android:paddingEnd="8dp"
        android:paddingBottom="3dp"
        android:text="DRAG HERE TO CLOSE"
        android:textColor="#A1A1AA"
        android:textSize="10sp"
        android:textStyle="bold" />
</LinearLayout>
