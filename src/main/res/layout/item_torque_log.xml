<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_log_item_card"
    android:padding="12dp"
    android:layout_marginBottom="8dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/tvLogTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="ASME B16.5 4&quot; (150#)"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="@color/m3_on_surface" />

        <TextView
            android:id="@+id/tvLogDate"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Oct 12, 2026"
            android:textSize="11sp"
            android:textColor="@color/m3_on_surface_variant" />
    </LinearLayout>

    <TextView
        android:id="@+id/tvLogSubtitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="8 Bolts — 60.0 ft-lb (4/4 Passes)"
        android:textSize="12sp"
        android:textColor="@color/m3_primary"
        android:layout_marginTop="2dp" />
</LinearLayout>