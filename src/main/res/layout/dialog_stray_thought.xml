<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/card_sanctuary"
    android:orientation="vertical"
    android:padding="20dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Stray Thought Buffer"
        android:textColor="@color/textPrimary"
        android:textSize="18sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="Dump distracting thoughts in &lt; 2s without leaving your task."
        android:textColor="@color/textSecondary"
        android:textSize="13sp" />

    <EditText
        android:id="@+id/etThoughtInput"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:background="@drawable/edittext_calm"
        android:hint="e.g. Check electricity bill, buy oat milk..."
        android:inputType="textCapSentences|textMultiLine"
        android:maxLines="3"
        android:textColor="@color/textPrimary"
        android:textColorHint="@color/m3_outline"
        android:textSize="15sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:gravity="end"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btnCancelThought"
            android:layout_width="wrap_content"
            android:layout_height="42dp"
            android:background="?android:attr/selectableItemBackground"
            android:text="Back to Focus"
            android:textAllCaps="false"
            android:textColor="@color/textSecondary"
            android:textSize="14sp" />

        <Button
            android:id="@+id/btnSaveThought"
            android:layout_width="wrap_content"
            android:layout_height="42dp"
            android:layout_marginStart="10dp"
            android:background="@drawable/btn_action"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:text="Park It"
            android:textAllCaps="false"
            android:textColor="@color/btnTextColor"
            android:textSize="14sp"
            android:textStyle="bold" />
    </LinearLayout>
</LinearLayout>
