<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="@color/bg_main">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="14dp"
        android:paddingEnd="14dp"
        android:paddingTop="14dp"
        android:paddingBottom="28dp">

        <!-- Header Bar -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="10dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tv_header_brand"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/app_name"
                    android:textColor="@color/accent_emerald"
                    android:textSize="22sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.02" />

                <TextView
                    android:id="@+id/tv_header_subtitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/app_subtitle"
                    android:textColor="@color/text_mid"
                    android:textSize="11sp" />
            </LinearLayout>

            <!-- Working Theme Switcher Button (VatCal PH Chip Style) -->
            <Button
                android:id="@+id/btn_theme_toggle"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:minHeight="48dp"
                android:minWidth="84dp"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:background="@drawable/chip_btn"
                android:text="🌓 Auto"
                android:textColor="@color/accent_emerald"
                android:textSize="12sp"
                android:textStyle="bold"
                android:elevation="0dp"
                android:stateListAnimator="@null"
                android:textAllCaps="false" />
        </LinearLayout>

        <!-- Fasting Arc Custom View -->
        <com.kimrosil.fastarc.FastArcView
            android:id="@+id/fast_arc_view"
            android:layout_width="match_parent"
            android:layout_height="300dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginBottom="10dp" />

        <!-- Main Action Button (VatCal PH Action Style) -->
        <Button
            android:id="@+id/btn_toggle_fast"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:minHeight="52dp"
            android:elevation="0dp"
            android:stateListAnimator="@null"
            android:background="@drawable/btn_fast_primary"
            android:text="@string/btn_start_fast"
            android:textColor="@color/accent_emerald"
            android:textSize="15sp"
            android:textStyle="bold"
            android:letterSpacing="0.04"
            android:layout_marginBottom="14dp" />

        <!-- Quick Start Time Adjustment Card -->
        <LinearLayout
            android:id="@+id/card_start_adjust"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/card_telemetry"
            android:orientation="vertical"
            android:padding="12dp"
            android:layout_marginBottom="12dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="8dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="QUICK START ADJUST"
                    android:textColor="@color/text_muted"
                    android:textSize="10sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.05" />

                <Button
                    android:id="@+id/btn_custom_time"
                    android:layout_width="wrap_content"
                    android:layout_height="48dp"
                    android:minHeight="48dp"
                    android:minWidth="80dp"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:background="@drawable/chip_btn"
                    android:text="Custom Time"
                    android:textColor="@color/accent_emerald"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:elevation="0dp"
                    android:stateListAnimator="@null"
                    android:textAllCaps="false" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/chip_adjust_now"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="1"
                    android:minHeight="48dp"
                    android:background="@drawable/chip_quick_btn"
                    android:text="@string/chip_now"
                    android:textColor="@color/text_high"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:elevation="0dp"
                    android:stateListAnimator="@null"
                    android:layout_marginEnd="4dp" />

                <Button
                    android:id="@+id/chip_adjust_15m"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="1"
                    android:minHeight="48dp"
                    android:background="@drawable/chip_quick_btn"
                    android:text="@string/chip_minus_15m"
                    android:textColor="@color/text_high"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:elevation="0dp"
                    android:stateListAnimator="@null"
                    android:layout_marginEnd="4dp" />

                <Button
                    android:id="@+id/chip_adjust_30m"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="1"
                    android:minHeight="48dp"
                    android:background="@drawable/chip_quick_btn"
                    android:text="@string/chip_minus_30m"
                    android:textColor="@color/text_high"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:elevation="0dp"
                    android:stateListAnimator="@null"
                    android:layout_marginEnd="4dp" />

                <Button
                    android:id="@+id/chip_adjust_1h"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="1"
                    android:minHeight="48dp"
                    android:background="@drawable/chip_quick_btn"
                    android:text="@string/chip_minus_1h"
                    android:textColor="@color/text_high"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:elevation="0dp"
                    android:stateListAnimator="@null"
                    android:layout_marginEnd="4dp" />

                <Button
                    android:id="@+id/chip_adjust_2h"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="1"
                    android:minHeight="48dp"
                    android:background="@drawable/chip_quick_btn"
                    android:text="@string/chip_minus_2h"
                    android:textColor="@color/text_high"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:elevation="0dp"
                    android:stateListAnimator="@null" />
            </LinearLayout>
        </LinearLayout>

        <!-- Tabular 2-Column Telemetry Card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/card_telemetry"
            android:orientation="vertical"
            android:padding="12dp"
            android:layout_marginBottom="12dp">

            <!-- Top Row: Started & Goal -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/telemetry_started"
                        android:textColor="@color/text_muted"
                        android:textSize="10sp"
                        android:textStyle="bold"
                        android:letterSpacing="0.05" />

                    <TextView
                        android:id="@+id/tv_telemetry_start_time"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="--:--"
                        android:textColor="@color/text_high"
                        android:textSize="18sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tv_telemetry_start_date"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Not Started"
                        android:textColor="@color/text_mid"
                        android:textSize="11sp" />
                </LinearLayout>

                <!-- Hairline Vertical Divider -->
                <View
                    android:layout_width="1dp"
                    android:layout_height="match_parent"
                    android:background="@drawable/divider_hairline"
                    android:layout_marginStart="8dp"
                    android:layout_marginEnd="12dp" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/telemetry_target"
                        android:textColor="@color/text_muted"
                        android:textSize="10sp"
                        android:textStyle="bold"
                        android:letterSpacing="0.05" />

                    <TextView
                        android:id="@+id/tv_telemetry_goal_time"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="--:--"
                        android:textColor="@color/text_high"
                        android:textSize="18sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tv_telemetry_goal_date"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="16h Target"
                        android:textColor="@color/text_mid"
                        android:textSize="11sp" />
                </LinearLayout>
            </LinearLayout>

            <!-- Hairline Horizontal Divider -->
            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@drawable/divider_hairline"
                android:layout_marginTop="10dp"
                android:layout_marginBottom="10dp" />

            <!-- Hydration Tracker Row -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/telemetry_water"
                        android:textColor="@color/text_muted"
                        android:textSize="10sp"
                        android:textStyle="bold"
                        android:letterSpacing="0.05" />

                    <TextView
                        android:id="@+id/tv_water_count"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0 ml"
                        android:textColor="@color/water_accent"
                        android:textSize="18sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <Button
                    android:id="@+id/btn_water_add"
                    android:layout_width="wrap_content"
                    android:layout_height="48dp"
                    android:minHeight="48dp"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp"
                    android:background="@drawable/btn_tonal_action"
                    android:text="@string/action_log_water"
                    android:textColor="@color/water_accent"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:elevation="0dp"
                    android:stateListAnimator="@null"
                    android:textAllCaps="false"
                    android:layout_marginEnd="6dp" />

                <Button
                    android:id="@+id/btn_water_reset"
                    android:layout_width="wrap_content"
                    android:layout_height="48dp"
                    android:minHeight="48dp"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:background="@drawable/btn_tonal_action"
                    android:text="@string/action_reset_water"
                    android:textColor="@color/text_mid"
                    android:textSize="12sp"
                    android:elevation="0dp"
                    android:stateListAnimator="@null"
                    android:textAllCaps="false" />
            </LinearLayout>
        </LinearLayout>

        <!-- 4-Stage Metabolic Progress Guide -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/card_telemetry"
            android:orientation="vertical"
            android:padding="12dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="16:8 METABOLIC PHASES"
                android:textColor="@color/text_muted"
                android:textSize="10sp"
                android:textStyle="bold"
                android:letterSpacing="0.05"
                android:layout_marginBottom="8dp" />

            <!-- Stage 1 -->
            <LinearLayout
                android:id="@+id/row_stage_1"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="6dp"
                android:layout_marginBottom="4dp">

                <TextView
                    android:id="@+id/tv_stage_1_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/stage_1_name"
                    android:textColor="@color/stage_digestion"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/stage_1_desc"
                    android:textColor="@color/text_mid"
                    android:textSize="11sp" />
            </LinearLayout>

            <!-- Stage 2 -->
            <LinearLayout
                android:id="@+id/row_stage_2"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="6dp"
                android:layout_marginBottom="4dp">

                <TextView
                    android:id="@+id/tv_stage_2_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/stage_2_name"
                    android:textColor="@color/stage_glycogen"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/stage_2_desc"
                    android:textColor="@color/text_mid"
                    android:textSize="11sp" />
            </LinearLayout>

            <!-- Stage 3 -->
            <LinearLayout
                android:id="@+id/row_stage_3"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="6dp"
                android:layout_marginBottom="4dp">

                <TextView
                    android:id="@+id/tv_stage_3_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/stage_3_name"
                    android:textColor="@color/stage_ketosis"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/stage_3_desc"
                    android:textColor="@color/text_mid"
                    android:textSize="11sp" />
            </LinearLayout>

            <!-- Stage 4 -->
            <LinearLayout
                android:id="@+id/row_stage_4"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="6dp">

                <TextView
                    android:id="@+id/tv_stage_4_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/stage_4_name"
                    android:textColor="@color/stage_autophagy"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/stage_4_desc"
                    android:textColor="@color/text_mid"
                    android:textSize="11sp" />
            </LinearLayout>
        </LinearLayout>

        <!-- Lock Screen & Widget Guide Note -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:text="🔒 Lock-Screen Widget: Add FastArc to your lock screen (Keyguard) or home screen for live 16:8 countdown without unlocking."
            android:textColor="@color/text_mid"
            android:textSize="11sp"
            android:gravity="center" />
    </LinearLayout>
</ScrollView>
