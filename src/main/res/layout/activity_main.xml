<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/m3_surface"
    android:fillViewport="true"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Top Header Action Bar -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingBottom="12dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvBrandTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/app_name"
                    android:textColor="@color/m3_on_surface"
                    android:textSize="22sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/app_subtitle"
                    android:textColor="@color/m3_text_muted"
                    android:textSize="11sp"
                    android:letterSpacing="0.05" />
            </LinearLayout>

            <!-- Settings & About Vector Button (48x48dp target) -->
            <ImageButton
                android:id="@+id/btnSettings"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="@drawable/bg_settings_button"
                android:contentDescription="@string/settings_title"
                android:padding="12dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_settings" />
        </LinearLayout>

        <!-- Storage Tank Model Selector (Segmented Chips) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="12dp">

            <Button
                android:id="@+id/btnTankDiesel"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:layout_marginEnd="4dp"
                android:background="@drawable/bg_chip_selected"
                android:text="@string/tank_diesel"
                android:textColor="@color/m3_on_primary"
                android:textSize="12sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btnTankPrem91"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:layout_marginStart="2dp"
                android:layout_marginEnd="2dp"
                android:background="@drawable/bg_chip_unselected"
                android:text="@string/tank_prem91"
                android:textColor="@color/m3_on_surface"
                android:textSize="12sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btnTankPrem95"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:layout_marginStart="4dp"
                android:background="@drawable/bg_chip_unselected"
                android:text="@string/tank_prem95"
                android:textColor="@color/m3_on_surface"
                android:textSize="12sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Hero Volume Readout HUD Card -->
        <LinearLayout
            android:id="@+id/cardHeroVolume"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_hero_card"
            android:orientation="vertical"
            android:padding="18dp"
            android:layout_marginBottom="12dp">

            <TextView
                android:id="@+id/tvHeroTankBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="DIESEL CALIBRATION READOUT"
                android:textColor="@color/m3_on_primary_container"
                android:textSize="11sp"
                android:textStyle="bold"
                android:letterSpacing="0.08" />

            <!-- Primary Digits -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:orientation="horizontal"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="8dp">

                <TextView
                    android:id="@+id/tvVolumeDisplay"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0"
                    android:textColor="@color/m3_on_primary_container"
                    android:textSize="52sp"
                    android:textStyle="bold"
                    android:fontFamily="sans-serif-black" />

                <TextView
                    android:id="@+id/tvVolumeUnit"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:text="@string/volume_unit"
                    android:textColor="@color/m3_on_primary_container"
                    android:textSize="22sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Visual Capacity Gauge Track -->
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="12dp"
                android:background="@drawable/bg_gauge_track"
                android:layout_marginTop="2dp"
                android:layout_marginBottom="8dp">

                <View
                    android:id="@+id/viewGaugeFill"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:background="@drawable/bg_gauge_fill" />
            </FrameLayout>

            <!-- Metric Equivalence & Ullage Row -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tvFillPercentage"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="0.0% FULL"
                    android:textColor="@color/m3_on_primary_container"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvUllageHeadroom"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Ullage: 22,354 L"
                    android:textColor="@color/m3_on_primary_container"
                    android:textSize="12sp" />
            </LinearLayout>
        </LinearLayout>

        <!-- Tactile Dipstick Depth Input Card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_card_tactical"
            android:orientation="vertical"
            android:padding="16dp"
            android:layout_marginBottom="12dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:layout_marginBottom="8dp">

                <ImageView
                    android:id="@+id/ivRulerIcon"
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:src="@drawable/ic_ruler"
                    android:tint="@color/m3_primary"
                    android:contentDescription="@null" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="6dp"
                    android:text="@string/depth_input_label"
                    android:textColor="@color/m3_on_surface"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.04" />

                <TextView
                    android:id="@+id/tvMaxDepthLimit"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Max: 242.0 cm"
                    android:textColor="@color/m3_text_muted"
                    android:textSize="11sp" />
            </LinearLayout>

            <!-- Depth Input Box -->
            <EditText
                android:id="@+id/etDepthInput"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:background="@drawable/bg_input_depth"
                android:gravity="center"
                android:inputType="numberDecimal"
                android:maxLength="7"
                android:paddingHorizontal="16dp"
                android:textColor="@color/m3_on_surface"
                android:textSize="22sp"
                android:textStyle="bold" />

            <!-- Presets & Reset Row -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="10dp">

                <Button
                    android:id="@+id/btnPreset25"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="1"
                    android:layout_marginEnd="3dp"
                    android:background="@drawable/bg_preset_chip"
                    android:text="@string/preset_quarter"
                    android:textColor="@color/m3_on_surface"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <Button
                    android:id="@+id/btnPreset50"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="1"
                    android:layout_marginHorizontal="2dp"
                    android:background="@drawable/bg_preset_chip"
                    android:text="@string/preset_half"
                    android:textColor="@color/m3_on_surface"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <Button
                    android:id="@+id/btnPreset75"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="1"
                    android:layout_marginHorizontal="2dp"
                    android:background="@drawable/bg_preset_chip"
                    android:text="@string/preset_three_quarter"
                    android:textColor="@color/m3_on_surface"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <Button
                    android:id="@+id/btnPreset100"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="1"
                    android:layout_marginHorizontal="2dp"
                    android:background="@drawable/bg_preset_chip"
                    android:text="@string/preset_full"
                    android:textColor="@color/m3_on_surface"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <Button
                    android:id="@+id/btnClearDepth"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="1.2"
                    android:layout_marginStart="3dp"
                    android:background="@drawable/bg_button_stepper"
                    android:text="@string/clear_action"
                    android:textColor="@color/prem95_red"
                    android:textSize="12sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>

        <!-- Tabular Telemetry & Specifications Card (2-Column clean tabular layout) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_card_tactical"
            android:orientation="vertical"
            android:padding="16dp"
            android:layout_marginBottom="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:layout_marginBottom="12dp">

                <ImageView
                    android:id="@+id/ivTankIcon"
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:src="@drawable/ic_fuel_tank"
                    android:tint="@color/m3_primary"
                    android:contentDescription="@null" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:text="@string/telemetry_title"
                    android:textColor="@color/m3_on_surface"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.04" />
            </LinearLayout>

            <!-- Table Row 1: Model -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingVertical="4dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/spec_tank_model"
                    android:textColor="@color/m3_text_muted"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/tvSpecModel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Phoenix Horizontal"
                    android:textColor="@color/m3_on_surface"
                    android:textSize="13sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@drawable/divider_hairline"
                android:layout_marginVertical="4dp" />

            <!-- Table Row 2: Capacity -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingVertical="4dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/spec_total_capacity"
                    android:textColor="@color/m3_text_muted"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/tvSpecCapacity"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="22,354 Liters"
                    android:textColor="@color/m3_on_surface"
                    android:textSize="13sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@drawable/divider_hairline"
                android:layout_marginVertical="4dp" />

            <!-- Table Row 3: Dimensions -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingVertical="4dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Tank Dimensions"
                    android:textColor="@color/m3_text_muted"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/tvSpecDimensions"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="D = 2.42m × L = 4.86m"
                    android:textColor="@color/m3_on_surface"
                    android:textSize="13sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@drawable/divider_hairline"
                android:layout_marginVertical="4dp" />

            <!-- Table Row 4: Calibration Basis -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingVertical="4dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/spec_curve_table"
                    android:textColor="@color/m3_text_muted"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/tvSpecCurve"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="242-Point Empirical Table"
                    android:textColor="@color/m3_on_surface"
                    android:textSize="13sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>

        <!-- Studio Offline Freeware Footer Badge -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="KimRosil App Studio • 100% Offline Native Freeware"
            android:textColor="@color/m3_text_muted"
            android:textSize="11sp"
            android:layout_marginBottom="16dp" />

    </LinearLayout>
</ScrollView>
