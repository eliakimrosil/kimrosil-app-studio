<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/mainScrollView"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="@color/colorBackground">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="12dp"
        android:paddingBottom="32dp">

        <!-- Header Bar -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="12dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvAppTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/app_name"
                    android:textColor="@color/colorTextPrimary"
                    android:textSize="22sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.04" />

                <TextView
                    android:id="@+id/tvHeaderSubtitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/app_tagline"
                    android:textColor="@color/colorTextMuted"
                    android:textSize="11sp" />
            </LinearLayout>

            <Button
                android:id="@+id/btnUnitToggle"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:minWidth="76dp"
                android:background="@drawable/bg_button_secondary"
                android:text="@string/btn_unit_imperial"
                android:textColor="@color/colorTextPrimary"
                android:textSize="12sp"
                android:textStyle="bold"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:layout_marginEnd="6dp" />

            <ImageButton
                android:id="@+id/btnTheme"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="@drawable/bg_button_header"
                android:src="@drawable/ic_theme"
                android:contentDescription="Switch Theme"
                android:padding="12dp"
                android:layout_marginEnd="6dp" />

            <ImageButton
                android:id="@+id/btnSettings"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="@drawable/bg_button_header"
                android:src="@drawable/ic_gear"
                android:contentDescription="Settings"
                android:padding="12dp" />
        </LinearLayout>

        <!-- Process Selector Card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_card"
            android:padding="12dp"
            android:layout_marginBottom="12dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="WELDING PROCESS (THERMAL EFFICIENCY \u03B7)"
                android:textColor="@color/colorTextMuted"
                android:textSize="11sp"
                android:textStyle="bold"
                android:letterSpacing="0.05"
                android:layout_marginBottom="8dp" />

            <LinearLayout
                android:id="@+id/layoutProcessChips"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btnProcSmaw"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_chip_unselected"
                    android:text="SMAW"
                    android:textColor="@color/colorTextPrimary"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:padding="0dp"
                    android:layout_marginEnd="4dp" />

                <Button
                    android:id="@+id/btnProcGmaw"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_chip_selected"
                    android:text="GMAW"
                    android:textColor="#FFFFFF"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:padding="0dp"
                    android:layout_marginEnd="4dp" />

                <Button
                    android:id="@+id/btnProcGtaw"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_chip_unselected"
                    android:text="GTAW"
                    android:textColor="@color/colorTextPrimary"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:padding="0dp"
                    android:layout_marginEnd="4dp" />

                <Button
                    android:id="@+id/btnProcFcaw"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_chip_unselected"
                    android:text="FCAW"
                    android:textColor="@color/colorTextPrimary"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:padding="0dp"
                    android:layout_marginEnd="4dp" />

                <Button
                    android:id="@+id/btnProcSaw"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_chip_unselected"
                    android:text="SAW"
                    android:textColor="@color/colorTextPrimary"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:padding="0dp" />
            </LinearLayout>
        </LinearLayout>

        <!-- Hero Telemetry Card (Positioned prominent at top) -->
        <LinearLayout
            android:id="@+id/cardHero"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_hero_card"
            android:padding="16dp"
            android:layout_marginBottom="12dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="4dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="ARC HEAT INPUT (ASME IX / AWS D1.1)"
                    android:textColor="@color/colorTextMuted"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.06" />

                <TextView
                    android:id="@+id/tvStatusBadge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_badge_optimal"
                    android:text="OPTIMUM TOUGHNESS WINDOW"
                    android:textColor="@color/colorOptimal"
                    android:textSize="10sp"
                    android:textStyle="bold"
                    android:paddingStart="8dp"
                    android:paddingEnd="8dp"
                    android:paddingTop="3dp"
                    android:paddingBottom="3dp" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvHeatInput"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="17.28 kJ/in"
                android:textColor="@color/colorPrimary"
                android:textSize="30sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvHeatInputSec"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0.68 kJ/mm | Arc Energy: 21.60 kJ/in"
                android:textColor="@color/colorTextSecondary"
                android:textSize="13sp"
                android:layout_marginTop="2dp" />
        </LinearLayout>

        <!-- Tabular 2-Column Telemetry Grid -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="12dp">

            <!-- Col 1: Deposition & Wire Volume -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:background="@drawable/bg_card"
                android:padding="12dp"
                android:layout_marginEnd="6dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="DEPOSITION RATE"
                    android:textColor="@color/colorTextMuted"
                    android:textSize="10sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvDepositionRate"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="4.68 lb/hr"
                    android:textColor="@color/colorTextPrimary"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:layout_marginTop="2dp" />

                <TextView
                    android:id="@+id/tvDepositionMetric"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="2.12 kg/hr"
                    android:textColor="@color/colorTextSecondary"
                    android:textSize="11sp" />
            </LinearLayout>

            <!-- Col 2: Arc Power & Efficiency -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:background="@drawable/bg_card"
                android:padding="12dp"
                android:layout_marginStart="6dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="ARC POWER / \u03B7"
                    android:textColor="@color/colorTextMuted"
                    android:textSize="10sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvArcPower"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="4.32 kW"
                    android:textColor="@color/colorTextPrimary"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:layout_marginTop="2dp" />

                <TextView
                    android:id="@+id/tvEfficiency"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Efficiency: 80% (GMAW)"
                    android:textColor="@color/colorTextSecondary"
                    android:textSize="11sp" />
            </LinearLayout>
        </LinearLayout>

        <!-- Current Amperage Card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_card"
            android:padding="12dp"
            android:layout_marginBottom="10dp">

            <TextView
                android:id="@+id/tvAmpsLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/label_current"
                android:textColor="@color/colorTextMuted"
                android:textSize="11sp"
                android:textStyle="bold"
                android:letterSpacing="0.05"
                android:layout_marginBottom="6dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <Button
                    android:id="@+id/btnAmpsMinus10"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:background="@drawable/bg_button_stepper"
                    android:text="-10"
                    android:textColor="@color/colorTextPrimary"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <Button
                    android:id="@+id/btnAmpsMinus1"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:background="@drawable/bg_button_stepper"
                    android:text="-1"
                    android:textColor="@color/colorTextPrimary"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:layout_marginStart="4dp" />

                <EditText
                    android:id="@+id/etAmps"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_input"
                    android:gravity="center"
                    android:hint="@string/hint_amps"
                    android:inputType="numberDecimal"
                    android:selectAllOnFocus="true"
                    android:textColor="@color/colorTextPrimary"
                    android:textColorHint="@color/colorTextMuted"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    android:layout_marginStart="6dp"
                    android:layout_marginEnd="6dp" />

                <Button
                    android:id="@+id/btnAmpsPlus1"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:background="@drawable/bg_button_stepper"
                    android:text="+1"
                    android:textColor="@color/colorTextPrimary"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:layout_marginEnd="4dp" />

                <Button
                    android:id="@+id/btnAmpsPlus10"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:background="@drawable/bg_button_stepper"
                    android:text="+10"
                    android:textColor="@color/colorTextPrimary"
                    android:textSize="12sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>

        <!-- Arc Voltage Card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_card"
            android:padding="12dp"
            android:layout_marginBottom="10dp">

            <TextView
                android:id="@+id/tvVoltsLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/label_voltage"
                android:textColor="@color/colorTextMuted"
                android:textSize="11sp"
                android:textStyle="bold"
                android:letterSpacing="0.05"
                android:layout_marginBottom="6dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <Button
                    android:id="@+id/btnVoltsMinus1"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:background="@drawable/bg_button_stepper"
                    android:text="-1"
                    android:textColor="@color/colorTextPrimary"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <Button
                    android:id="@+id/btnVoltsMinusHalf"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:background="@drawable/bg_button_stepper"
                    android:text="-.5"
                    android:textColor="@color/colorTextPrimary"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:layout_marginStart="4dp" />

                <EditText
                    android:id="@+id/etVolts"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_input"
                    android:gravity="center"
                    android:hint="@string/hint_volts"
                    android:inputType="numberDecimal"
                    android:selectAllOnFocus="true"
                    android:textColor="@color/colorTextPrimary"
                    android:textColorHint="@color/colorTextMuted"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    android:layout_marginStart="6dp"
                    android:layout_marginEnd="6dp" />

                <Button
                    android:id="@+id/btnVoltsPlusHalf"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:background="@drawable/bg_button_stepper"
                    android:text="+.5"
                    android:textColor="@color/colorTextPrimary"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:layout_marginEnd="4dp" />

                <Button
                    android:id="@+id/btnVoltsPlus1"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:background="@drawable/bg_button_stepper"
                    android:text="+1"
                    android:textColor="@color/colorTextPrimary"
                    android:textSize="12sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>

        <!-- Travel Speed Card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_card"
            android:padding="12dp"
            android:layout_marginBottom="12dp">

            <TextView
                android:id="@+id/tvSpeedLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/label_speed"
                android:textColor="@color/colorTextMuted"
                android:textSize="11sp"
                android:textStyle="bold"
                android:letterSpacing="0.05"
                android:layout_marginBottom="6dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <Button
                    android:id="@+id/btnSpeedMinus1"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:background="@drawable/bg_button_stepper"
                    android:text="-1"
                    android:textColor="@color/colorTextPrimary"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <Button
                    android:id="@+id/btnSpeedMinusHalf"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:background="@drawable/bg_button_stepper"
                    android:text="-.5"
                    android:textColor="@color/colorTextPrimary"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:layout_marginStart="4dp" />

                <EditText
                    android:id="@+id/etSpeed"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_input"
                    android:gravity="center"
                    android:hint="@string/hint_speed"
                    android:inputType="numberDecimal"
                    android:selectAllOnFocus="true"
                    android:textColor="@color/colorTextPrimary"
                    android:textColorHint="@color/colorTextMuted"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    android:layout_marginStart="6dp"
                    android:layout_marginEnd="6dp" />

                <Button
                    android:id="@+id/btnSpeedPlusHalf"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:background="@drawable/bg_button_stepper"
                    android:text="+.5"
                    android:textColor="@color/colorTextPrimary"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:layout_marginEnd="4dp" />

                <Button
                    android:id="@+id/btnSpeedPlus1"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:background="@drawable/bg_button_stepper"
                    android:text="+1"
                    android:textColor="@color/colorTextPrimary"
                    android:textSize="12sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>

        <!-- Calculate Action Button -->
        <Button
            android:id="@+id/btnCalculate"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:background="@drawable/bg_button_primary"
            android:text="@string/btn_compute"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:textStyle="bold"
            android:letterSpacing="0.05"
            android:layout_marginBottom="14dp" />

        <!-- Custom Interactive Weld Arc View -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_card"
            android:padding="12dp"
            android:layout_marginBottom="12dp">

            <com.kimrosil.weldbead.WeldArcView
                android:id="@+id/weldArcView"
                android:layout_width="match_parent"
                android:layout_height="160dp" />
        </LinearLayout>

        <!-- Action Row (Log Pass & Copy Schedule) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="14dp">

            <Button
                android:id="@+id/btnSavePass"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:background="@drawable/bg_button_secondary"
                android:text="@string/btn_save_pass"
                android:textColor="@color/colorTextPrimary"
                android:textSize="13sp"
                android:textStyle="bold"
                android:layout_marginEnd="6dp" />

            <Button
                android:id="@+id/btnCopyLog"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:background="@drawable/bg_button_secondary"
                android:text="@string/btn_copy_log"
                android:textColor="@color/colorTextPrimary"
                android:textSize="13sp"
                android:textStyle="bold"
                android:layout_marginStart="6dp" />
        </LinearLayout>

        <!-- Pass Log Header & Clear Button -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="8dp">

            <TextView
                android:id="@+id/tvLogHeader"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="WELD PASS HISTORY (LOCAL DB)"
                android:textColor="@color/colorTextMuted"
                android:textSize="11sp"
                android:textStyle="bold"
                android:letterSpacing="0.05" />

            <Button
                android:id="@+id/btnClearLog"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:minHeight="36dp"
                android:background="@drawable/bg_button_secondary"
                android:text="CLEAR"
                android:textColor="@color/colorTextMuted"
                android:textSize="11sp"
                android:paddingStart="8dp"
                android:paddingEnd="8dp" />
        </LinearLayout>

        <!-- Dynamic Pass List Container -->
        <LinearLayout
            android:id="@+id/layoutRecentList"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />

    </LinearLayout>
</ScrollView>
