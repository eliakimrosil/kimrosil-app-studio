<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="@color/m3_surface">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Top Header Bar -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingBottom="12dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvAppTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="FlangeMatch"
                    android:textSize="24sp"
                    android:textStyle="bold"
                    android:textColor="@color/m3_on_surface" />

                <TextView
                    android:id="@+id/tvAppSubtitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="100% Offline Torque &amp; Bolt Sequencer"
                    android:textSize="12sp"
                    android:textColor="@color/m3_on_surface_variant" />
            </LinearLayout>

            <Button
                android:id="@+id/btnUnitToggle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:text="Unit: ft-lb"
                android:textSize="12sp"
                android:background="@drawable/bg_technical_button"
                android:textColor="@color/m3_on_surface" />

            <Button
                android:id="@+id/btnThemeToggle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Auto Theme"
                android:textSize="12sp"
                android:background="@drawable/bg_technical_button"
                android:textColor="@color/m3_on_surface" />
        </LinearLayout>

        <!-- Standard Selection Card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_workshop_card"
            android:padding="14dp"
            android:layout_marginBottom="14dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="STEP 1: FLANGE SPECIFICATION"
                android:textSize="11sp"
                android:textStyle="bold"
                android:textColor="@color/m3_primary"
                android:layout_marginBottom="8dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Standard"
                android:textSize="12sp"
                android:textColor="@color/m3_on_surface_variant" />

            <Spinner
                android:id="@+id/spStandard"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginBottom="8dp"
                android:background="@drawable/bg_spinner_frame" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginEnd="6dp"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Pressure Class"
                        android:textSize="12sp"
                        android:textColor="@color/m3_on_surface_variant" />

                    <Spinner
                        android:id="@+id/spPressureClass"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:background="@drawable/bg_spinner_frame" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Nominal Size (NPS)"
                        android:textSize="12sp"
                        android:textColor="@color/m3_on_surface_variant" />

                    <Spinner
                        android:id="@+id/spNominalSize"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:background="@drawable/bg_spinner_frame" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>

        <!-- Hero Blueprint Gauges Card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_workshop_card"
            android:padding="16dp"
            android:layout_marginBottom="14dp">

            <TextView
                android:id="@+id/tvHeroSpecTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="ASME B16.5 4&quot; 150#"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="@color/m3_on_surface" />

            <TextView
                android:id="@+id/tvHeroBoltSummary"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="8 BOLTS — BCD 7.50&quot;"
                android:textSize="13sp"
                android:textColor="@color/m3_primary"
                android:layout_marginBottom="12dp" />

            <!-- Custom Vector Canvas View -->
            <com.kimrosil.flangematch.FlangeDiagramView
                android:id="@+id/flangePreview"
                android:layout_width="match_parent"
                android:layout_height="240dp"
                android:layout_gravity="center_horizontal"
                android:layout_marginBottom="14dp" />

            <!-- Engineering Telemetry Grid -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="8dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Bolt Circle (BCD)"
                        android:textSize="11sp"
                        android:textColor="@color/m3_on_surface_variant" />

                    <TextView
                        android:id="@+id/tvBcdValue"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="7.50 in (190.5 mm)"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:textColor="@color/m3_on_surface" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Hole Diameter"
                        android:textSize="11sp"
                        android:textColor="@color/m3_on_surface_variant" />

                    <TextView
                        android:id="@+id/tvHoleDiaValue"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0.75 in (19.1 mm)"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:textColor="@color/m3_on_surface" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Stud Size"
                        android:textSize="11sp"
                        android:textColor="@color/m3_on_surface_variant" />

                    <TextView
                        android:id="@+id/tvStudSizeValue"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="5/8&quot;"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:textColor="@color/m3_on_surface" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Heavy Hex Socket"
                        android:textSize="11sp"
                        android:textColor="@color/m3_on_surface_variant" />

                    <TextView
                        android:id="@+id/tvWrenchSizeValue"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="1-1/16&quot;"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:textColor="@color/m3_on_surface" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>

        <!-- Torque Calibration & Execution Deck -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_workshop_card"
            android:padding="16dp"
            android:layout_marginBottom="14dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="STEP 2: TARGET TORQUE &amp; CALIBRATION"
                android:textSize="11sp"
                android:textStyle="bold"
                android:textColor="@color/m3_primary"
                android:layout_marginBottom="8dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="10dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Standard ASTM B7 Torque:"
                    android:textSize="13sp"
                    android:textColor="@color/m3_on_surface_variant" />

                <TextView
                    android:id="@+id/tvRecommendedTorque"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="60.0 ft-lb"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:textColor="@color/m3_primary" />
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Custom Engineering Target Torque"
                android:textSize="12sp"
                android:textColor="@color/m3_on_surface_variant"
                android:layout_marginBottom="4dp" />

            <EditText
                android:id="@+id/etCustomTorque"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:background="@drawable/bg_spinner_frame"
                android:inputType="numberDecimal"
                android:imeOptions="actionDone"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:textColor="@color/m3_on_surface"
                android:textSize="16sp"
                android:layout_marginBottom="14dp" />

            <Button
                android:id="@+id/btnStartSequencer"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:background="@drawable/bg_primary_tactile_button"
                android:text="LAUNCH STAR PATTERN HUD"
                android:textStyle="bold"
                android:textSize="15sp"
                android:textColor="@color/m3_on_primary" />
        </LinearLayout>

        <!-- Offline Session History Deck -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_workshop_card"
            android:padding="16dp"
            android:layout_marginBottom="24dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="RECENT TIGHTENING AUDIT LOGS"
                android:textSize="11sp"
                android:textStyle="bold"
                android:textColor="@color/m3_primary"
                android:layout_marginBottom="12dp" />

            <!-- Empty State -->
            <LinearLayout
                android:id="@+id/llEmptyLogs"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center"
                android:padding="20dp"
                android:visibility="gone">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="No logged passes yet."
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:textColor="@color/m3_on_surface_variant" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Completed 4-pass star sequencings will appear here offline."
                    android:textSize="12sp"
                    android:textColor="@color/m3_on_surface_variant"
                    android:gravity="center" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/llLogHistoryContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />
        </LinearLayout>

    </LinearLayout>
</ScrollView>