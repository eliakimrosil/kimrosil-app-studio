<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/bg_main"
    android:padding="12dp">

    <!-- Top Unified Action Bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingBottom="8dp">

        <ImageView
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:src="@drawable/ic_launcher"
            android:contentDescription="ConduitFill Logo" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:paddingStart="10dp"
            android:paddingEnd="10dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/app_name"
                android:textColor="@color/text_primary"
                android:textSize="20sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="NEC Chapter 9 Raceway Solver"
                android:textColor="@color/text_secondary"
                android:textSize="11sp" />
        </LinearLayout>

        <ImageButton
            android:id="@+id/btnTheme"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="@drawable/bg_header_icon_btn"
            android:src="@drawable/ic_theme"
            android:contentDescription="Switch Theme" />

        <Space
            android:layout_width="8dp"
            android:layout_height="match_parent" />

        <ImageButton
            android:id="@+id/btnSettings"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="@drawable/bg_header_icon_btn"
            android:src="@drawable/ic_settings"
            android:contentDescription="Settings and About" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Hero Conduit Canvas & Telemetry Card -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_hero_card"
                android:orientation="vertical"
                android:padding="10dp"
                android:layout_marginBottom="8dp">

                <!-- 2D Circular Cross Section Schematic -->
                <com.kimrosil.conduitfill.ConduitCrossSectionView
                    android:id="@+id/conduitView"
                    android:layout_width="match_parent"
                    android:layout_height="120dp" />

                <!-- Status Badges Row -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingTop="6dp">

                    <TextView
                        android:id="@+id/tvComplianceStatus"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_badge_pass"
                        android:text="CODE COMPLIANT"
                        android:textColor="@color/badge_text_pass"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:paddingStart="8dp"
                        android:paddingEnd="8dp"
                        android:paddingTop="3dp"
                        android:paddingBottom="3dp" />

                    <Space
                        android:layout_width="8dp"
                        android:layout_height="match_parent" />

                    <TextView
                        android:id="@+id/tvJamStatus"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_badge_pass"
                        android:text="Safe Pull (J: 3.8)"
                        android:textColor="@color/badge_text_pass"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:paddingStart="8dp"
                        android:paddingEnd="8dp"
                        android:paddingTop="3dp"
                        android:paddingBottom="3dp" />
                </LinearLayout>
            </LinearLayout>

            <!-- Raceway Specification Card -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_card"
                android:orientation="vertical"
                android:padding="10dp"
                android:layout_marginBottom="8dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Raceway Conduit Type (NEC Table 4)"
                    android:textColor="@color/text_secondary"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="6dp" />

                <!-- Raceway Chips Row (48dp height) -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="8dp">

                    <Button
                        android:id="@+id/btnTypeEmt"
                        android:layout_width="0dp"
                        android:layout_height="48dp"
                        android:layout_weight="1"
                        android:text="EMT"
                        android:textColor="@color/chip_text_selected"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:contentDescription="Select EMT conduit"
                        android:background="@drawable/bg_chip_selected" />

                    <Space
                        android:layout_width="4dp"
                        android:layout_height="match_parent" />

                    <Button
                        android:id="@+id/btnTypePvc40"
                        android:layout_width="0dp"
                        android:layout_height="48dp"
                        android:layout_weight="1"
                        android:text="PVC-40"
                        android:textColor="@color/chip_text_unselected"
                        android:textSize="11sp"
                        android:contentDescription="Select PVC 40 conduit"
                        android:background="@drawable/bg_chip_unselected" />

                    <Space
                        android:layout_width="4dp"
                        android:layout_height="match_parent" />

                    <Button
                        android:id="@+id/btnTypePvc80"
                        android:layout_width="0dp"
                        android:layout_height="48dp"
                        android:layout_weight="1"
                        android:text="PVC-80"
                        android:textColor="@color/chip_text_unselected"
                        android:textSize="11sp"
                        android:contentDescription="Select PVC 80 conduit"
                        android:background="@drawable/bg_chip_unselected" />

                    <Space
                        android:layout_width="4dp"
                        android:layout_height="match_parent" />

                    <Button
                        android:id="@+id/btnTypeRmc"
                        android:layout_width="0dp"
                        android:layout_height="48dp"
                        android:layout_weight="1"
                        android:text="RMC"
                        android:textColor="@color/chip_text_unselected"
                        android:textSize="11sp"
                        android:contentDescription="Select RMC conduit"
                        android:background="@drawable/bg_chip_unselected" />
                </LinearLayout>

                <!-- Conduit Trade Size Micro-Stepper -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <Button
                        android:id="@+id/btnConduitMinus"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:background="@drawable/bg_btn_secondary"
                        android:text="-"
                        android:textColor="@color/text_primary"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:contentDescription="Decrease conduit size" />

                    <TextView
                        android:id="@+id/tvConduitSizeLabel"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:text="1 in Trade (ID: 1.049 in)"
                        android:textColor="@color/accent_primary"
                        android:textSize="15sp"
                        android:textStyle="bold" />

                    <Button
                        android:id="@+id/btnConduitPlus"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:background="@drawable/bg_btn_secondary"
                        android:text="+"
                        android:textColor="@color/text_primary"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:contentDescription="Increase conduit size" />
                </LinearLayout>
            </LinearLayout>

            <!-- Conductor Loading Card -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_card"
                android:orientation="vertical"
                android:padding="10dp"
                android:layout_marginBottom="8dp">

                <!-- Insulation Type Row (48dp height) -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="8dp">

                    <Button
                        android:id="@+id/btnInsThhn"
                        android:layout_width="0dp"
                        android:layout_height="48dp"
                        android:layout_weight="1"
                        android:text="THHN / THWN"
                        android:textColor="@color/chip_text_selected"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:contentDescription="Select THHN insulation"
                        android:background="@drawable/bg_chip_selected" />

                    <Space
                        android:layout_width="4dp"
                        android:layout_height="match_parent" />

                    <Button
                        android:id="@+id/btnInsXhhw"
                        android:layout_width="0dp"
                        android:layout_height="48dp"
                        android:layout_weight="1"
                        android:text="XHHW-2"
                        android:textColor="@color/chip_text_unselected"
                        android:textSize="11sp"
                        android:contentDescription="Select XHHW insulation"
                        android:background="@drawable/bg_chip_unselected" />

                    <Space
                        android:layout_width="4dp"
                        android:layout_height="match_parent" />

                    <Button
                        android:id="@+id/btnInsRhw"
                        android:layout_width="0dp"
                        android:layout_height="48dp"
                        android:layout_weight="1"
                        android:text="RHW / USE"
                        android:textColor="@color/chip_text_unselected"
                        android:textSize="11sp"
                        android:contentDescription="Select RHW insulation"
                        android:background="@drawable/bg_chip_unselected" />
                </LinearLayout>

                <!-- Primary Conductor Steppers -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="8dp">

                    <!-- Gauge selector -->
                    <Button
                        android:id="@+id/btnPrimaryGaugeMinus"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:background="@drawable/bg_btn_secondary"
                        android:text="-"
                        android:textColor="@color/text_primary"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:contentDescription="Smaller primary wire gauge" />

                    <TextView
                        android:id="@+id/tvPrimaryGauge"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:text="10 AWG"
                        android:textColor="@color/text_primary"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <Button
                        android:id="@+id/btnPrimaryGaugePlus"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:background="@drawable/bg_btn_secondary"
                        android:text="+"
                        android:textColor="@color/text_primary"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:contentDescription="Larger primary wire gauge" />

                    <Space
                        android:layout_width="8dp"
                        android:layout_height="match_parent" />

                    <!-- Quantity Stepper -->
                    <Button
                        android:id="@+id/btnPrimaryCountMinus"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:background="@drawable/bg_btn_secondary"
                        android:text="-"
                        android:textColor="@color/text_primary"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:contentDescription="Decrease primary wire count" />

                    <TextView
                        android:id="@+id/tvPrimaryCount"
                        android:layout_width="44dp"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:text="3"
                        android:textColor="@color/accent_primary"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <Button
                        android:id="@+id/btnPrimaryCountPlus"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:background="@drawable/bg_btn_secondary"
                        android:text="+"
                        android:textColor="@color/text_primary"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:contentDescription="Increase primary wire count" />
                </LinearLayout>

                <!-- Ground Conductor Steppers -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="8dp">

                    <Button
                        android:id="@+id/btnGroundGaugeMinus"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:background="@drawable/bg_btn_secondary"
                        android:text="-"
                        android:textColor="@color/text_primary"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:contentDescription="Smaller ground wire gauge" />

                    <TextView
                        android:id="@+id/tvGroundGauge"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:text="GND: 10 AWG"
                        android:textColor="@color/accent_ground"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <Button
                        android:id="@+id/btnGroundGaugePlus"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:background="@drawable/bg_btn_secondary"
                        android:text="+"
                        android:textColor="@color/text_primary"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:contentDescription="Larger ground wire gauge" />

                    <Space
                        android:layout_width="8dp"
                        android:layout_height="match_parent" />

                    <Button
                        android:id="@+id/btnGroundCountMinus"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:background="@drawable/bg_btn_secondary"
                        android:text="-"
                        android:textColor="@color/text_primary"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:contentDescription="Decrease ground wire count" />

                    <TextView
                        android:id="@+id/tvGroundCount"
                        android:layout_width="44dp"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:text="1"
                        android:textColor="@color/accent_ground"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <Button
                        android:id="@+id/btnGroundCountPlus"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:background="@drawable/bg_btn_secondary"
                        android:text="+"
                        android:textColor="@color/text_primary"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:contentDescription="Increase ground wire count" />
                </LinearLayout>

                <!-- Nipple Exception 60% Fill Button -->
                <Button
                    android:id="@+id/btnToggleNipple"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:background="@drawable/bg_btn_secondary"
                    android:text="Standard Run (40% Max Fill)"
                    android:textColor="@color/text_secondary"
                    android:textSize="12sp"
                    android:contentDescription="Toggle 60 percent nipple fill rule" />
            </LinearLayout>

            <!-- Action Buttons (48dp height) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="8dp">

                <Button
                    android:id="@+id/btnSaveRun"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:minHeight="48dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_btn_primary"
                    android:text="Save Run"
                    android:textColor="@color/text_inverse"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:contentDescription="Save conduit run to local log" />

                <Space
                    android:layout_width="6dp"
                    android:layout_height="match_parent" />

                <Button
                    android:id="@+id/btnCopyReport"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:minHeight="48dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_btn_secondary"
                    android:text="Copy Report"
                    android:textColor="@color/text_primary"
                    android:textSize="13sp"
                    android:contentDescription="Copy conduit fill report to clipboard" />
            </LinearLayout>

            <!-- NEC Pull Box & Engineering Telemetry -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_card_elevated"
                android:orientation="vertical"
                android:padding="12dp"
                android:layout_marginBottom="8dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="NEC 314.28 Pull Box &amp; Telemetry"
                    android:textColor="@color/text_primary"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="6dp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="STRAIGHT PULL BOX"
                            android:textColor="@color/text_secondary"
                            android:textSize="10sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tvStraightPull"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="8.0 in Length (8 x D)"
                            android:textColor="@color/accent_primary"
                            android:textSize="13sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="ANGLE / U-PULL BOX"
                            android:textColor="@color/text_secondary"
                            android:textSize="10sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tvAnglePull"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="6.0 in Distance (6 x D)"
                            android:textColor="@color/accent_primary"
                            android:textSize="13sp"
                            android:textStyle="bold" />
                    </LinearLayout>
                </LinearLayout>

                <TextView
                    android:id="@+id/tvAreaBreakdown"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Conductor Area: 0.084 sq in  •  Remaining: 0.262 sq in"
                    android:textColor="@color/text_secondary"
                    android:textSize="11sp"
                    android:layout_marginTop="6dp" />
            </LinearLayout>

            <!-- Saved Pull Runs Repository Log -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_card"
                android:orientation="vertical"
                android:padding="12dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingBottom="6dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Conduit Pull Runs"
                        android:textColor="@color/text_primary"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <Button
                        android:id="@+id/btnClearRuns"
                        android:layout_width="wrap_content"
                        android:layout_height="48dp"
                        android:background="@drawable/bg_btn_secondary"
                        android:text="Clear All"
                        android:textColor="@color/text_secondary"
                        android:textSize="11sp"
                        android:contentDescription="Clear all saved conduit runs"
                        android:paddingStart="12dp"
                        android:paddingEnd="12dp" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/layoutRunsList"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />

                <TextView
                    android:id="@+id/tvEmptyRuns"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="No runs logged yet. Tap 'Save Run' to record raceway calculations."
                    android:textColor="@color/text_hint"
                    android:textSize="12sp"
                    android:gravity="center"
                    android:padding="12dp" />
            </LinearLayout>

        </LinearLayout>
    </ScrollView>
</LinearLayout>
