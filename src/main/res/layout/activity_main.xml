<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/windowBackground"
    android:orientation="vertical">

    <!-- Top Bar: Title + Subtitle on Left, Settings Icon Button on Right (Persistent Header) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingLeft="14dp"
        android:paddingTop="12dp"
        android:paddingRight="14dp"
        android:paddingBottom="8dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvAppTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-black"
                android:letterSpacing="0.04"
                android:singleLine="true"
                android:text="PPL WORKOUT"
                android:textColor="@color/m3_on_surface"
                android:textSize="20sp" />

            <TextView
                android:id="@+id/tvAppSubtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-bold"
                android:singleLine="true"
                android:text="PUSH DAY • CHEST &amp; TRICEPS"
                android:textColor="@color/m3_primary"
                android:textSize="11sp" />
        </LinearLayout>

        <!-- Workout History Button -->
        <ImageButton
            android:id="@+id/btnHistory"
            style="?android:attr/borderlessButtonStyle"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginEnd="6dp"
            android:background="@drawable/bg_topbar_button"
            android:contentDescription="Workout History"
            android:minWidth="48dp"
            android:minHeight="48dp"
            android:padding="12dp"
            android:scaleType="fitCenter"
            android:stateListAnimator="@animator/btn_press_scale"
            android:src="@drawable/ic_history" />

        <!-- Settings Vector Action Button (Replaces cluttered inline buttons) -->
        <ImageButton
            android:id="@+id/btnSettings"
            style="?android:attr/borderlessButtonStyle"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="@drawable/bg_topbar_button"
            android:contentDescription="Settings and About"
            android:minWidth="48dp"
            android:minHeight="48dp"
            android:padding="12dp"
            android:scaleType="fitCenter"
            android:stateListAnimator="@animator/btn_press_scale"
            android:src="@drawable/ic_settings" />
    </LinearLayout>

    <ScrollView
        android:id="@+id/scrollRoot"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="false"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingLeft="14dp"
            android:paddingTop="4dp"
            android:paddingRight="14dp"
            android:paddingBottom="24dp">

        <!-- PPL Split Selector & Progress HUD Card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="10dp"
            android:background="@drawable/card_m3"
            android:orientation="vertical"
            android:padding="12dp">

            <!-- Day Selector Segmented Chips -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btnDayPush"
                    style="?android:attr/borderlessButtonStyle"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_marginEnd="6dp"
                    android:layout_weight="1"
                    android:background="@drawable/chip_active"
                    android:fontFamily="sans-serif-black"
                    android:minHeight="48dp"
                    android:stateListAnimator="@animator/btn_press_scale"
                    android:text="PUSH"
                    android:textColor="@color/m3_on_primary"
                    android:textSize="14sp" />

                <Button
                    android:id="@+id/btnDayPull"
                    style="?android:attr/borderlessButtonStyle"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_marginEnd="6dp"
                    android:layout_weight="1"
                    android:background="@drawable/chip_inactive"
                    android:fontFamily="sans-serif-black"
                    android:minHeight="48dp"
                    android:stateListAnimator="@animator/btn_press_scale"
                    android:text="PULL"
                    android:textColor="@color/m3_on_surface"
                    android:textSize="14sp" />

                <Button
                    android:id="@+id/btnDayLegs"
                    style="?android:attr/borderlessButtonStyle"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="1"
                    android:background="@drawable/chip_inactive"
                    android:fontFamily="sans-serif-black"
                    android:minHeight="48dp"
                    android:stateListAnimator="@animator/btn_press_scale"
                    android:text="LEGS"
                    android:textColor="@color/m3_on_surface"
                    android:textSize="14sp" />
            </LinearLayout>

            <!-- Compact Telemetry Row -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tvProgressStatus"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:fontFamily="sans-serif-bold"
                    android:text="Progress: 0 of 17 (0%)"
                    android:textColor="@color/m3_on_surface"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/tvVolumeStats"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-medium"
                    android:text="Volume: 0 KG"
                    android:textColor="@color/m3_primary"
                    android:textSize="12sp" />
            </LinearLayout>

            <!-- Athletic Progress Bar -->
            <ProgressBar
                android:id="@+id/pbWorkoutProgress"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="6dp"
                android:layout_marginTop="6dp"
                android:max="100"
                android:progress="0"
                android:progressDrawable="@drawable/progress_bar_athletic" />
        </LinearLayout>

        <!-- Upgraded Rest Timer Deck with Progress Indicator & Play/Pause Controls -->
        <LinearLayout
            android:id="@+id/cardRestTimer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="10dp"
            android:background="@drawable/card_m3_high"
            android:orientation="vertical"
            android:paddingLeft="12dp"
            android:paddingTop="10dp"
            android:paddingRight="12dp"
            android:paddingBottom="10dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/ivTimerIcon"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_marginEnd="8dp"
                    android:src="@drawable/ic_timer" />

                <!-- Giant Monospace Timer Digits + Status -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tvTimerCountdown"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-black"
                        android:letterSpacing="0.04"
                        android:text="01:30"
                        android:textColor="@color/m3_primary"
                        android:textSize="26sp" />

                    <TextView
                        android:id="@+id/tvTimerStatus"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:fontFamily="sans-serif-medium"
                        android:singleLine="true"
                        android:text="Ready for rest interval"
                        android:textColor="@color/m3_on_surface_variant"
                        android:textSize="11sp" />
                </LinearLayout>

                <!-- Rest Controls: Play/Pause Toggle, +30s, Skip -->
                <ImageButton
                    android:id="@+id/btnRestToggle"
                    style="?android:attr/borderlessButtonStyle"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:layout_marginEnd="4dp"
                    android:background="@drawable/bg_topbar_button"
                    android:contentDescription="Pause or Resume Rest Timer"
                    android:minWidth="48dp"
                    android:minHeight="48dp"
                    android:padding="12dp"
                    android:scaleType="fitCenter"
                    android:stateListAnimator="@animator/btn_press_scale"
                    android:src="@drawable/ic_pause" />

                <Button
                    android:id="@+id/btnRestPlus30"
                    style="?android:attr/borderlessButtonStyle"
                    android:layout_width="52dp"
                    android:layout_height="48dp"
                    android:layout_marginEnd="4dp"
                    android:background="@drawable/bg_topbar_button"
                    android:fontFamily="sans-serif-black"
                    android:minWidth="48dp"
                    android:minHeight="48dp"
                    android:stateListAnimator="@animator/btn_press_scale"
                    android:text="+30s"
                    android:textColor="@color/m3_primary"
                    android:textSize="12sp" />

                <Button
                    android:id="@+id/btnRestSkip"
                    style="?android:attr/borderlessButtonStyle"
                    android:layout_width="52dp"
                    android:layout_height="48dp"
                    android:background="@drawable/bg_topbar_button"
                    android:fontFamily="sans-serif-black"
                    android:minWidth="48dp"
                    android:minHeight="48dp"
                    android:stateListAnimator="@animator/btn_press_scale"
                    android:text="Skip"
                    android:textColor="@color/m3_tertiary"
                    android:textSize="12sp" />
            </LinearLayout>

            <!-- Real-time Depleting Countdown Progress Bar -->
            <ProgressBar
                android:id="@+id/pbRestProgress"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="5dp"
                android:layout_marginTop="8dp"
                android:max="1000"
                android:progress="1000"
                android:progressDrawable="@drawable/progress_bar_rest" />
        </LinearLayout>

        <!-- Active Exercise Deck Card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="10dp"
            android:background="@drawable/card_m3"
            android:orientation="vertical"
            android:padding="12dp">

            <!-- Exercise Navigation Header with Chevron Vector Icons -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageButton
                    android:id="@+id/btnPrevExercise"
                    style="?android:attr/borderlessButtonStyle"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:background="@drawable/bg_topbar_button"
                    android:contentDescription="Previous Exercise"
                    android:minWidth="48dp"
                    android:minHeight="48dp"
                    android:padding="12dp"
                    android:scaleType="fitCenter"
                    android:stateListAnimator="@animator/btn_press_scale"
                    android:src="@drawable/ic_chevron_left" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center_horizontal"
                    android:orientation="vertical"
                    android:paddingLeft="6dp"
                    android:paddingRight="6dp">

                    <TextView
                        android:id="@+id/tvExerciseName"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:fontFamily="sans-serif-black"
                        android:gravity="center"
                        android:maxLines="2"
                        android:text="Barbell Bench Press"
                        android:textColor="@color/m3_on_surface"
                        android:textSize="17sp" />

                    <TextView
                        android:id="@+id/tvTargetMuscles"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-bold"
                        android:letterSpacing="0.04"
                        android:text="CHEST • SHOULDERS • TRICEPS"
                        android:textColor="@color/m3_primary"
                        android:textSize="10sp" />
                </LinearLayout>

                <ImageButton
                    android:id="@+id/btnNextExercise"
                    style="?android:attr/borderlessButtonStyle"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:background="@drawable/bg_topbar_button"
                    android:contentDescription="Next Exercise"
                    android:minWidth="48dp"
                    android:minHeight="48dp"
                    android:padding="12dp"
                    android:scaleType="fitCenter"
                    android:stateListAnimator="@animator/btn_press_scale"
                    android:src="@drawable/ic_chevron_right" />
            </LinearLayout>

            <!-- Dynamic PR (Personal Record) Celebration Banner -->
            <LinearLayout
                android:id="@+id/llPrBanner"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="@drawable/card_m3_high"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingLeft="12dp"
                android:paddingTop="8dp"
                android:paddingRight="12dp"
                android:paddingBottom="8dp"
                android:visibility="gone">

                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:layout_marginEnd="8dp"
                    android:src="@drawable/ic_trophy" />

                <TextView
                    android:id="@+id/tvPrText"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:fontFamily="sans-serif-black"
                    android:text="🔥 NEW PERSONAL RECORD UNLOCKED!"
                    android:textColor="@color/m3_primary"
                    android:textSize="12sp" />
            </LinearLayout>

            <!-- Set Counter & Previous Telemetry Subline -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tvSetCounter"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:fontFamily="sans-serif-black"
                    android:text="SET 1 OF 4"
                    android:textColor="@color/m3_on_surface"
                    android:textSize="14sp" />

                <TextView
                    android:id="@+id/tvPreviousBest"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-medium"
                    android:text="Last: 80.0 KG × 8"
                    android:textColor="@color/m3_on_surface_variant"
                    android:textSize="12sp" />
            </LinearLayout>

            <!-- Compact Tabular Input Card (High Density, Zero Wasted Space) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="@drawable/card_m3_high"
                android:orientation="vertical"
                android:padding="10dp">

                <!-- Weight Row -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/tvWeightLabel"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:fontFamily="sans-serif-bold"
                        android:text="WEIGHT (KG)"
                        android:textColor="@color/m3_on_surface_variant"
                        android:textSize="12sp" />

                    <Button
                        android:id="@+id/btnWeightMinus"
                        style="?android:attr/borderlessButtonStyle"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:background="@drawable/btn_stepper"
                        android:fontFamily="sans-serif-black"
                        android:minWidth="48dp"
                        android:minHeight="48dp"
                        android:stateListAnimator="@animator/btn_press_scale"
                        android:text="-5"
                        android:textColor="@color/m3_on_surface"
                        android:textSize="14sp" />

                    <EditText
                        android:id="@+id/etWeight"
                        android:layout_width="80dp"
                        android:layout_height="48dp"
                        android:layout_marginLeft="6dp"
                        android:layout_marginRight="6dp"
                        android:background="@drawable/edittext_m3"
                        android:fontFamily="sans-serif-black"
                        android:gravity="center"
                        android:imeOptions="actionNext"
                        android:inputType="numberDecimal"
                        android:minWidth="60dp"
                        android:minHeight="48dp"
                        android:text="80.0"
                        android:textColor="@color/m3_on_surface"
                        android:textSize="18sp" />

                    <Button
                        android:id="@+id/btnWeightPlus"
                        style="?android:attr/borderlessButtonStyle"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:background="@drawable/btn_stepper"
                        android:fontFamily="sans-serif-black"
                        android:minWidth="48dp"
                        android:minHeight="48dp"
                        android:stateListAnimator="@animator/btn_press_scale"
                        android:text="+5"
                        android:textColor="@color/m3_on_surface"
                        android:textSize="14sp" />
                </LinearLayout>

                <!-- Hairline Divider -->
                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginTop="6dp"
                    android:layout_marginBottom="6dp"
                    android:background="@color/m3_outline_variant" />

                <!-- Reps Row -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:fontFamily="sans-serif-bold"
                        android:text="TARGET REPS"
                        android:textColor="@color/m3_on_surface_variant"
                        android:textSize="12sp" />

                    <Button
                        android:id="@+id/btnRepsMinus"
                        style="?android:attr/borderlessButtonStyle"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:background="@drawable/btn_stepper"
                        android:fontFamily="sans-serif-black"
                        android:minWidth="48dp"
                        android:minHeight="48dp"
                        android:stateListAnimator="@animator/btn_press_scale"
                        android:text="-1"
                        android:textColor="@color/m3_on_surface"
                        android:textSize="14sp" />

                    <EditText
                        android:id="@+id/etReps"
                        android:layout_width="80dp"
                        android:layout_height="48dp"
                        android:layout_marginLeft="6dp"
                        android:layout_marginRight="6dp"
                        android:background="@drawable/edittext_m3"
                        android:fontFamily="sans-serif-black"
                        android:gravity="center"
                        android:imeOptions="actionDone"
                        android:inputType="number"
                        android:minWidth="60dp"
                        android:minHeight="48dp"
                        android:text="8"
                        android:textColor="@color/m3_on_surface"
                        android:textSize="18sp" />

                    <Button
                        android:id="@+id/btnRepsPlus"
                        style="?android:attr/borderlessButtonStyle"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:background="@drawable/btn_stepper"
                        android:fontFamily="sans-serif-black"
                        android:minWidth="48dp"
                        android:minHeight="48dp"
                        android:stateListAnimator="@animator/btn_press_scale"
                        android:text="+1"
                        android:textColor="@color/m3_on_surface"
                        android:textSize="14sp" />
                </LinearLayout>
            </LinearLayout>

            <!-- Powerlifting Telemetry: Live 1RM & Barbell Plate Breakdown -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="@drawable/card_m3_high"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingLeft="12dp"
                android:paddingTop="8dp"
                android:paddingRight="12dp"
                android:paddingBottom="8dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tvOneRepMax"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-black"
                        android:letterSpacing="0.02"
                        android:text="EST. 1RM: 101.3 KG"
                        android:textColor="@color/m3_primary"
                        android:textSize="13sp" />

                    <TextView
                        android:id="@+id/tvPlateMath"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-medium"
                        android:singleLine="true"
                        android:text="Bar: 20 KG • Plates/side: [20, 10]"
                        android:textColor="@color/m3_on_surface_variant"
                        android:textSize="11sp" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tvIntensityPct"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/chip_active"
                    android:fontFamily="sans-serif-black"
                    android:paddingLeft="8dp"
                    android:paddingTop="4dp"
                    android:paddingRight="8dp"
                    android:paddingBottom="4dp"
                    android:text="79% 1RM"
                    android:textColor="@color/m3_on_primary"
                    android:textSize="11sp" />
            </LinearLayout>

            <!-- Primary High-Impact Log Action Button -->
            <Button
                android:id="@+id/btnLogSet"
                style="?android:attr/borderlessButtonStyle"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="10dp"
                android:background="@drawable/btn_action"
                android:drawableLeft="@drawable/ic_check"
                android:drawablePadding="8dp"
                android:fontFamily="sans-serif-black"
                android:gravity="center"
                android:minHeight="48dp"
                android:paddingLeft="16dp"
                android:paddingRight="16dp"
                android:stateListAnimator="@animator/btn_press_scale"
                android:text="LOG SET &amp; START REST"
                android:textColor="@color/m3_on_primary"
                android:textSize="14sp" />
        </LinearLayout>

        <!-- Routine List Section -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="8dp"
            android:fontFamily="sans-serif-black"
            android:letterSpacing="0.04"
            android:text="TODAY'S EXERCISE ROUTINE"
            android:textColor="@color/m3_on_surface_variant"
            android:textSize="12sp" />

        <LinearLayout
            android:id="@+id/llRoutineList"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />
    </LinearLayout>
</ScrollView>
</LinearLayout>
