<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="false"
    android:scrollbars="none"
    android:background="@color/m3_surface">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- TopBar Action Header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="12dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvAppTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="CombGauge"
                    android:textSize="24sp"
                    android:textStyle="bold"
                    android:singleLine="true"
                    android:textColor="@color/m3_on_surface" />

                <TextView
                    android:id="@+id/tvAppSubtitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Industrial Wet Film Stoichiometry"
                    android:textSize="12sp"
                    android:singleLine="true"
                    android:textColor="@color/m3_on_surface_variant" />
            </LinearLayout>

            <!-- Theme Switcher Button -->
            <Button
                android:id="@+id/btnThemeToggle"
                android:layout_width="wrap_content"
                android:layout_height="38dp"
                android:minWidth="56dp"
                android:text="Theme"
                android:textSize="12sp"
                android:paddingHorizontal="12dp"
                android:textColor="@color/m3_on_surface"
                android:background="@drawable/bg_topbar_button"
                android:contentDescription="Toggle dark and light theme"
                android:layout_marginEnd="8dp" />

            <!-- Presets Button -->
            <Button
                android:id="@+id/btnOpenPresets"
                android:layout_width="wrap_content"
                android:layout_height="38dp"
                android:minWidth="56dp"
                android:text="Specs"
                android:textSize="12sp"
                android:textStyle="bold"
                android:paddingHorizontal="14dp"
                android:textColor="@color/m3_on_primary"
                android:background="@drawable/btn_primary"
                android:contentDescription="Open coating presets library" />
        </LinearLayout>

        <!-- Mode & Unit Control Bar -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="12dp">

            <!-- Directional Mode Selector -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:orientation="horizontal"
                android:background="@drawable/card_m3"
                android:padding="3dp"
                android:layout_marginEnd="8dp">

                <Button
                    android:id="@+id/btnDirDftToWft"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:text="Target DFT → Req WFT"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:background="@drawable/chip_active"
                    android:textColor="@color/m3_on_primary" />

                <Button
                    android:id="@+id/btnDirWftToDft"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:text="Measured WFT → DFT"
                    android:textSize="11sp"
                    android:background="@drawable/chip_inactive"
                    android:textColor="@color/m3_on_surface" />
            </LinearLayout>

            <!-- Unit Toggle Pill -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:orientation="horizontal"
                android:background="@drawable/card_m3"
                android:padding="3dp">

                <Button
                    android:id="@+id/btnUnitMicrons"
                    android:layout_width="44dp"
                    android:layout_height="match_parent"
                    android:text="µm"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:background="@drawable/chip_active"
                    android:contentDescription="Switch to metric microns"
                    android:textColor="@color/m3_on_primary" />

                <Button
                    android:id="@+id/btnUnitMils"
                    android:layout_width="44dp"
                    android:layout_height="match_parent"
                    android:text="mils"
                    android:textSize="12sp"
                    android:background="@drawable/chip_inactive"
                    android:contentDescription="Switch to imperial mils"
                    android:textColor="@color/m3_on_surface" />
            </LinearLayout>
        </LinearLayout>

        <!-- Active Coating Formulation Badge -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@drawable/card_m3"
            android:paddingHorizontal="12dp"
            android:paddingVertical="8dp"
            android:layout_marginBottom="12dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="SPEC:"
                android:textStyle="bold"
                android:textSize="11sp"
                android:textColor="@color/m3_primary"
                android:layout_marginEnd="6dp" />

            <TextView
                android:id="@+id/txtActivePreset"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Polyamide Epoxy Intermediate"
                android:textSize="12sp"
                android:textStyle="bold"
                android:textColor="@color/m3_on_surface"
                android:ellipsize="end"
                android:maxLines="1" />

            <Button
                android:id="@+id/btnTileSettings"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:text="Quick Tile"
                android:textSize="11sp"
                android:textColor="@color/m3_primary"
                android:background="@drawable/bg_topbar_button"
                android:paddingHorizontal="8dp" />
        </LinearLayout>

        <!-- Hero Card: Notched Comb Visual HUD -->
        <LinearLayout
            android:id="@+id/cardHeroHud"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/card_m3_high"
            android:padding="16dp"
            android:layout_marginBottom="14dp">

            <com.kimrosil.combgauge.CombGaugeVisualView
                android:id="@+id/visualGauge"
                android:layout_width="match_parent"
                android:layout_height="190dp"
                android:contentDescription="Interactive wet film comb tooth gauge showing calculated reading" />

            <!-- Primary Large-Type Telemetry Readout -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="bottom"
                android:layout_marginTop="8dp">

                <TextView
                    android:id="@+id/txtPrimaryResultValue"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="133"
                    android:textSize="40sp"
                    android:textStyle="bold"
                    android:textColor="@color/m3_primary" />

                <TextView
                    android:id="@+id/txtPrimaryResultUnit"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="µm"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    android:textColor="@color/m3_primary"
                    android:layout_marginStart="6dp"
                    android:layout_marginBottom="6dp" />

                <View
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_weight="1" />

                <TextView
                    android:id="@+id/txtShrinkageFactor"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="25.0% solvent loss"
                    android:textSize="12sp"
                    android:textColor="@color/m3_on_surface_variant"
                    android:layout_marginBottom="6dp" />
            </LinearLayout>

            <TextView
                android:id="@+id/txtPrimaryResultLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="REQUIRED TARGET WFT (BEFORE CURING)"
                android:textSize="11sp"
                android:textStyle="bold"
                android:textColor="@color/m3_on_surface_variant"
                android:letterSpacing="0.05" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/m3_outline"
                android:layout_marginVertical="10dp" />

            <!-- Two-Column Tabular Specifications Grid -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="THEORETICAL SPREAD RATE"
                        android:textSize="10sp"
                        android:textColor="@color/m3_on_surface_variant" />

                    <TextView
                        android:id="@+id/txtSpreadingRate"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="7.50 m²/L"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        android:textColor="@color/m3_on_surface" />
                </LinearLayout>

                <View
                    android:layout_width="1dp"
                    android:layout_height="match_parent"
                    android:background="@color/m3_outline"
                    android:layout_marginHorizontal="10dp" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="DEAD VOLUME PROFILE LOSS"
                        android:textSize="10sp"
                        android:textColor="@color/m3_on_surface_variant" />

                    <TextView
                        android:id="@+id/txtDeadVolumeLoss"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="+13 µm loss"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        android:textColor="@color/m3_on_surface" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>

        <!-- Empty State Guidance Card -->
        <LinearLayout
            android:id="@+id/llEmptyState"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/card_m3"
            android:padding="16dp"
            android:visibility="gone"
            android:layout_marginBottom="12dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="No Thickness Specification Loaded"
                android:textStyle="bold"
                android:textSize="15sp"
                android:textColor="@color/m3_on_surface" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Tap any standard AMPP / NACE formulation below to initialize immediate comb calculation:"
                android:textSize="12sp"
                android:textColor="@color/m3_on_surface_variant"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="10dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btnQuickPresetEpoxy"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_weight="1"
                    android:text="Load Epoxy 75%"
                    android:textSize="12sp"
                    android:background="@drawable/btn_secondary"
                    android:textColor="@color/m3_on_surface"
                    android:layout_marginEnd="6dp" />

                <Button
                    android:id="@+id/btnQuickPresetPoly"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_weight="1"
                    android:text="Load Poly 58%"
                    android:textSize="12sp"
                    android:background="@drawable/btn_secondary"
                    android:textColor="@color/m3_on_surface" />
            </LinearLayout>
        </LinearLayout>

        <!-- Active Control Deck -->
        <LinearLayout
            android:id="@+id/llActiveDeck"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Target Thickness Numeric Stepper Deck -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/card_m3"
                android:padding="12dp"
                android:layout_marginBottom="10dp">

                <TextView
                    android:id="@+id/txtThicknessInputLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="SPECIFIED TARGET DFT"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:textColor="@color/m3_on_surface_variant"
                    android:layout_marginBottom="6dp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <Button
                        android:id="@+id/btnStepMinus"
                        android:layout_width="52dp"
                        android:layout_height="match_parent"
                        android:text="-"
                        android:textSize="20sp"
                        android:textStyle="bold"
                        android:background="@drawable/btn_stepper"
                        android:contentDescription="Decrement target thickness"
                        android:textColor="@color/m3_on_surface" />

                    <EditText
                        android:id="@+id/edtThickness"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:textSize="22sp"
                        android:textStyle="bold"
                        android:inputType="numberDecimal"
                        android:imeOptions="actionNext"
                        android:background="@drawable/edittext_m3"
                        android:hint="Thickness"
                        android:textColor="@color/m3_on_surface"
                        android:layout_marginHorizontal="8dp" />

                    <Button
                        android:id="@+id/btnStepPlus"
                        android:layout_width="52dp"
                        android:layout_height="match_parent"
                        android:text="+"
                        android:textSize="20sp"
                        android:textStyle="bold"
                        android:background="@drawable/btn_stepper"
                        android:contentDescription="Increment target thickness"
                        android:textColor="@color/m3_on_surface" />
                </LinearLayout>
            </LinearLayout>

            <!-- Volume Solids % Stepper & Slider Deck -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/card_m3"
                android:padding="12dp"
                android:layout_marginBottom="10dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="6dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="PAINT VOLUME SOLIDS %"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:textColor="@color/m3_on_surface_variant" />

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="40dp"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <Button
                            android:id="@+id/btnSolidsMinus"
                            android:layout_width="40dp"
                            android:layout_height="match_parent"
                            android:text="-"
                            android:textSize="16sp"
                            android:background="@drawable/btn_stepper"
                            android:textColor="@color/m3_on_surface" />

                        <EditText
                            android:id="@+id/edtSolidsPercent"
                            android:layout_width="60dp"
                            android:layout_height="match_parent"
                            android:gravity="center"
                            android:textSize="16sp"
                            android:textStyle="bold"
                            android:inputType="numberDecimal"
                            android:imeOptions="actionNext"
                            android:background="@drawable/edittext_m3"
                            android:textColor="@color/m3_on_surface"
                            android:layout_marginHorizontal="6dp" />

                        <Button
                            android:id="@+id/btnSolidsPlus"
                            android:layout_width="40dp"
                            android:layout_height="match_parent"
                            android:text="+"
                            android:textSize="16sp"
                            android:background="@drawable/btn_stepper"
                            android:textColor="@color/m3_on_surface" />
                    </LinearLayout>
                </LinearLayout>

                <SeekBar
                    android:id="@+id/seekSolidsPercent"
                    android:layout_width="match_parent"
                    android:layout_height="32dp"
                    android:progress="74" />
            </LinearLayout>

            <!-- Thinner Addition % Deck -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/card_m3"
                android:padding="12dp"
                android:layout_marginBottom="10dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="THINNER ADDITION %"
                            android:textSize="11sp"
                            android:textStyle="bold"
                            android:textColor="@color/m3_on_surface_variant" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="By volume ratio"
                            android:textSize="10sp"
                            android:textColor="@color/m3_on_surface_variant" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="40dp"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <Button
                            android:id="@+id/btnThinnerMinus"
                            android:layout_width="40dp"
                            android:layout_height="match_parent"
                            android:text="-"
                            android:textSize="16sp"
                            android:background="@drawable/btn_stepper"
                            android:textColor="@color/m3_on_surface" />

                        <EditText
                            android:id="@+id/edtThinnerPercent"
                            android:layout_width="60dp"
                            android:layout_height="match_parent"
                            android:gravity="center"
                            android:textSize="16sp"
                            android:textStyle="bold"
                            android:inputType="numberDecimal"
                            android:imeOptions="actionDone"
                            android:background="@drawable/edittext_m3"
                            android:textColor="@color/m3_on_surface"
                            android:layout_marginHorizontal="6dp" />

                        <Button
                            android:id="@+id/btnThinnerPlus"
                            android:layout_width="40dp"
                            android:layout_height="match_parent"
                            android:text="+"
                            android:textSize="16sp"
                            android:background="@drawable/btn_stepper"
                            android:textColor="@color/m3_on_surface" />
                    </LinearLayout>
                </LinearLayout>

                <TextView
                    android:id="@+id/txtThinnerWarning"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Warning: High thinner dilution"
                    android:textSize="11sp"
                    android:textColor="@color/m3_error"
                    android:visibility="gone"
                    android:layout_marginTop="6dp" />
            </LinearLayout>

            <!-- Surface Anchor Profile Selection Deck -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/card_m3"
                android:padding="12dp"
                android:layout_marginBottom="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="SURFACE ANCHOR PROFILE (DEAD VOLUME)"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:textColor="@color/m3_on_surface_variant"
                    android:layout_marginBottom="8dp" />

                <HorizontalScrollView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:scrollbars="none">

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="42dp"
                        android:orientation="horizontal">

                        <Button
                            android:id="@+id/chipSmooth"
                            android:layout_width="wrap_content"
                            android:layout_height="match_parent"
                            android:text="Smooth (0µm)"
                            android:textSize="11sp"
                            android:background="@drawable/chip_inactive"
                            android:textColor="@color/m3_on_surface"
                            android:paddingHorizontal="14dp"
                            android:layout_marginEnd="6dp" />

                        <Button
                            android:id="@+id/chipFine25"
                            android:layout_width="wrap_content"
                            android:layout_height="match_parent"
                            android:text="Fine (25µm)"
                            android:textSize="11sp"
                            android:background="@drawable/chip_active"
                            android:textColor="@color/m3_on_primary"
                            android:paddingHorizontal="14dp"
                            android:layout_marginEnd="6dp" />

                        <Button
                            android:id="@+id/chipMed50"
                            android:layout_width="wrap_content"
                            android:layout_height="match_parent"
                            android:text="Medium (50µm)"
                            android:textSize="11sp"
                            android:background="@drawable/chip_inactive"
                            android:textColor="@color/m3_on_surface"
                            android:paddingHorizontal="14dp"
                            android:layout_marginEnd="6dp" />

                        <Button
                            android:id="@+id/chipCoarse75"
                            android:layout_width="wrap_content"
                            android:layout_height="match_parent"
                            android:text="Coarse (75µm+)"
                            android:textSize="11sp"
                            android:background="@drawable/chip_inactive"
                            android:textColor="@color/m3_on_surface"
                            android:paddingHorizontal="14dp" />
                    </LinearLayout>
                </HorizontalScrollView>
            </LinearLayout>

            <!-- Bottom Action Footer -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="24dp">

                <Button
                    android:id="@+id/btnSaveJobBatch"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="1"
                    android:text="Save Batch Log"
                    android:textSize="13sp"
                    android:textColor="@color/m3_on_surface"
                    android:background="@drawable/btn_secondary"
                    android:layout_marginEnd="8dp" />

                <Button
                    android:id="@+id/btnShareCalculation"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="1"
                    android:text="Share Report"
                    android:textSize="13sp"
                    android:textColor="@color/m3_on_primary"
                    android:background="@drawable/btn_primary" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</ScrollView>