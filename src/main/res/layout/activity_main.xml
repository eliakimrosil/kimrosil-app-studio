<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/rootContainer"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_canvas"
    android:orientation="vertical"
    android:paddingLeft="12dp"
    android:paddingTop="8dp"
    android:paddingRight="12dp"
    android:paddingBottom="8dp">

    <!-- Unified Top Action Bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingBottom="6dp">

        <ImageView
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:layout_marginRight="8dp"
            android:contentDescription="GaussMeter Magnetometer Icon"
            android:src="@drawable/ic_magnet" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvAppTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-black"
                android:letterSpacing="0.02"
                android:text="@string/app_name"
                android:textColor="@color/text_primary"
                android:textSize="19sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvAppSubtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="monospace"
                android:singleLine="true"
                android:text="@string/header_subtitle"
                android:textColor="@color/text_muted"
                android:textSize="10sp" />
        </LinearLayout>

        <ImageButton
            android:id="@+id/btnThemeToggle"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginRight="6dp"
            android:background="@drawable/bg_header_icon_btn"
            android:contentDescription="Toggle Light or Dark Theme"
            android:padding="12dp"
            android:scaleType="centerInside"
            android:src="@drawable/ic_theme" />

        <ImageButton
            android:id="@+id/btnSettings"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="@drawable/bg_header_icon_btn"
            android:contentDescription="Open Settings and About"
            android:padding="12dp"
            android:scaleType="centerInside"
            android:src="@drawable/ic_settings" />
    </LinearLayout>

    <!-- Scrollable Main Magnetometer Workbench -->
    <ScrollView
        android:id="@+id/mainScrollView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Hero Magnetometer & Ferrous Proximity HUD Card -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_hero_card"
                android:orientation="vertical"
                android:padding="10dp">

                <!-- Status & Zone Badge Row -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/tvSensorState"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:fontFamily="monospace"
                        android:text="LIVE 3-AXIS • 3D VECTOR"
                        android:textColor="@color/accent_primary"
                        android:textSize="11sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvZoneBadge"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_badge_amber"
                        android:fontFamily="monospace"
                        android:paddingLeft="8dp"
                        android:paddingTop="3dp"
                        android:paddingRight="8dp"
                        android:paddingBottom="3dp"
                        android:text="STUD / FERROUS"
                        android:textColor="#FFFFFF"
                        android:textSize="10sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <!-- Custom 180-Degree Flux Dial & Ferrous Proximity Scope View -->
                <com.kimrosil.gaussmeter.GaussScopeView
                    android:id="@+id/gaussScopeView"
                    android:layout_width="match_parent"
                    android:layout_height="104dp"
                    android:layout_marginTop="2dp"
                    android:layout_marginBottom="4dp" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="@color/divider_line" />

                <!-- 2x2 Stacked Telemetry Readout Grid -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:orientation="horizontal">

                    <!-- Col 1: Total Magnetic Flux (µT & mG) -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:paddingRight="6dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="monospace"
                            android:text="TOTAL MAGNETIC FLUX"
                            android:textColor="@color/text_muted"
                            android:textSize="10sp" />

                        <TextView
                            android:id="@+id/tvHeroFlux"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="monospace"
                            android:text="115.0 µT"
                            android:textColor="@color/text_primary"
                            android:textSize="20sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tvHeroMgSub"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="sans-serif-medium"
                            android:text="1,150 mG • Milligauss"
                            android:textColor="@color/text_secondary"
                            android:textSize="11sp" />
                    </LinearLayout>

                    <View
                        android:layout_width="1dp"
                        android:layout_height="match_parent"
                        android:background="@color/divider_line" />

                    <!-- Col 2: Net Anomaly Delta & Alarm % -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:paddingLeft="8dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="monospace"
                            android:text="NET FERROUS DELTA"
                            android:textColor="@color/text_muted"
                            android:textSize="10sp" />

                        <TextView
                            android:id="@+id/tvHeroDelta"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="monospace"
                            android:text="+67.0 µT"
                            android:textColor="@color/accent_secondary"
                            android:textSize="20sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tvHeroProximitySub"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="sans-serif-medium"
                            android:text="79% of 85 µT Alarm"
                            android:textColor="@color/text_secondary"
                            android:textSize="11sp" />
                    </LinearLayout>
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginTop="6dp"
                    android:layout_marginBottom="6dp"
                    android:background="@color/divider_line" />

                <!-- Row 2 of Telemetry Grid: 3-Axis Components & Depth/Peak -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:paddingRight="6dp">

                        <TextView
                            android:id="@+id/tvHeroAxes"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:ellipsize="end"
                            android:fontFamily="monospace"
                            android:singleLine="true"
                            android:text="X+28 Y-34 Z+106 µT"
                            android:textColor="@color/text_primary"
                            android:textSize="11.5sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tvHeroTareSub"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Earth Tare: 48.0 µT"
                            android:textColor="@color/text_muted"
                            android:textSize="11sp" />
                    </LinearLayout>

                    <View
                        android:layout_width="1dp"
                        android:layout_height="match_parent"
                        android:background="@color/divider_line" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:paddingLeft="8dp">

                        <TextView
                            android:id="@+id/tvHeroDepthPeak"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:ellipsize="end"
                            android:fontFamily="monospace"
                            android:singleLine="true"
                            android:text="~3.1 cm • Peak 140 µT"
                            android:textColor="@color/text_primary"
                            android:textSize="11.5sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tvHeroTargetSub"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Ferrous Stud / Pipe Zone"
                            android:textColor="@color/text_muted"
                            android:textSize="11sp" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>

            <!-- 3-Tab Mode Selector Bar -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="8dp"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btnTabMeter"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_marginRight="4dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_chip_selected"
                    android:text="@string/tab_meter"
                    android:textAllCaps="false"
                    android:textColor="@color/text_on_accent"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <Button
                    android:id="@+id/btnTabStud"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_marginLeft="2dp"
                    android:layout_marginRight="2dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_chip_unselected"
                    android:text="@string/tab_stud"
                    android:textAllCaps="false"
                    android:textColor="@color/text_primary"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <Button
                    android:id="@+id/btnTabLog"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_marginLeft="4dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_chip_unselected"
                    android:text="@string/tab_log"
                    android:textAllCaps="false"
                    android:textColor="@color/text_primary"
                    android:textSize="12sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- PANEL 1: FLUX & BASELINE TARE WORKBENCH -->
            <LinearLayout
                android:id="@+id/panelMeter"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_card"
                android:orientation="vertical"
                android:padding="10dp">

                <!-- Primary Action Buttons at Top of Card (Zero Keyboard Occlusion) -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="8dp"
                    android:orientation="horizontal">

                    <Button
                        android:id="@+id/btnCalcGauss"
                        android:layout_width="0dp"
                        android:layout_height="48dp"
                        android:layout_marginRight="4dp"
                        android:layout_weight="1.2"
                        android:background="@drawable/bg_btn_primary"
                        android:text="@string/btn_apply_gauss"
                        android:textAllCaps="false"
                        android:textColor="@color/text_on_accent"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <Button
                        android:id="@+id/btnHoldSensor"
                        android:layout_width="0dp"
                        android:layout_height="48dp"
                        android:layout_marginLeft="4dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_btn_secondary"
                        android:text="@string/btn_hold_flux"
                        android:textAllCaps="false"
                        android:textColor="@color/text_primary"
                        android:textSize="13sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <!-- 2-Column Reference Flux & Baseline Tare Inputs -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <!-- Col 1: Reference / Test Flux (µT) -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginRight="4dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="4dp"
                            android:fontFamily="monospace"
                            android:text="REF / TEST FLUX (µT)"
                            android:textColor="@color/text_secondary"
                            android:textSize="11sp"
                            android:textStyle="bold" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <Button
                                android:id="@+id/btnFluxMinus"
                                android:layout_width="48dp"
                                android:layout_height="48dp"
                                android:background="@drawable/bg_stepper"
                                android:contentDescription="Decrease Reference Flux"
                                android:text="-"
                                android:textColor="@color/text_primary"
                                android:textSize="18sp"
                                android:textStyle="bold" />

                            <EditText
                                android:id="@+id/etRefFlux"
                                android:layout_width="0dp"
                                android:layout_height="48dp"
                                android:layout_marginLeft="4dp"
                                android:layout_marginRight="4dp"
                                android:layout_weight="1"
                                android:background="@drawable/bg_input_box"
                                android:contentDescription="Reference Flux Input"
                                android:fontFamily="monospace"
                                android:gravity="center"
                                android:hint="@string/hint_ref_flux"
                                android:imeOptions="actionDone"
                                android:inputType="numberDecimal"
                                android:maxLength="6"
                                android:singleLine="true"
                                android:text="115.0"
                                android:textColor="@color/text_primary"
                                android:textColorHint="@color/text_muted"
                                android:textSize="14sp"
                                android:textStyle="bold" />

                            <Button
                                android:id="@+id/btnFluxPlus"
                                android:layout_width="48dp"
                                android:layout_height="48dp"
                                android:background="@drawable/bg_stepper"
                                android:contentDescription="Increase Reference Flux"
                                android:text="+"
                                android:textColor="@color/text_primary"
                                android:textSize="18sp"
                                android:textStyle="bold" />
                        </LinearLayout>
                    </LinearLayout>

                    <!-- Col 2: Earth Baseline Tare (µT) -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="4dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="4dp"
                            android:fontFamily="monospace"
                            android:text="EARTH TARE (µT)"
                            android:textColor="@color/text_secondary"
                            android:textSize="11sp"
                            android:textStyle="bold" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <Button
                                android:id="@+id/btnTareMinus"
                                android:layout_width="48dp"
                                android:layout_height="48dp"
                                android:background="@drawable/bg_stepper"
                                android:contentDescription="Decrease Baseline Tare"
                                android:text="-"
                                android:textColor="@color/text_primary"
                                android:textSize="18sp"
                                android:textStyle="bold" />

                            <EditText
                                android:id="@+id/etBaselineTare"
                                android:layout_width="0dp"
                                android:layout_height="48dp"
                                android:layout_marginLeft="4dp"
                                android:layout_marginRight="4dp"
                                android:layout_weight="1"
                                android:background="@drawable/bg_input_box"
                                android:contentDescription="Baseline Tare Input"
                                android:fontFamily="monospace"
                                android:gravity="center"
                                android:hint="@string/hint_tare_flux"
                                android:imeOptions="actionDone"
                                android:inputType="numberDecimal"
                                android:maxLength="6"
                                android:singleLine="true"
                                android:text="48.0"
                                android:textColor="@color/text_primary"
                                android:textColorHint="@color/text_muted"
                                android:textSize="14sp"
                                android:textStyle="bold" />

                            <Button
                                android:id="@+id/btnTarePlus"
                                android:layout_width="48dp"
                                android:layout_height="48dp"
                                android:background="@drawable/bg_stepper"
                                android:contentDescription="Increase Baseline Tare"
                                android:text="+"
                                android:textColor="@color/text_primary"
                                android:textSize="18sp"
                                android:textStyle="bold" />
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>

                <!-- Sensor Vector Mode Selector -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:layout_marginBottom="4dp"
                    android:fontFamily="monospace"
                    android:text="MAGNETOMETER VECTOR COUPLING"
                    android:textColor="@color/text_secondary"
                    android:textSize="10sp"
                    android:textStyle="bold" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <Button
                        android:id="@+id/btnModeVector"
                        android:layout_width="0dp"
                        android:layout_height="48dp"
                        android:layout_marginRight="4dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_chip_selected"
                        android:text="3D Vector"
                        android:textAllCaps="false"
                        android:textColor="@color/text_on_accent"
                        android:textSize="11sp"
                        android:textStyle="bold" />

                    <Button
                        android:id="@+id/btnModeZAxis"
                        android:layout_width="0dp"
                        android:layout_height="48dp"
                        android:layout_marginLeft="2dp"
                        android:layout_marginRight="2dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_chip_unselected"
                        android:text="Z-Depth"
                        android:textAllCaps="false"
                        android:textColor="@color/text_primary"
                        android:textSize="11sp"
                        android:textStyle="bold" />

                    <Button
                        android:id="@+id/btnModeXYPlane"
                        android:layout_width="0dp"
                        android:layout_height="48dp"
                        android:layout_marginLeft="4dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_chip_unselected"
                        android:text="XY Plane"
                        android:textAllCaps="false"
                        android:textColor="@color/text_primary"
                        android:textSize="11sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <!-- Hardware Sensor Status & Tare Earth Row -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/tvSensorHardwareInfo"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:fontFamily="monospace"
                        android:text="Hall Sensor: 115.0 µT • Tare 48.0 µT"
                        android:textColor="@color/text_muted"
                        android:textSize="11sp" />

                    <Button
                        android:id="@+id/btnResetTare"
                        android:layout_width="wrap_content"
                        android:layout_height="48dp"
                        android:background="@drawable/bg_btn_secondary"
                        android:paddingLeft="12dp"
                        android:paddingRight="12dp"
                        android:text="@string/btn_zero_baseline"
                        android:textAllCaps="false"
                        android:textColor="@color/text_primary"
                        android:textSize="11sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </LinearLayout>

            <!-- PANEL 2: STUD LOCATOR & ALARM THRESHOLD PRESETS -->
            <LinearLayout
                android:id="@+id/panelStud"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_card"
                android:orientation="vertical"
                android:padding="10dp"
                android:visibility="gone">

                <!-- Alarm Threshold Input & Apply Button at Top -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginRight="6dp"
                        android:fontFamily="monospace"
                        android:text="ALARM DELTA (µT):"
                        android:textColor="@color/text_secondary"
                        android:textSize="11sp"
                        android:textStyle="bold" />

                    <Button
                        android:id="@+id/btnAlarmMinus"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:background="@drawable/bg_stepper"
                        android:contentDescription="Decrease Alarm Threshold"
                        android:text="-"
                        android:textColor="@color/text_primary"
                        android:textSize="18sp"
                        android:textStyle="bold" />

                    <EditText
                        android:id="@+id/etAlertThreshold"
                        android:layout_width="68dp"
                        android:layout_height="48dp"
                        android:layout_marginLeft="4dp"
                        android:layout_marginRight="4dp"
                        android:background="@drawable/bg_input_box"
                        android:contentDescription="Alarm Threshold Input"
                        android:fontFamily="monospace"
                        android:gravity="center"
                        android:hint="@string/hint_alarm_ut"
                        android:imeOptions="actionDone"
                        android:inputType="numberDecimal"
                        android:maxLength="5"
                        android:singleLine="true"
                        android:text="85.0"
                        android:textColor="@color/text_primary"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <Button
                        android:id="@+id/btnAlarmPlus"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:background="@drawable/bg_stepper"
                        android:contentDescription="Increase Alarm Threshold"
                        android:text="+"
                        android:textColor="@color/text_primary"
                        android:textSize="18sp"
                        android:textStyle="bold" />

                    <Button
                        android:id="@+id/btnApplyAlarm"
                        android:layout_width="0dp"
                        android:layout_height="48dp"
                        android:layout_marginLeft="6dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_btn_primary"
                        android:text="Set Alarm"
                        android:textAllCaps="false"
                        android:textColor="@color/text_on_accent"
                        android:textSize="12sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:layout_marginBottom="4dp"
                    android:fontFamily="monospace"
                    android:text="FERROUS STUD, CONDUIT &amp; MAGNET BENCHMARKS"
                    android:textColor="@color/text_secondary"
                    android:textSize="10sp"
                    android:textStyle="bold" />

                <Button
                    android:id="@+id/btnPresetEarthField"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginBottom="4dp"
                    android:background="@drawable/bg_btn_secondary"
                    android:gravity="left|center_vertical"
                    android:paddingLeft="12dp"
                    android:paddingRight="12dp"
                    android:text="Earth Background Field • 48.0 µT (480 mG Normal)"
                    android:textAllCaps="false"
                    android:textColor="@color/text_primary"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <Button
                    android:id="@+id/btnPresetDrywallStud"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginBottom="4dp"
                    android:background="@drawable/bg_btn_secondary"
                    android:gravity="left|center_vertical"
                    android:paddingLeft="12dp"
                    android:paddingRight="12dp"
                    android:text="Drywall Fastener &amp; Steel Stud • 115.0 µT (+67 µT)"
                    android:textAllCaps="false"
                    android:textColor="@color/text_primary"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <Button
                    android:id="@+id/btnPresetAcConduit"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginBottom="4dp"
                    android:background="@drawable/bg_btn_secondary"
                    android:gravity="left|center_vertical"
                    android:paddingLeft="12dp"
                    android:paddingRight="12dp"
                    android:text="Steel Conduit &amp; Transformer Box • 190.0 µT (1,900 mG)"
                    android:textAllCaps="false"
                    android:textColor="@color/text_primary"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <Button
                    android:id="@+id/btnPresetRareMagnet"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginBottom="6dp"
                    android:background="@drawable/bg_btn_secondary"
                    android:gravity="left|center_vertical"
                    android:paddingLeft="12dp"
                    android:paddingRight="12dp"
                    android:text="Neodymium &amp; Speaker Driver • 420.0 µT (4,200 mG)"
                    android:textAllCaps="false"
                    android:textColor="@color/text_primary"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvGaussDiagnosis"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_card_elevated"
                    android:fontFamily="monospace"
                    android:padding="8dp"
                    android:text="Flux 115.0 µT (+67.0 µT Delta) • Ferrous drywall screw or steel stud signature."
                    android:textColor="@color/text_secondary"
                    android:textSize="11sp" />
            </LinearLayout>

            <!-- PANEL 3: SQLITE SCAN LOG -->
            <LinearLayout
                android:id="@+id/panelLog"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_card"
                android:orientation="vertical"
                android:padding="10dp"
                android:visibility="gone">

                <!-- Save Scan Bar at Top of Panel -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="8dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <EditText
                        android:id="@+id/etZoneName"
                        android:layout_width="0dp"
                        android:layout_height="48dp"
                        android:layout_marginRight="6dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_input_box"
                        android:contentDescription="Wall or Zone Label Input"
                        android:hint="@string/hint_zone_name"
                        android:imeOptions="actionDone"
                        android:inputType="textCapWords"
                        android:maxLength="22"
                        android:paddingLeft="10dp"
                        android:paddingRight="10dp"
                        android:singleLine="true"
                        android:text="North Wall Stud"
                        android:textColor="@color/text_primary"
                        android:textColorHint="@color/text_muted"
                        android:textSize="13sp" />

                    <Button
                        android:id="@+id/btnSaveScanLog"
                        android:layout_width="wrap_content"
                        android:layout_height="48dp"
                        android:background="@drawable/bg_btn_primary"
                        android:paddingLeft="14dp"
                        android:paddingRight="14dp"
                        android:text="@string/btn_save_scan"
                        android:textAllCaps="false"
                        android:textColor="@color/text_on_accent"
                        android:textSize="12sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="4dp"
                    android:fontFamily="monospace"
                    android:text="SAVED MAGNETIC &amp; STUD SCANS (TAP TO LOAD)"
                    android:textColor="@color/text_secondary"
                    android:textSize="10sp"
                    android:textStyle="bold" />

                <LinearLayout
                    android:id="@+id/llScanLogList"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</LinearLayout>
