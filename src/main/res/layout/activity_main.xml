<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/windowBackground">

    <!-- Top Header Bar -->
    <LinearLayout
        android:id="@+id/headerBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentTop="true"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="20dp"
        android:paddingTop="16dp"
        android:paddingEnd="20dp"
        android:paddingBottom="12dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/app_name"
                android:textColor="@color/textPrimary"
                android:textSize="22sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="@string/app_tagline"
                android:textColor="@color/textSecondary"
                android:textSize="12sp" />
        </LinearLayout>

        <Button
            android:id="@+id/btnHeaderTheme"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/chip_inactive"
            android:text="◐"
            android:textColor="@color/textPrimary"
            android:textSize="16sp" />

        <Button
            android:id="@+id/btnHeaderSettings"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginStart="8dp"
            android:background="@drawable/chip_inactive"
            android:text="⚙"
            android:textColor="@color/textPrimary"
            android:textSize="16sp" />
    </LinearLayout>

    <!-- Tab Bar -->
    <LinearLayout
        android:id="@+id/tabBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/headerBar"
        android:orientation="horizontal"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingBottom="10dp">

        <Button
            android:id="@+id/tabBtnFocus"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_weight="1"
            android:background="@drawable/chip_active"
            android:text="@string/tab_focus"
            android:textAllCaps="false"
            android:textColor="@color/textPrimary"
            android:textSize="13sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/tabBtnThoughts"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_marginStart="6dp"
            android:layout_weight="1"
            android:background="@drawable/chip_inactive"
            android:text="@string/tab_thoughts"
            android:textAllCaps="false"
            android:textColor="@color/textSecondary"
            android:textSize="13sp" />

        <Button
            android:id="@+id/tabBtnMomentum"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_marginStart="6dp"
            android:layout_weight="1"
            android:background="@drawable/chip_inactive"
            android:text="@string/tab_momentum"
            android:textAllCaps="false"
            android:textColor="@color/textSecondary"
            android:textSize="13sp" />
    </LinearLayout>

    <!-- Main Scrollable Content Area -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_above="@+id/bottomQuickBar"
        android:layout_below="@id/tabBar"
        android:fillViewport="true">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:paddingBottom="16dp">

            <!-- TAB 1: FOCUS (Tunnel Vision & Intake) -->
            <LinearLayout
                android:id="@+id/layoutFocus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="visible">

                <!-- Intake Section (Visible when NO active goal) -->
                <LinearLayout
                    android:id="@+id/sectionIntake"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/card_sanctuary"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Overcoming Inertia"
                        android:textColor="@color/textPrimary"
                        android:textSize="18sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="Type what task feels overwhelming. FlowStep will isolate only the first physical movement."
                        android:textColor="@color/textSecondary"
                        android:textSize="13sp" />

                    <EditText
                        android:id="@+id/etGoalInput"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:background="@drawable/edittext_calm"
                        android:hint="@string/intake_hint"
                        android:inputType="textCapSentences"
                        android:textColor="@color/textPrimary"
                        android:textColorHint="@color/m3_outline"
                        android:textSize="15sp" />

                    <!-- Quick Starter Chips -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:text="Quick Starters:"
                        android:textColor="@color/textSecondary"
                        android:textSize="12sp" />

                    <HorizontalScrollView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:scrollbars="none">

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal">

                            <Button
                                android:id="@+id/chipDesk"
                                android:layout_width="wrap_content"
                                android:layout_height="32dp"
                                android:background="@drawable/chip_inactive"
                                android:text="Clean Desk"
                                android:textAllCaps="false"
                                android:textColor="@color/textPrimary"
                                android:textSize="12sp" />

                            <Button
                                android:id="@+id/chipBills"
                                android:layout_width="wrap_content"
                                android:layout_height="32dp"
                                android:layout_marginStart="6dp"
                                android:background="@drawable/chip_inactive"
                                android:text="Pay Bills"
                                android:textAllCaps="false"
                                android:textColor="@color/textPrimary"
                                android:textSize="12sp" />

                            <Button
                                android:id="@+id/chipEmail"
                                android:layout_width="wrap_content"
                                android:layout_height="32dp"
                                android:layout_marginStart="6dp"
                                android:background="@drawable/chip_inactive"
                                android:text="Check Email"
                                android:textAllCaps="false"
                                android:textColor="@color/textPrimary"
                                android:textSize="12sp" />

                            <Button
                                android:id="@+id/chipLaundry"
                                android:layout_width="wrap_content"
                                android:layout_height="32dp"
                                android:layout_marginStart="6dp"
                                android:background="@drawable/chip_inactive"
                                android:text="Do Laundry"
                                android:textAllCaps="false"
                                android:textColor="@color/textPrimary"
                                android:textSize="12sp" />

                            <Button
                                android:id="@+id/chipWorkout"
                                android:layout_width="wrap_content"
                                android:layout_height="32dp"
                                android:layout_marginStart="6dp"
                                android:background="@drawable/chip_inactive"
                                android:text="Quick Walk"
                                android:textAllCaps="false"
                                android:textColor="@color/textPrimary"
                                android:textSize="12sp" />
                        </LinearLayout>
                    </HorizontalScrollView>

                    <Button
                        android:id="@+id/btnAtomizeGoal"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:layout_marginTop="18dp"
                        android:background="@drawable/btn_action"
                        android:text="@string/atomize_action"
                        android:textAllCaps="false"
                        android:textColor="@color/btnTextColor"
                        android:textSize="15sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvAtomizerMode"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center_horizontal"
                        android:layout_marginTop="10dp"
                        android:text="⚡ 100% Offline Rule Decomposer Active"
                        android:textColor="@color/textSecondary"
                        android:textSize="11sp" />
                </LinearLayout>

                <!-- Tunnel-Vision Active Focus Section (Visible when goal is active) -->
                <LinearLayout
                    android:id="@+id/sectionTunnelVision"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/card_sanctuary"
                    android:orientation="vertical"
                    android:padding="20dp"
                    android:visibility="gone">

                    <!-- Active Goal Banner -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/tvActiveGoalTitle"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Clean Desk"
                            android:textColor="@color/textPrimary"
                            android:textSize="16sp"
                            android:textStyle="bold" />

                        <Button
                            android:id="@+id/btnPauseSession"
                            android:layout_width="wrap_content"
                            android:layout_height="32dp"
                            android:background="@drawable/chip_inactive"
                            android:text="Pause Session"
                            android:textAllCaps="false"
                            android:textColor="@color/textSecondary"
                            android:textSize="11sp" />
                    </LinearLayout>

                    <!-- Visual Pacer Breathing Arc -->
                    <com.kimrosil.flowstep.VisualPacerView
                        android:id="@+id/visualPacerView"
                        android:layout_width="200dp"
                        android:layout_height="200dp"
                        android:layout_gravity="center_horizontal"
                        android:layout_marginTop="16dp"
                        android:layout_marginBottom="16dp" />

                    <!-- Active Single Micro-Action Card -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@drawable/card_m3_high"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <TextView
                            android:id="@+id/tvActionVerbBadge"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:background="@drawable/badge_verb"
                            android:paddingStart="10dp"
                            android:paddingTop="3dp"
                            android:paddingEnd="10dp"
                            android:paddingBottom="3dp"
                            android:text="STAND UP"
                            android:textColor="@color/verbBadgeText"
                            android:textSize="11sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tvStepInstruction"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="10dp"
                            android:lineSpacingExtra="4dp"
                            android:text="Stand up and walk to the desk area right now."
                            android:textColor="@color/textPrimary"
                            android:textSize="18sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tvStepProgressInfo"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:text="Step 1 of 4 • Under 2 minutes"
                            android:textColor="@color/textSecondary"
                            android:textSize="12sp" />
                    </LinearLayout>

                    <!-- Primary Step Complete Button -->
                    <Button
                        android:id="@+id/btnCompleteStep"
                        android:layout_width="match_parent"
                        android:layout_height="52dp"
                        android:layout_marginTop="18dp"
                        android:background="@drawable/btn_step_complete"
                        android:text="@string/complete_step_action"
                        android:textAllCaps="false"
                        android:textColor="@color/btnTextColor"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <!-- Secondary Too Hard Button -->
                    <Button
                        android:id="@+id/btnBreakDown"
                        android:layout_width="match_parent"
                        android:layout_height="44dp"
                        android:layout_marginTop="10dp"
                        android:background="@drawable/btn_break_down"
                        android:text="@string/too_hard_action"
                        android:textAllCaps="false"
                        android:textColor="@color/breakDownBtnText"
                        android:textSize="14sp"
                        android:textStyle="bold" />
                </LinearLayout>

            </LinearLayout>

            <!-- TAB 2: STRAY THOUGHT BUFFER -->
            <LinearLayout
                android:id="@+id/layoutThoughts"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/card_sanctuary"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Stray Thought Buffer"
                        android:textColor="@color/textPrimary"
                        android:textSize="18sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="Park distractions instantly so your working memory stays empty."
                        android:textColor="@color/textSecondary"
                        android:textSize="13sp" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:orientation="horizontal">

                        <EditText
                            android:id="@+id/etDirectThoughtInput"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:background="@drawable/edittext_calm"
                            android:hint="Quick thought..."
                            android:inputType="textCapSentences"
                            android:textColor="@color/textPrimary"
                            android:textColorHint="@color/m3_outline"
                            android:textSize="14sp" />

                        <Button
                            android:id="@+id/btnDirectParkThought"
                            android:layout_width="wrap_content"
                            android:layout_height="44dp"
                            android:layout_marginStart="8dp"
                            android:background="@drawable/btn_action"
                            android:text="Park"
                            android:textAllCaps="false"
                            android:textColor="@color/btnTextColor"
                            android:textSize="14sp"
                            android:textStyle="bold" />
                    </LinearLayout>
                </LinearLayout>

                <TextView
                    android:id="@+id/tvThoughtsHeader"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:layout_marginBottom="8dp"
                    android:text="Parked Thoughts:"
                    android:textColor="@color/textPrimary"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <LinearLayout
                    android:id="@+id/containerThoughtsList"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />
            </LinearLayout>

            <!-- TAB 3: MOMENTUM LEDGER (Lifetime Wins) -->
            <LinearLayout
                android:id="@+id/layoutMomentum"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/card_sanctuary"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Lifetime Momentum Ledger"
                        android:textColor="@color/textPrimary"
                        android:textSize="18sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="Zero broken streaks. No guilt, no penalties. Every micro-action forward belongs to you forever."
                        android:textColor="@color/textSecondary"
                        android:textSize="13sp" />

                    <!-- Metrics Grid -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="18dp"
                        android:orientation="horizontal">

                        <!-- Steps Conquered -->
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:background="@drawable/card_m3"
                            android:gravity="center"
                            android:orientation="vertical"
                            android:padding="12dp">

                            <TextView
                                android:id="@+id/tvMetricSteps"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="0"
                                android:textColor="@color/m3_primary"
                                android:textSize="26sp"
                                android:textStyle="bold" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Steps Completed"
                                android:textColor="@color/textSecondary"
                                android:textSize="11sp" />
                        </LinearLayout>

                        <!-- Goals Completed -->
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:layout_weight="1"
                            android:background="@drawable/card_m3"
                            android:gravity="center"
                            android:orientation="vertical"
                            android:padding="12dp">

                            <TextView
                                android:id="@+id/tvMetricGoals"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="0"
                                android:textColor="@color/m3_success"
                                android:textSize="26sp"
                                android:textStyle="bold" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Goals Conquered"
                                android:textColor="@color/textSecondary"
                                android:textSize="11sp" />
                        </LinearLayout>

                        <!-- Thoughts Parked -->
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:layout_weight="1"
                            android:background="@drawable/card_m3"
                            android:gravity="center"
                            android:orientation="vertical"
                            android:padding="12dp">

                            <TextView
                                android:id="@+id/tvMetricThoughts"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="0"
                                android:textColor="@color/colorAccent"
                                android:textSize="26sp"
                                android:textStyle="bold" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Thoughts Parked"
                                android:textColor="@color/textSecondary"
                                android:textSize="11sp" />
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:background="@drawable/card_sanctuary"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="ADHD Executive Principle"
                        android:textColor="@color/textPrimary"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:lineSpacingExtra="3dp"
                        android:text="When a task feels too big, the brain freezes in executive paralysis. The cure is never willpower — it is reducing the physical action threshold until starting becomes effortless."
                        android:textColor="@color/textSecondary"
                        android:textSize="13sp" />
                </LinearLayout>
            </LinearLayout>

        </FrameLayout>
    </ScrollView>

    <!-- Persistent Bottom Bar: 1-Tap Stray Thought Capture -->
    <LinearLayout
        android:id="@+id/bottomQuickBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:background="@color/windowBackground"
        android:gravity="center"
        android:paddingStart="20dp"
        android:paddingTop="8dp"
        android:paddingEnd="20dp"
        android:paddingBottom="14dp">

        <Button
            android:id="@+id/btnQuickParkThought"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:background="@drawable/btn_park_thought"
            android:text="@string/park_thought_action"
            android:textAllCaps="false"
            android:textColor="@color/textPrimary"
            android:textSize="14sp"
            android:textStyle="bold" />
    </LinearLayout>

</RelativeLayout>
