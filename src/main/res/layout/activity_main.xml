<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_canvas"
    android:fillViewport="true">

    <LinearLayout
        android:id="@+id/rootContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="12dp">

        <!-- Top Header Action Bar -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvBrandTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-black"
                    android:text="@string/app_name"
                    android:textColor="@color/text_primary"
                    android:textSize="22sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvBrandSubtitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="monospace"
                    android:text="COPPER BRAZING &amp; PURGE ENGINE"
                    android:textColor="@color/accent_primary"
                    android:textSize="10.5sp" />
            </LinearLayout>

            <ImageButton
                android:id="@+id/btnThemeToggle"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_marginRight="6dp"
                android:background="@drawable/bg_header_icon_btn"
                android:contentDescription="Toggle Light and Dark Display Theme"
                android:scaleType="centerInside"
                android:src="@drawable/ic_theme" />

            <ImageButton
                android:id="@+id/btnSettings"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="@drawable/bg_header_icon_btn"
                android:contentDescription="BrazeRing Preferences &amp; Settings"
                android:scaleType="centerInside"
                android:src="@drawable/ic_settings" />
        </LinearLayout>

        <!-- Alloy Type Selector Chips -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnAlloyBcup5"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_marginRight="3dp"
                android:layout_weight="1.2"
                android:background="@drawable/bg_chip_selected"
                android:contentDescription="Select Sil-Fos 15% silver alloy"
                android:minHeight="48dp"
                android:text="Sil-Fos 15 (15% Ag)"
                android:textAllCaps="false"
                android:textColor="@color/text_on_accent"
                android:textSize="11sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btnAlloyBcup2"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_marginLeft="2dp"
                android:layout_marginRight="2dp"
                android:layout_weight="1"
                android:background="@drawable/bg_chip_unselected"
                android:contentDescription="Select BCuP-2 0% silver alloy"
                android:minHeight="48dp"
                android:text="BCuP-2 (0% Ag)"
                android:textAllCaps="false"
                android:textColor="@color/text_primary"
                android:textSize="11sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btnAlloyBag36"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_marginLeft="3dp"
                android:layout_weight="1"
                android:background="@drawable/bg_chip_unselected"
                android:contentDescription="Select Safety-Silv 45% silver alloy"
                android:minHeight="48dp"
                android:text="45% Silver (BAg)"
                android:textAllCaps="false"
                android:textColor="@color/text_primary"
                android:textSize="11sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Telemetry Hero HUD Card -->
        <LinearLayout
            android:id="@+id/cardTelemetryHero"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_hero_card"
            android:orientation="vertical"
            android:padding="12dp">

            <!-- Primary Alloy Output -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="monospace"
                android:text="REQUIRED ALLOY ALLOCATION (PER JOINT)"
                android:textColor="@color/text_secondary"
                android:textSize="10.5sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvHeroGrams"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:fontFamily="sans-serif-black"
                android:text="1.85 g"
                android:textColor="@color/accent_primary"
                android:textSize="26sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvHeroGramsSub"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="monospace"
                android:text="0.065 oz • 0.0078 in³ Annular Volume"
                android:textColor="@color/text_secondary"
                android:textSize="11.5sp" />

            <!-- Hairline Divider -->
            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="8dp"
                android:background="@color/divider_line" />

            <!-- 2-Column Metrics Grid -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <!-- Column 1: Rod & Preform Ring -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="monospace"
                        android:text="WIRE &amp; PREFORM"
                        android:textColor="@color/text_muted"
                        android:textSize="9.5sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvHeroRodLength"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="1dp"
                        android:fontFamily="sans-serif-black"
                        android:text="2.5 in (1/16 in Rod)"
                        android:textColor="@color/text_primary"
                        android:textSize="15sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvHeroPreformGauge"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="monospace"
                        android:text="Ring: 1/16 in Wire"
                        android:textColor="@color/text_secondary"
                        android:textSize="10.5sp" />
                </LinearLayout>

                <!-- Vertical Hairline Divider -->
                <View
                    android:layout_width="1dp"
                    android:layout_height="match_parent"
                    android:layout_marginLeft="6dp"
                    android:layout_marginRight="6dp"
                    android:background="@color/divider_line" />

                <!-- Column 2: Nitrogen Sweep -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="monospace"
                        android:text="NITROGEN PURGE SWEEP"
                        android:textColor="@color/text_muted"
                        android:textSize="9.5sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvHeroN2Flow"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="1dp"
                        android:fontFamily="sans-serif-black"
                        android:text="3.5 SCFH"
                        android:textColor="@color/text_primary"
                        android:textSize="15sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvHeroN2Pressure"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="monospace"
                        android:text="1 - 2 PSI Low Flow"
                        android:textColor="@color/text_secondary"
                        android:textSize="10.5sp" />
                </LinearLayout>
            </LinearLayout>

            <!-- Clearance Status Banner -->
            <LinearLayout
                android:id="@+id/layoutClearanceBadge"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_badge_pass"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingLeft="8dp"
                android:paddingTop="5dp"
                android:paddingRight="8dp"
                android:paddingBottom="5dp">

                <ImageView
                    android:id="@+id/ivClearanceIcon"
                    android:layout_width="14dp"
                    android:layout_height="14dp"
                    android:layout_marginRight="6dp"
                    android:src="@drawable/ic_check" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tvClearanceStatus"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-black"
                        android:text="OPTIMAL CAPILLARY CLEARANCE"
                        android:textColor="@color/badge_text_pass"
                        android:textSize="10.5sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvClearanceReason"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Clearance 0.002 - 0.004 in provides maximum capillary draw."
                        android:textColor="@color/badge_text_pass"
                        android:textSize="9.5sp" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>

        <!-- Live Cross Section Canvas Card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_card"
            android:orientation="vertical"
            android:padding="10dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="monospace"
                android:text="LIVE JOINT CROSS-SECTION &amp; PENETRATION"
                android:textColor="@color/text_secondary"
                android:textSize="10.5sp"
                android:textStyle="bold" />

            <com.kimrosil.brazering.BrazeJointView
                android:id="@+id/brazeJointView"
                android:layout_width="match_parent"
                android:layout_height="125dp"
                android:layout_marginTop="4dp" />
        </LinearLayout>

        <!-- Parameters Card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_card"
            android:orientation="vertical"
            android:padding="12dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="monospace"
                android:text="STANDARD COPPER TUBE OD PRESETS"
                android:textColor="@color/text_secondary"
                android:textSize="10.5sp"
                android:textStyle="bold" />

            <!-- Row 1 OD Chips -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btnOd3_8"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_marginRight="2dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_chip_unselected"
                    android:contentDescription="Select 3/8 inch tube"
                    android:minHeight="48dp"
                    android:text="3/8 in"
                    android:textAllCaps="false"
                    android:textColor="@color/text_primary"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <Button
                    android:id="@+id/btnOd1_2"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_marginLeft="2dp"
                    android:layout_marginRight="2dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_chip_unselected"
                    android:contentDescription="Select 1/2 inch tube"
                    android:minHeight="48dp"
                    android:text="1/2 in"
                    android:textAllCaps="false"
                    android:textColor="@color/text_primary"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <Button
                    android:id="@+id/btnOd3_4"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_marginLeft="2dp"
                    android:layout_marginRight="2dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_chip_unselected"
                    android:contentDescription="Select 3/4 inch tube"
                    android:minHeight="48dp"
                    android:text="3/4 in"
                    android:textAllCaps="false"
                    android:textColor="@color/text_primary"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <Button
                    android:id="@+id/btnOd7_8"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_marginLeft="2dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_chip_selected"
                    android:contentDescription="Select 7/8 inch tube"
                    android:minHeight="48dp"
                    android:text="7/8 in"
                    android:textAllCaps="false"
                    android:textColor="@color/text_on_accent"
                    android:textSize="11sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Stepper 1: Outside Diameter (OD) -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:fontFamily="monospace"
                android:text="TUBE OUTSIDE DIAMETER (IN)"
                android:textColor="@color/text_secondary"
                android:textSize="10.5sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="4dp"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btnOdDec"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:background="@drawable/bg_stepper"
                    android:contentDescription="Decrease tube diameter"
                    android:minHeight="48dp"
                    android:minWidth="48dp"
                    android:text="-"
                    android:textColor="@color/text_primary"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <EditText
                    android:id="@+id/etTubeOd"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_marginLeft="4dp"
                    android:layout_marginRight="4dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_input_box"
                    android:contentDescription="Tube outside diameter"
                    android:gravity="center"
                    android:hint="0.875"
                    android:imeOptions="actionDone"
                    android:inputType="numberDecimal"
                    android:textColor="@color/text_primary"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <Button
                    android:id="@+id/btnOdInc"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:background="@drawable/bg_stepper"
                    android:contentDescription="Increase tube diameter"
                    android:minHeight="48dp"
                    android:minWidth="48dp"
                    android:text="+"
                    android:textColor="@color/text_primary"
                    android:textSize="18sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Stepper 2: Socket Insertion Depth -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:fontFamily="monospace"
                android:text="SOCKET INSERTION DEPTH (IN)"
                android:textColor="@color/text_secondary"
                android:textSize="10.5sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="4dp"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btnDepthDec"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:background="@drawable/bg_stepper"
                    android:contentDescription="Decrease socket depth"
                    android:minHeight="48dp"
                    android:minWidth="48dp"
                    android:text="-"
                    android:textColor="@color/text_primary"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <EditText
                    android:id="@+id/etSocketDepth"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_marginLeft="4dp"
                    android:layout_marginRight="4dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_input_box"
                    android:contentDescription="Socket depth"
                    android:gravity="center"
                    android:hint="0.75"
                    android:imeOptions="actionDone"
                    android:inputType="numberDecimal"
                    android:textColor="@color/text_primary"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <Button
                    android:id="@+id/btnDepthInc"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:background="@drawable/bg_stepper"
                    android:contentDescription="Increase socket depth"
                    android:minHeight="48dp"
                    android:minWidth="48dp"
                    android:text="+"
                    android:textColor="@color/text_primary"
                    android:textSize="18sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Stepper 3: Radial Clearance Gap -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:fontFamily="monospace"
                android:text="RADIAL CLEARANCE GAP (IN)"
                android:textColor="@color/text_secondary"
                android:textSize="10.5sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="4dp"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btnClrDec"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:background="@drawable/bg_stepper"
                    android:contentDescription="Decrease clearance"
                    android:minHeight="48dp"
                    android:minWidth="48dp"
                    android:text="-"
                    android:textColor="@color/text_primary"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <EditText
                    android:id="@+id/etClearance"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_marginLeft="4dp"
                    android:layout_marginRight="4dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_input_box"
                    android:contentDescription="Radial clearance"
                    android:gravity="center"
                    android:hint="0.003"
                    android:imeOptions="actionDone"
                    android:inputType="numberDecimal"
                    android:textColor="@color/text_primary"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <Button
                    android:id="@+id/btnClrInc"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:background="@drawable/bg_stepper"
                    android:contentDescription="Increase clearance"
                    android:minHeight="48dp"
                    android:minWidth="48dp"
                    android:text="+"
                    android:textColor="@color/text_primary"
                    android:textSize="18sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Stepper 4: Number of Joints -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:fontFamily="monospace"
                android:text="NUMBER OF JOINTS (JOB QUANTITY)"
                android:textColor="@color/text_secondary"
                android:textSize="10.5sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="4dp"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btnCountDec"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:background="@drawable/bg_stepper"
                    android:contentDescription="Decrease joint count"
                    android:minHeight="48dp"
                    android:minWidth="48dp"
                    android:text="-"
                    android:textColor="@color/text_primary"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <EditText
                    android:id="@+id/etJointCount"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_marginLeft="4dp"
                    android:layout_marginRight="4dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_input_box"
                    android:contentDescription="Joint quantity"
                    android:gravity="center"
                    android:hint="1"
                    android:imeOptions="actionDone"
                    android:inputType="number"
                    android:textColor="@color/text_primary"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <Button
                    android:id="@+id/btnCountInc"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:background="@drawable/bg_stepper"
                    android:contentDescription="Increase joint count"
                    android:minHeight="48dp"
                    android:minWidth="48dp"
                    android:text="+"
                    android:textColor="@color/text_primary"
                    android:textSize="18sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>

        <!-- Action Buttons -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnSaveJob"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_marginRight="3dp"
                android:layout_weight="1.4"
                android:background="@drawable/bg_btn_primary"
                android:contentDescription="Save braze spec to job log"
                android:minHeight="48dp"
                android:text="Save Braze Job"
                android:textAllCaps="false"
                android:textColor="@color/text_on_accent"
                android:textSize="12sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btnCopySpec"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_marginLeft="2dp"
                android:layout_marginRight="2dp"
                android:layout_weight="1.1"
                android:background="@drawable/bg_btn_secondary"
                android:contentDescription="Copy braze spec to clipboard"
                android:minHeight="48dp"
                android:text="Copy Spec"
                android:textAllCaps="false"
                android:textColor="@color/text_primary"
                android:textSize="12sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btnReset"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_marginLeft="3dp"
                android:layout_weight="0.8"
                android:background="@drawable/bg_btn_secondary"
                android:contentDescription="Reset inputs"
                android:minHeight="48dp"
                android:text="Reset"
                android:textAllCaps="false"
                android:textColor="@color/accent_danger"
                android:textSize="12sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Saved Jobs Log Card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:layout_marginBottom="24dp"
            android:background="@drawable/bg_card"
            android:orientation="vertical"
            android:padding="12dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="monospace"
                android:text="JOB BRAZING LOG"
                android:textColor="@color/text_secondary"
                android:textSize="10.5sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvEmptyLog"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:layout_marginBottom="4dp"
                android:text="No braze joints logged yet. Configure parameters and tap 'Save Braze Job' to store jobsite records."
                android:textColor="@color/text_muted"
                android:textSize="11.5sp" />

            <LinearLayout
                android:id="@+id/llSavedJobsContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />
        </LinearLayout>

    </LinearLayout>
</ScrollView>
