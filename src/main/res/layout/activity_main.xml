<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/colorBackground">

    <!-- Top Action Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingLeft="16dp"
        android:paddingRight="16dp"
        android:background="@color/colorSurface">

        <ImageView
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:src="@drawable/ic_rebar"
            android:contentDescription="@string/app_name" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="12dp"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/app_name"
                android:textColor="@color/colorTextPrimary"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/app_tagline"
                android:textColor="@color/colorTextSecondary"
                android:textSize="11sp" />
        </LinearLayout>

        <ImageButton
            android:id="@+id/btnTheme"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="@drawable/bg_icon_btn"
            android:src="@drawable/ic_theme"
            android:contentDescription="Switch Theme" />

        <Space
            android:layout_width="8dp"
            android:layout_height="match_parent" />

        <ImageButton
            android:id="@+id/btnSettings"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="@drawable/bg_icon_btn"
            android:src="@drawable/ic_settings"
            android:contentDescription="@string/settings" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:overScrollMode="never">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="12dp">

            <!-- Primary Hero Result Card -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_hero_card"
                android:padding="14dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/class_b_tension"
                        android:textColor="@color/colorTextSecondary"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvSpliceClassBadge"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_badge_safe"
                        android:paddingLeft="8dp"
                        android:paddingTop="3dp"
                        android:paddingRight="8dp"
                        android:paddingBottom="3dp"
                        android:text="ACI 318-19 • Class B"
                        android:textColor="#FFFFFF"
                        android:textSize="10sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <!-- Large Primary Readout -->
                <TextView
                    android:id="@+id/tvClassBLap"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="0.0 in"
                    android:textColor="@color/colorPrimary"
                    android:textSize="28sp"
                    android:textStyle="bold" />

                <!-- Tabular 2-Column Telemetry Grid -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:orientation="horizontal">

                    <!-- Col 1: Tension Dev Length (Ld) -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:paddingRight="6dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/development_len"
                            android:textColor="@color/colorTextSecondary"
                            android:textSize="11sp" />

                        <TextView
                            android:id="@+id/tvDevLength"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="0.0 in"
                            android:textColor="@color/colorTextPrimary"
                            android:textSize="15sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <!-- Divider -->
                    <View
                        android:layout_width="1dp"
                        android:layout_height="match_parent"
                        android:background="@color/colorBorder" />

                    <!-- Col 2: Compression Lap -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:paddingLeft="8dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/comp_lap"
                            android:textColor="@color/colorTextSecondary"
                            android:textSize="11sp" />

                        <TextView
                            android:id="@+id/tvCompLap"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="0.0 in"
                            android:textColor="@color/colorTextPrimary"
                            android:textSize="15sp"
                            android:textStyle="bold" />
                    </LinearLayout>
                </LinearLayout>

                <!-- Hook Geometry Sub-Row -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/tvHook90"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="90° Hook: 7.5 in"
                        android:textColor="@color/colorTextSecondary"
                        android:textSize="11sp" />

                    <TextView
                        android:id="@+id/tvPinDia"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Pin Dia: 3.8 in"
                        android:textColor="@color/colorTextSecondary"
                        android:textSize="11sp" />
                </LinearLayout>

                <!-- Rebar Splice Graphic Canvas -->
                <com.kimrosil.rebarlap.RebarSpliceView
                    android:id="@+id/rebarView"
                    android:layout_width="match_parent"
                    android:layout_height="105dp"
                    android:layout_marginTop="10dp" />

            </LinearLayout>

            <!-- Quick Action Buttons -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btnCopySchedule"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="1"
                    android:layout_marginEnd="6dp"
                    android:background="@drawable/bg_btn_primary"
                    android:text="@string/copy_summary"
                    android:textColor="#FFFFFF"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:contentDescription="Copy rebar splice schedule to clipboard" />

                <Button
                    android:id="@+id/btnSaveDetail"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="1"
                    android:layout_marginStart="6dp"
                    android:background="@drawable/bg_btn_secondary"
                    android:text="@string/save_setup"
                    android:textColor="@color/colorPrimary"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:contentDescription="Save splice detail to offline records" />
            </LinearLayout>

            <!-- Bar Size Chips Scroll -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:layout_marginBottom="4dp"
                android:text="Select Rebar Bar Size"
                android:textColor="@color/colorTextSecondary"
                android:textSize="12sp"
                android:textStyle="bold" />

            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:scrollbars="none"
                android:overScrollMode="never">

                <LinearLayout
                    android:id="@+id/layoutBarChips"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:paddingTop="2dp"
                    android:paddingBottom="2dp" />
            </HorizontalScrollView>

            <!-- Concrete & Steel Specifications Card -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:orientation="vertical"
                android:background="@drawable/bg_card"
                android:padding="14dp">

                <!-- Concrete Compressive Strength fc Row -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Concrete Compressive Strength (fc)"
                    android:textColor="@color/colorTextPrimary"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:orientation="horizontal">

                    <Button
                        android:id="@+id/btnFc3000"
                        android:layout_width="0dp"
                        android:layout_height="48dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_chip_unselected"
                        android:text="3000 psi"
                        android:textColor="@color/colorTextPrimary"
                        android:textSize="11sp"
                        android:contentDescription="Concrete strength 3000 psi" />

                    <Button
                        android:id="@+id/btnFc4000"
                        android:layout_width="0dp"
                        android:layout_height="48dp"
                        android:layout_weight="1"
                        android:layout_marginStart="4dp"
                        android:background="@drawable/bg_chip_selected"
                        android:text="4000 psi"
                        android:textColor="#FFFFFF"
                        android:textSize="11sp"
                        android:contentDescription="Concrete strength 4000 psi" />

                    <Button
                        android:id="@+id/btnFc5000"
                        android:layout_width="0dp"
                        android:layout_height="48dp"
                        android:layout_weight="1"
                        android:layout_marginStart="4dp"
                        android:background="@drawable/bg_chip_unselected"
                        android:text="5000 psi"
                        android:textColor="@color/colorTextPrimary"
                        android:textSize="11sp"
                        android:contentDescription="Concrete strength 5000 psi" />

                    <Button
                        android:id="@+id/btnFc6000"
                        android:layout_width="0dp"
                        android:layout_height="48dp"
                        android:layout_weight="1"
                        android:layout_marginStart="4dp"
                        android:background="@drawable/bg_chip_unselected"
                        android:text="6000 psi"
                        android:textColor="@color/colorTextPrimary"
                        android:textSize="11sp"
                        android:contentDescription="Concrete strength 6000 psi" />
                </LinearLayout>

                <!-- Steel Yield Strength fy Row -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="Steel Reinforcement Grade (fy)"
                    android:textColor="@color/colorTextPrimary"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:orientation="horizontal">

                    <Button
                        android:id="@+id/btnGrade60"
                        android:layout_width="0dp"
                        android:layout_height="48dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_chip_selected"
                        android:text="Grade 60 (60 ksi)"
                        android:textColor="#FFFFFF"
                        android:textSize="12sp"
                        android:contentDescription="Grade 60 steel yield 60000 psi" />

                    <Button
                        android:id="@+id/btnGrade80"
                        android:layout_width="0dp"
                        android:layout_height="48dp"
                        android:layout_weight="1"
                        android:layout_marginStart="6dp"
                        android:background="@drawable/bg_chip_unselected"
                        android:text="Grade 80 (80 ksi)"
                        android:textColor="@color/colorTextPrimary"
                        android:textSize="12sp"
                        android:contentDescription="Grade 80 steel yield 80000 psi" />
                </LinearLayout>

                <!-- Placement Conditions (Top Bar / Epoxy) -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="Placement &amp; Coating Conditions"
                    android:textColor="@color/colorTextPrimary"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:orientation="horizontal">

                    <Button
                        android:id="@+id/btnToggleTopBar"
                        android:layout_width="0dp"
                        android:layout_height="48dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_chip_unselected"
                        android:text="Top Bar (>12 in.)"
                        android:textColor="@color/colorTextPrimary"
                        android:textSize="12sp"
                        android:contentDescription="Toggle top bar placement factor 1.3" />

                    <Button
                        android:id="@+id/btnToggleEpoxy"
                        android:layout_width="0dp"
                        android:layout_height="48dp"
                        android:layout_weight="1"
                        android:layout_marginStart="6dp"
                        android:background="@drawable/bg_chip_unselected"
                        android:text="Epoxy Coated"
                        android:textColor="@color/colorTextPrimary"
                        android:textSize="12sp"
                        android:contentDescription="Toggle epoxy coated reinforcement factor 1.2" />
                </LinearLayout>

            </LinearLayout>

            <!-- Saved Splices Card -->
            <LinearLayout
                android:id="@+id/layoutSavedCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:orientation="vertical"
                android:background="@drawable/bg_card"
                android:padding="14dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Recent Saved Splices"
                        android:textColor="@color/colorTextPrimary"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvRecordCount"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0 splices"
                        android:textColor="@color/colorTextSecondary"
                        android:textSize="11sp" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/layoutRecentList"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:orientation="vertical" />
            </LinearLayout>

        </LinearLayout>
    </ScrollView>
</LinearLayout>
