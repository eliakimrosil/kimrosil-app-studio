<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="@color/m3_surface"
    android:scrollbars="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- TOP BAR / HEADER -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="16dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvAppTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="CrumbWatch Sentinel"
                    android:textSize="22sp"
                    android:textStyle="bold"
                    android:textColor="@color/m3_on_surface" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Precision Sourdough &amp; Fermentation Telemetry"
                    android:textSize="12sp"
                    android:textColor="@color/m3_on_surface_variant" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvStatusBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="IDLE"
                android:textStyle="bold"
                android:textSize="11sp"
                android:paddingLeft="8dp"
                android:paddingRight="8dp"
                android:paddingTop="4dp"
                android:paddingBottom="4dp"
                android:layout_marginRight="8dp"
                android:background="@drawable/bg_badge"
                android:textColor="@color/m3_on_primary" />

            <Button
                android:id="@+id/btnThemeToggle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minHeight="36dp"
                android:paddingLeft="12dp"
                android:paddingRight="12dp"
                android:text="Auto Theme"
                android:textSize="12sp"
                android:textColor="@color/m3_on_surface"
                android:background="@drawable/bg_button_secondary" />
        </LinearLayout>

        <!-- LIVE TIMER & TELEMETRY HUD CARD -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp"
            android:background="@drawable/bg_hud_card"
            android:layout_marginBottom="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="ELAPSED FERMENT DURATION"
                android:textSize="11sp"
                android:textStyle="bold"
                android:letterSpacing="0.08"
                android:textColor="@color/m3_on_surface_variant" />

            <TextView
                android:id="@+id/tvTimerCountdown"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="00:00:00"
                android:textSize="44sp"
                android:textStyle="bold"
                android:fontFamily="monospace"
                android:textColor="@color/m3_primary"
                android:layout_marginTop="2dp"
                android:layout_marginBottom="10dp" />

            <TextView
                android:id="@+id/tvCalculatedRise"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0.0% Rise (Target: 100%)"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="@color/m3_on_surface" />

            <TextView
                android:id="@+id/tvFermentStage"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Stage: Lag Phase (Yeast Colonization)"
                android:textSize="13sp"
                android:textColor="@color/m3_on_surface_variant"
                android:layout_marginTop="4dp" />

            <TextView
                android:id="@+id/tvEstimatedRemaining"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="~05h 45m remaining to target rise"
                android:textSize="13sp"
                android:textStyle="bold"
                android:textColor="@color/m3_primary"
                android:layout_marginTop="6dp" />

            <!-- TIMER CONTROLS -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="16dp">

                <Button
                    android:id="@+id/btnStartStopTimer"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Start Monitor"
                    android:textStyle="bold"
                    android:background="@drawable/bg_button_primary"
                    android:textColor="@color/m3_on_primary"
                    android:layout_marginRight="8dp" />

                <Button
                    android:id="@+id/btnResetTimer"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Reset"
                    android:background="@drawable/bg_button_secondary"
                    android:textColor="@color/m3_on_surface" />
            </LinearLayout>
        </LinearLayout>

        <!-- FERMENT INPUTS & PARAMETERS CARD -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp"
            android:background="@drawable/bg_section_card"
            android:layout_marginBottom="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="VESSEL SENSOR &amp; METRIC READINGS"
                android:textSize="11sp"
                android:textStyle="bold"
                android:letterSpacing="0.05"
                android:textColor="@color/m3_on_surface_variant"
                android:layout_marginBottom="12dp" />

            <!-- Heights: Initial & Current -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:layout_marginRight="8dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Baseline Height (mm)"
                        android:textSize="12sp"
                        android:textColor="@color/m3_on_surface" />

                    <EditText
                        android:id="@+id/etInitialHeight"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="50"
                        android:inputType="numberDecimal"
                        android:textColor="@color/m3_on_surface"
                        android:textColorHint="@color/m3_outline"
                        android:background="@drawable/bg_edittext"
                        android:padding="10dp"
                        android:layout_marginTop="4dp" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Current Height (mm)"
                        android:textSize="12sp"
                        android:textColor="@color/m3_on_surface" />

                    <EditText
                        android:id="@+id/etCurrentHeight"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="75"
                        android:inputType="numberDecimal"
                        android:textColor="@color/m3_on_surface"
                        android:textColorHint="@color/m3_outline"
                        android:background="@drawable/bg_edittext"
                        android:padding="10dp"
                        android:layout_marginTop="4dp" />
                </LinearLayout>
            </LinearLayout>

            <!-- Target Rise Slider -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="16dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Target Rise Expansion"
                    android:textSize="13sp"
                    android:textColor="@color/m3_on_surface" />

                <TextView
                    android:id="@+id/tvTargetRiseDisplay"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="100% Target Vol"
                    android:textStyle="bold"
                    android:textColor="@color/m3_primary"
                    android:textSize="13sp" />
            </LinearLayout>

            <SeekBar
                android:id="@+id/sbTargetRise"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:max="180"
                android:progress="80"
                android:layout_marginTop="4dp" />

            <!-- Ambient Temperature Slider -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="14dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Ambient Temperature"
                    android:textSize="13sp"
                    android:textColor="@color/m3_on_surface" />

                <TextView
                    android:id="@+id/tvTempDisplay"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="24°C / 75°F"
                    android:textStyle="bold"
                    android:textColor="@color/m3_primary"
                    android:textSize="13sp" />
            </LinearLayout>

            <SeekBar
                android:id="@+id/sbTemp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:max="20"
                android:progress="9"
                android:layout_marginTop="4dp" />

            <!-- Hydration Slider -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="14dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Dough Hydration"
                    android:textSize="13sp"
                    android:textColor="@color/m3_on_surface" />

                <TextView
                    android:id="@+id/tvHydrationDisplay"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="75% Hydration"
                    android:textStyle="bold"
                    android:textColor="@color/m3_primary"
                    android:textSize="13sp" />
            </LinearLayout>

            <SeekBar
                android:id="@+id/sbHydration"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:max="50"
                android:progress="25"
                android:layout_marginTop="4dp" />

            <!-- Flour Type Button & Alarm Switch -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Flour Profile / Enzymatic Speed"
                android:textSize="12sp"
                android:textColor="@color/m3_on_surface"
                android:layout_marginTop="14dp" />

            <Button
                android:id="@+id/btnFlourType"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="White / Bread Flour (1.0x)"
                android:textColor="@color/m3_on_surface"
                android:background="@drawable/bg_button_secondary"
                android:layout_marginTop="4dp" />

            <Switch
                android:id="@+id/swAlarmAlert"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Acoustic &amp; Haptic Peak Alarm Sentinel"
                android:textColor="@color/m3_on_surface"
                android:textSize="13sp"
                android:checked="true"
                android:layout_marginTop="16dp" />
        </LinearLayout>

        <!-- TELEMETRY ACTIONS -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="16dp">

            <Button
                android:id="@+id/btnLogBatch"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Log Batch Telemetry"
                android:textColor="@color/m3_on_primary"
                android:background="@drawable/bg_button_primary"
                android:layout_marginRight="8dp" />

            <Button
                android:id="@+id/btnShareTelemetry"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Share Report"
                android:textColor="@color/m3_on_surface"
                android:background="@drawable/bg_button_secondary" />
        </LinearLayout>

        <!-- HISTORICAL BATCH LOGS -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp"
            android:background="@drawable/bg_section_card">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="12dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="FERMENTATION FLIGHT RECORDER"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.05"
                    android:textColor="@color/m3_on_surface_variant" />

                <Button
                    android:id="@+id/btnClearHistory"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:minHeight="32dp"
                    android:text="Clear Log"
                    android:textSize="11sp"
                    android:textColor="@color/m3_on_surface_variant"
                    android:background="@drawable/bg_button_secondary" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/llHistoryContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />
        </LinearLayout>

    </LinearLayout>
</ScrollView>