<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root_layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/bg_main"
    android:paddingStart="14dp"
    android:paddingEnd="14dp"
    android:paddingTop="12dp"
    android:paddingBottom="12dp">

    <!-- ── Header Bar ── -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingBottom="8dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tv_app_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/app_name"
                android:textColor="@color/accent_emerald"
                android:textSize="22sp"
                android:textStyle="bold"
                android:letterSpacing="0.02" />

            <TextView
                android:id="@+id/tv_app_subtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/app_subtitle"
                android:textColor="@color/text_mid"
                android:textSize="11sp" />
        </LinearLayout>

        <!-- Working Theme Toggle Pill Button -->
        <Button
            android:id="@+id/btn_theme_toggle"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:minHeight="48dp"
            android:minWidth="84dp"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:background="@drawable/chip_btn"
            android:text="🌓 Auto"
            android:textColor="@color/accent_emerald"
            android:textSize="11sp"
            android:textStyle="bold"
            android:elevation="0dp"
            android:stateListAnimator="@null"
            android:textAllCaps="false" />
    </LinearLayout>

    <!-- ── Warranty Telemetry HUD Card (2-Column Tabular) ── -->
    <LinearLayout
        android:id="@+id/card_hud"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/card_telemetry"
        android:orientation="horizontal"
        android:padding="12dp"
        android:layout_marginBottom="10dp">

        <!-- Active Coverage Telemetry -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="ACTIVE COVERAGE"
                android:textColor="@color/text_muted"
                android:textSize="10sp"
                android:textStyle="bold"
                android:letterSpacing="0.05" />

            <TextView
                android:id="@+id/tv_hud_active_count"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="0 Items"
                android:textColor="@color/text_high"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tv_hud_active_value"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="₱0 Protected"
                android:textColor="@color/accent_emerald"
                android:textSize="11sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Hairline Vertical Divider -->
        <View
            android:layout_width="1dp"
            android:layout_height="match_parent"
            android:background="@drawable/divider_hairline"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="12dp" />

        <!-- Expiring Soon Telemetry -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="EXPIRING (30D)"
                android:textColor="@color/text_muted"
                android:textSize="10sp"
                android:textStyle="bold"
                android:letterSpacing="0.05" />

            <TextView
                android:id="@+id/tv_hud_expiring_count"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="0 Items"
                android:textColor="@color/accent_amber"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tv_hud_expiring_status"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="No urgent claims"
                android:textColor="@color/text_mid"
                android:textSize="11sp" />
        </LinearLayout>
    </LinearLayout>

    <!-- ── Filter Chips Row ── -->
    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:scrollbars="none"
        android:layout_marginBottom="8dp">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <Button
                android:id="@+id/chip_filter_all"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:minHeight="48dp"
                android:minWidth="64dp"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:background="@drawable/chip_filter_active"
                android:text="@string/tab_all"
                android:textColor="#FFFFFF"
                android:textSize="11sp"
                android:textStyle="bold"
                android:elevation="0dp"
                android:stateListAnimator="@null"
                android:textAllCaps="false"
                android:layout_marginEnd="6dp" />

            <Button
                android:id="@+id/chip_filter_active"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:minHeight="48dp"
                android:minWidth="64dp"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:background="@drawable/chip_btn"
                android:text="@string/tab_active"
                android:textColor="@color/text_high"
                android:textSize="11sp"
                android:textStyle="bold"
                android:elevation="0dp"
                android:stateListAnimator="@null"
                android:textAllCaps="false"
                android:layout_marginEnd="6dp" />

            <Button
                android:id="@+id/chip_filter_expiring"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:minHeight="48dp"
                android:minWidth="64dp"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:background="@drawable/chip_btn"
                android:text="@string/tab_expiring"
                android:textColor="@color/text_high"
                android:textSize="11sp"
                android:textStyle="bold"
                android:elevation="0dp"
                android:stateListAnimator="@null"
                android:textAllCaps="false"
                android:layout_marginEnd="6dp" />

            <Button
                android:id="@+id/chip_filter_expired"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:minHeight="48dp"
                android:minWidth="64dp"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:background="@drawable/chip_btn"
                android:text="@string/tab_expired"
                android:textColor="@color/text_high"
                android:textSize="11sp"
                android:textStyle="bold"
                android:elevation="0dp"
                android:stateListAnimator="@null"
                android:textAllCaps="false" />
        </LinearLayout>
    </HorizontalScrollView>

    <!-- ── Search & Primary Action Row ── -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="10dp">

        <EditText
            android:id="@+id/et_search"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:minHeight="48dp"
            android:background="@drawable/edittext_bg"
            android:hint="Search appliance, S/N..."
            android:textColorHint="@color/text_muted"
            android:textColor="@color/text_high"
            android:textSize="13sp"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:singleLine="true"
            android:layout_marginEnd="8dp" />

        <Button
            android:id="@+id/btn_add_warranty"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:minHeight="48dp"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:background="@drawable/btn_action"
            android:text="@string/btn_add_warranty"
            android:textColor="@color/accent_emerald"
            android:textSize="12sp"
            android:textStyle="bold"
            android:elevation="0dp"
            android:stateListAnimator="@null"
            android:textAllCaps="false" />
    </LinearLayout>

    <!-- ── Scrollable Warranty Ledger ── -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:scrollbars="none"
        android:clipToPadding="false"
        android:paddingBottom="72dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="72dp">

            <!-- Container where warranty item cards are dynamically rendered -->
            <LinearLayout
                android:id="@+id/ll_warranties_list"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

            <!-- Empty State View -->
            <LinearLayout
                android:id="@+id/ll_empty_state"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center"
                android:padding="32dp"
                android:visibility="gone">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/empty_title"
                    android:textColor="@color/text_high"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:paddingBottom="6dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/empty_desc"
                    android:textColor="@color/text_mid"
                    android:textSize="12sp"
                    android:gravity="center" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>

    <!-- ── Bottom Action Bar ── -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingTop="6dp">

        <Button
            android:id="@+id/btn_export_json"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:minHeight="48dp"
            android:background="@drawable/btn_tonal_action"
            android:text="@string/btn_export"
            android:textColor="@color/text_mid"
            android:textSize="12sp"
            android:textStyle="bold"
            android:elevation="0dp"
            android:stateListAnimator="@null"
            android:textAllCaps="false" />
    </LinearLayout>
</LinearLayout>
