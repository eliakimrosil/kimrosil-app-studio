<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/bg_primary"
    android:fitsSystemWindows="true">

    <!-- Top Action Bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="12dp"
        android:paddingBottom="12dp"
        android:background="@color/bg_surface">

        <LinearLayout
            android:id="@+id/layoutBrandHeader"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvAppBrand"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/app_name"
                android:textSize="22sp"
                android:textStyle="bold"
                android:textColor="@color/text_primary" />

            <TextView
                android:id="@+id/tvSyncIndicator"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="● Local Storage"
                android:textSize="11sp"
                android:textColor="@color/text_tertiary" />
        </LinearLayout>

        <!-- Google Account Button & Avatar -->
        <FrameLayout
            android:id="@+id/layoutAccountAvatarContainer"
            android:layout_width="44dp"
            android:layout_height="42dp"
            android:layout_marginEnd="6dp">

            <ImageView
                android:id="@+id/ivTopBarAvatar"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_gravity="center"
                android:scaleType="centerCrop"
                android:visibility="gone" />

            <Button
                android:id="@+id/btnAccount"
                android:layout_width="44dp"
                android:layout_height="42dp"
                android:minWidth="44dp"
                android:text="👤"
                android:textSize="16sp"
                android:textColor="@color/text_primary"
                android:background="@drawable/btn_icon" />
        </FrameLayout>

        <!-- Theme Toggle Button -->
        <Button
            android:id="@+id/btnToggleTheme"
            android:layout_width="44dp"
            android:layout_height="42dp"
            android:minWidth="44dp"
            android:text="◐"
            android:textSize="18sp"
            android:textColor="@color/text_primary"
            android:background="@drawable/btn_icon"
            android:layout_marginEnd="6dp" />

        <!-- About Button -->
        <Button
            android:id="@+id/btnAbout"
            android:layout_width="44dp"
            android:layout_height="42dp"
            android:minWidth="44dp"
            android:text="ℹ"
            android:textSize="16sp"
            android:textColor="@color/text_primary"
            android:background="@drawable/btn_icon" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/border_hairline" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- Telemetry 3-Column Card Row -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:background="@drawable/card_surface"
                android:paddingTop="14dp"
                android:paddingBottom="14dp"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:layout_marginBottom="16dp">

                <!-- Column 1: Daily Progress -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tvDailyProgressValue"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0%"
                        android:textSize="22sp"
                        android:textStyle="bold"
                        android:textColor="@color/metric_strength" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/label_daily_progress"
                        android:textSize="11sp"
                        android:textColor="@color/text_secondary"
                        android:gravity="center" />
                </LinearLayout>

                <View
                    android:layout_width="1dp"
                    android:layout_height="36dp"
                    android:layout_gravity="center_vertical"
                    android:background="@color/border_hairline" />

                <!-- Column 2: Active Habits -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tvTotalHabitsValue"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0"
                        android:textSize="22sp"
                        android:textStyle="bold"
                        android:textColor="@color/text_primary" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/label_total_habits"
                        android:textSize="11sp"
                        android:textColor="@color/text_secondary"
                        android:gravity="center" />
                </LinearLayout>

                <View
                    android:layout_width="1dp"
                    android:layout_height="36dp"
                    android:layout_gravity="center_vertical"
                    android:background="@color/border_hairline" />

                <!-- Column 3: Top Streak -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tvTopStreakValue"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0d"
                        android:textSize="22sp"
                        android:textStyle="bold"
                        android:textColor="@color/metric_streak" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/label_best_streak"
                        android:textSize="11sp"
                        android:textColor="@color/text_secondary"
                        android:gravity="center" />
                </LinearLayout>
            </LinearLayout>

            <!-- Horizontal Category Filter Chips -->
            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:scrollbars="none"
                android:layout_marginBottom="16dp">

                <LinearLayout
                    android:id="@+id/chipContainer"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/chipAll"
                        android:layout_width="wrap_content"
                        android:layout_height="38dp"
                        android:minWidth="54dp"
                        android:gravity="center"
                        android:text="@string/cat_all"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:textColor="@color/primary_accent"
                        android:background="@drawable/chip_active"
                        android:paddingStart="14dp"
                        android:paddingEnd="14dp"
                        android:layout_marginEnd="8dp" />

                    <TextView
                        android:id="@+id/chipHealth"
                        android:layout_width="wrap_content"
                        android:layout_height="38dp"
                        android:minWidth="54dp"
                        android:gravity="center"
                        android:text="@string/cat_health"
                        android:textSize="13sp"
                        android:textColor="@color/text_secondary"
                        android:background="@drawable/chip_inactive"
                        android:paddingStart="14dp"
                        android:paddingEnd="14dp"
                        android:layout_marginEnd="8dp" />

                    <TextView
                        android:id="@+id/chipMind"
                        android:layout_width="wrap_content"
                        android:layout_height="38dp"
                        android:minWidth="54dp"
                        android:gravity="center"
                        android:text="@string/cat_mind"
                        android:textSize="13sp"
                        android:textColor="@color/text_secondary"
                        android:background="@drawable/chip_inactive"
                        android:paddingStart="14dp"
                        android:paddingEnd="14dp"
                        android:layout_marginEnd="8dp" />

                    <TextView
                        android:id="@+id/chipBody"
                        android:layout_width="wrap_content"
                        android:layout_height="38dp"
                        android:minWidth="54dp"
                        android:gravity="center"
                        android:text="@string/cat_body"
                        android:textSize="13sp"
                        android:textColor="@color/text_secondary"
                        android:background="@drawable/chip_inactive"
                        android:paddingStart="14dp"
                        android:paddingEnd="14dp"
                        android:layout_marginEnd="8dp" />

                    <TextView
                        android:id="@+id/chipCraft"
                        android:layout_width="wrap_content"
                        android:layout_height="38dp"
                        android:minWidth="54dp"
                        android:gravity="center"
                        android:text="@string/cat_craft"
                        android:textSize="13sp"
                        android:textColor="@color/text_secondary"
                        android:background="@drawable/chip_inactive"
                        android:paddingStart="14dp"
                        android:paddingEnd="14dp"
                        android:layout_marginEnd="8dp" />

                    <TextView
                        android:id="@+id/chipFocus"
                        android:layout_width="wrap_content"
                        android:layout_height="38dp"
                        android:minWidth="54dp"
                        android:gravity="center"
                        android:text="@string/cat_focus"
                        android:textSize="13sp"
                        android:textColor="@color/text_secondary"
                        android:background="@drawable/chip_inactive"
                        android:paddingStart="14dp"
                        android:paddingEnd="14dp" />
                </LinearLayout>
            </HorizontalScrollView>

            <!-- Habit List / Empty State Container -->
            <LinearLayout
                android:id="@+id/layoutEmptyState"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center"
                android:padding="32dp"
                android:visibility="gone"
                android:background="@drawable/card_surface">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🌱"
                    android:textSize="44sp"
                    android:layout_marginBottom="12dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="No habits tracked yet"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="@color/text_primary"
                    android:layout_marginBottom="6dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Tap '+ New Habit' below to create your first daily routine and build your habit strength."
                    android:textSize="13sp"
                    android:textColor="@color/text_secondary"
                    android:gravity="center"
                    android:lineSpacingExtra="3dp" />
            </LinearLayout>

            <!-- Dynamic Habit Container (Inflated Programmatically or ListView) -->
            <LinearLayout
                android:id="@+id/habitListContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

        </LinearLayout>
    </ScrollView>

    <!-- Bottom Add Habit Button Bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="10dp"
        android:paddingBottom="14dp"
        android:background="@color/bg_surface">

        <Button
            android:id="@+id/btnAddNewHabit"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:text="+ New Habit"
            android:textSize="15sp"
            android:textStyle="bold"
            android:textColor="@color/text_on_accent"
            android:background="@drawable/btn_primary" />
    </LinearLayout>

</LinearLayout>
