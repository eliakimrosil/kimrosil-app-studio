<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/m3_surface"
    android:orientation="vertical">

    <!-- TOP BAR HUD HEADER -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/m3_surface_container"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="16dp"
        android:paddingVertical="10dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="KerfNotch"
                android:textColor="@color/m3_on_surface"
                android:textSize="20sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Precision Dado &amp; Box Joint Telemetry"
                android:textColor="@color/m3_on_surface_variant"
                android:textSize="11sp" />
        </LinearLayout>

        <Button
            android:id="@+id/btnUnitToggle"
            android:layout_width="wrap_content"
            android:layout_height="38dp"
            android:layout_marginEnd="6dp"
            android:background="@drawable/btn_m3_tonal"
            android:minWidth="64dp"
            android:paddingHorizontal="10dp"
            android:text="Frac In"
            android:textAllCaps="false"
            android:textColor="@color/m3_on_surface"
            android:textSize="12sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnSavedPresets"
            android:layout_width="wrap_content"
            android:layout_height="38dp"
            android:layout_marginEnd="6dp"
            android:background="@drawable/btn_m3_tonal"
            android:minWidth="60dp"
            android:paddingHorizontal="10dp"
            android:text="Presets"
            android:textAllCaps="false"
            android:textColor="@color/m3_on_surface"
            android:textSize="12sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnThemeToggle"
            android:layout_width="wrap_content"
            android:layout_height="38dp"
            android:background="@drawable/btn_m3_tonal"
            android:minWidth="54dp"
            android:paddingHorizontal="8dp"
            android:text="Auto"
            android:textAllCaps="false"
            android:textColor="@color/m3_on_surface"
            android:textSize="12sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- MAIN SCROLLABLE WORKBENCH -->
    <ScrollView
        android:id="@+id/scrollContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="false"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- SAFETY HAZARD BANNER -->
            <TextView
                android:id="@+id/tvWarningBanner"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:background="@drawable/card_m3_high"
                android:padding="12dp"
                android:textColor="@color/m3_error"
                android:textSize="13sp"
                android:textStyle="bold"
                android:visibility="gone" />

            <!-- HERO VISUAL: CUSTOM INTERACTIVE CANVASES -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="14dp"
                android:background="@drawable/card_m3"
                android:orientation="vertical"
                android:padding="12dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="6dp"
                    android:text="ARBOR CROSS-SECTION &amp; CUT TELEMETRY"
                    android:textColor="@color/m3_primary"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <com.kimrosil.kerfnotch.DadoJointPreviewView
                    android:id="@+id/dadoPreviewView"
                    android:layout_width="match_parent"
                    android:layout_height="210dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginTop="6dp"
                    android:text="Tap any blade/shim or pinch to inspect slice thickness"
                    android:textColor="@color/m3_on_surface_variant"
                    android:textSize="11sp" />
            </LinearLayout>

            <!-- MODE SELECTOR SEGMENTED ROW -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="14dp"
                android:background="@drawable/card_m3_high"
                android:orientation="horizontal"
                android:padding="4dp">

                <Button
                    android:id="@+id/btnModeDado"
                    android:layout_width="0dp"
                    android:layout_height="42dp"
                    android:layout_weight="1"
                    android:background="@drawable/chip_active"
                    android:text="Dado Stack &amp; Shims"
                    android:textAllCaps="false"
                    android:textColor="@color/m3_on_primary"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <Button
                    android:id="@+id/btnModeBoxJoint"
                    android:layout_width="0dp"
                    android:layout_height="42dp"
                    android:layout_weight="1"
                    android:background="@drawable/chip_inactive"
                    android:text="Box Joint Fingers"
                    android:textAllCaps="false"
                    android:textColor="@color/m3_on_surface"
                    android:textSize="13sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- DADO CONTROLS DECK -->
            <LinearLayout
                android:id="@+id/layoutDadoControls"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <!-- QUICK PLYWOOD CHIP ROW -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="6dp"
                    android:text="Quick-Start Nominal Plywood Sizes"
                    android:textColor="@color/m3_on_surface_variant"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <HorizontalScrollView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="14dp"
                    android:scrollbars="none">

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <Button
                            android:id="@+id/chipPly14"
                            android:layout_width="wrap_content"
                            android:layout_height="38dp"
                            android:layout_marginEnd="8dp"
                            android:background="@drawable/btn_m3_tonal"
                            android:paddingHorizontal="14dp"
                            android:text="1/4&quot; (0.250)"
                            android:textAllCaps="false"
                            android:textColor="@color/m3_on_surface"
                            android:textSize="12sp" />

                        <Button
                            android:id="@+id/chipPly12"
                            android:layout_width="wrap_content"
                            android:layout_height="38dp"
                            android:layout_marginEnd="8dp"
                            android:background="@drawable/btn_m3_tonal"
                            android:paddingHorizontal="14dp"
                            android:text="15/32&quot; (1/2&quot; Ply)"
                            android:textAllCaps="false"
                            android:textColor="@color/m3_on_surface"
                            android:textSize="12sp" />

                        <Button
                            android:id="@+id/chipPly2332"
                            android:layout_width="wrap_content"
                            android:layout_height="38dp"
                            android:layout_marginEnd="8dp"
                            android:background="@drawable/btn_m3_tonal"
                            android:paddingHorizontal="14dp"
                            android:text="23/32&quot; (3/4&quot; Ply)"
                            android:textAllCaps="false"
                            android:textColor="@color/m3_on_surface"
                            android:textSize="12sp" />

                        <Button
                            android:id="@+id/chipPly34"
                            android:layout_width="wrap_content"
                            android:layout_height="38dp"
                            android:background="@drawable/btn_m3_tonal"
                            android:paddingHorizontal="14dp"
                            android:text="3/4&quot; Hardwood"
                            android:textAllCaps="false"
                            android:textColor="@color/m3_on_surface"
                            android:textSize="12sp" />
                    </LinearLayout>
                </HorizontalScrollView>

                <!-- TARGET KERF STEPPER CARD -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="14dp"
                    android:background="@drawable/card_m3"
                    android:orientation="vertical"
                    android:padding="14dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="TARGET CUT WIDTH (GROOVE / DADO)"
                        android:textColor="@color/m3_primary"
                        android:textSize="11sp"
                        android:textStyle="bold" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <Button
                            android:id="@+id/btnDecTarget"
                            android:layout_width="48dp"
                            android:layout_height="48dp"
                            android:background="@drawable/btn_stepper"
                            android:text="−"
                            android:textColor="@color/m3_on_surface"
                            android:textSize="22sp" />

                        <EditText
                            android:id="@+id/etTargetKerf"
                            android:layout_width="0dp"
                            android:layout_height="48dp"
                            android:layout_marginHorizontal="8dp"
                            android:layout_weight="1"
                            android:background="@drawable/edittext_m3"
                            android:gravity="center"
                            android:imeOptions="actionDone"
                            android:inputType="numberDecimal"
                            android:paddingHorizontal="8dp"
                            android:selectAllOnFocus="true"
                            android:textColor="@color/m3_on_surface"
                            android:textSize="20sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tvTargetKerfUnit"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="8dp"
                            android:text="in"
                            android:textColor="@color/m3_on_surface_variant"
                            android:textSize="14sp"
                            android:textStyle="bold" />

                        <Button
                            android:id="@+id/btnIncTarget"
                            android:layout_width="48dp"
                            android:layout_height="48dp"
                            android:background="@drawable/btn_stepper"
                            android:text="+"
                            android:textColor="@color/m3_on_surface"
                            android:textSize="22sp" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>

            <!-- BOX JOINT CONTROLS DECK -->
            <LinearLayout
                android:id="@+id/layoutBoxJointControls"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <!-- WORKPIECE BOARD WIDTH STEPPER -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    android:background="@drawable/card_m3"
                    android:orientation="vertical"
                    android:padding="14dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="WORKPIECE / BOARD WIDTH"
                        android:textColor="@color/m3_primary"
                        android:textSize="11sp"
                        android:textStyle="bold" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <Button
                            android:id="@+id/btnDecBoard"
                            android:layout_width="48dp"
                            android:layout_height="48dp"
                            android:background="@drawable/btn_stepper"
                            android:text="−"
                            android:textColor="@color/m3_on_surface"
                            android:textSize="22sp" />

                        <EditText
                            android:id="@+id/etBoardWidth"
                            android:layout_width="0dp"
                            android:layout_height="48dp"
                            android:layout_marginHorizontal="8dp"
                            android:layout_weight="1"
                            android:background="@drawable/edittext_m3"
                            android:gravity="center"
                            android:imeOptions="actionDone"
                            android:inputType="numberDecimal"
                            android:paddingHorizontal="8dp"
                            android:selectAllOnFocus="true"
                            android:textColor="@color/m3_on_surface"
                            android:textSize="20sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tvBoardWidthUnit"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="8dp"
                            android:text="in"
                            android:textColor="@color/m3_on_surface_variant"
                            android:textSize="14sp"
                            android:textStyle="bold" />

                        <Button
                            android:id="@+id/btnIncBoard"
                            android:layout_width="48dp"
                            android:layout_height="48dp"
                            android:background="@drawable/btn_stepper"
                            android:text="+"
                            android:textColor="@color/m3_on_surface"
                            android:textSize="22sp" />
                    </LinearLayout>
                </LinearLayout>

                <!-- BLADE KERF STEPPER -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="14dp"
                    android:background="@drawable/card_m3"
                    android:orientation="vertical"
                    android:padding="14dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="SAW BLADE / DADO SINGLE PASS KERF"
                        android:textColor="@color/m3_primary"
                        android:textSize="11sp"
                        android:textStyle="bold" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <Button
                            android:id="@+id/btnDecBlade"
                            android:layout_width="48dp"
                            android:layout_height="48dp"
                            android:background="@drawable/btn_stepper"
                            android:text="−"
                            android:textColor="@color/m3_on_surface"
                            android:textSize="22sp" />

                        <EditText
                            android:id="@+id/etBladeKerf"
                            android:layout_width="0dp"
                            android:layout_height="48dp"
                            android:layout_marginHorizontal="8dp"
                            android:layout_weight="1"
                            android:background="@drawable/edittext_m3"
                            android:gravity="center"
                            android:imeOptions="actionDone"
                            android:inputType="numberDecimal"
                            android:paddingHorizontal="8dp"
                            android:selectAllOnFocus="true"
                            android:textColor="@color/m3_on_surface"
                            android:textSize="20sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tvBladeKerfUnit"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="8dp"
                            android:text="in"
                            android:textColor="@color/m3_on_surface_variant"
                            android:textSize="14sp"
                            android:textStyle="bold" />

                        <Button
                            android:id="@+id/btnIncBlade"
                            android:layout_width="48dp"
                            android:layout_height="48dp"
                            android:background="@drawable/btn_stepper"
                            android:text="+"
                            android:textColor="@color/m3_on_surface"
                            android:textSize="22sp" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>

            <!-- ACTION BUTTON ROW -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btnCalculate"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_marginEnd="8dp"
                    android:layout_weight="1"
                    android:background="@drawable/btn_m3_primary"
                    android:text="Calculate &amp; Optimize"
                    android:textAllCaps="false"
                    android:textColor="@color/m3_on_primary"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <Button
                    android:id="@+id/btnSavePreset"
                    android:layout_width="wrap_content"
                    android:layout_height="48dp"
                    android:layout_marginEnd="6dp"
                    android:background="@drawable/btn_m3_tonal"
                    android:paddingHorizontal="14dp"
                    android:text="Save"
                    android:textAllCaps="false"
                    android:textColor="@color/m3_on_surface"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <Button
                    android:id="@+id/btnShareSetup"
                    android:layout_width="wrap_content"
                    android:layout_height="48dp"
                    android:background="@drawable/btn_m3_tonal"
                    android:paddingHorizontal="14dp"
                    android:text="Share"
                    android:textAllCaps="false"
                    android:textColor="@color/m3_on_surface"
                    android:textSize="13sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- DADO RESULT TELEMETRY CARD -->
            <LinearLayout
                android:id="@+id/cardDadoResults"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/card_m3"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="EXACT STACK RECIPE &amp; TOLERANCE"
                    android:textColor="@color/m3_primary"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <!-- TWO COLUMN TABULAR TELEMETRY -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:orientation="horizontal">

                    <!-- Col 1: Total Kerf Stack -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="8dp"
                        android:layout_weight="1"
                        android:background="@drawable/card_m3_high"
                        android:orientation="vertical"
                        android:padding="12dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="STACK THICKNESS"
                            android:textColor="@color/m3_on_surface_variant"
                            android:textSize="10sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tvPrimaryTargetReadout"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:text="23/32&quot;"
                            android:textColor="@color/m3_on_surface"
                            android:textSize="20sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tvSecondaryTargetReadout"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="0.7188&quot; (18.257 mm)"
                            android:textColor="@color/m3_on_surface_variant"
                            android:textSize="11sp" />
                    </LinearLayout>

                    <!-- Col 2: Fit Tolerance / Error -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:layout_weight="1"
                        android:background="@drawable/card_m3_high"
                        android:orientation="vertical"
                        android:padding="12dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="FIT DEVIATION"
                            android:textColor="@color/m3_on_surface_variant"
                            android:textSize="10sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tvPrimaryDeviationReadout"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:text="+0.0000&quot;"
                            android:textColor="@color/m3_success"
                            android:textSize="20sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tvSecondaryDeviationReadout"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="+0.000 mm"
                            android:textColor="@color/m3_on_surface_variant"
                            android:textSize="11sp" />
                    </LinearLayout>
                </LinearLayout>

                <!-- OUTER BLADES NOTE -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:text="OUTER BLADES: 2x 1/8&quot; (Left &amp; Right Carbide Face Blades)"
                    android:textColor="@color/m3_on_surface"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <!-- CHIPPERS BREAKDOWN -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="INTERIOR CHIPPERS:"
                    android:textColor="@color/m3_on_surface_variant"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvChipperSummaryReadout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:background="@drawable/card_m3_high"
                    android:padding="10dp"
                    android:text="3x 1/8&quot; Chippers + 1x 1/16&quot; Chipper"
                    android:textColor="@color/m3_on_surface"
                    android:textSize="13sp" />

                <!-- FINE SHIM PACK RECIPE -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="COLOR-CODED FINE SHIMS:"
                    android:textColor="@color/m3_on_surface_variant"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <LinearLayout
                    android:id="@+id/llShimBreakdownContainer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:orientation="vertical" />
            </LinearLayout>

            <!-- BOX JOINT RESULT TELEMETRY CARD -->
            <LinearLayout
                android:id="@+id/cardBoxJointResults"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/card_m3"
                android:orientation="vertical"
                android:padding="16dp"
                android:visibility="gone">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="BOX JOINT INTERLOCKING SPECIFICATION"
                    android:textColor="@color/m3_primary"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:orientation="horizontal">

                    <!-- Pins -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="6dp"
                        android:layout_weight="1"
                        android:background="@drawable/card_m3_high"
                        android:orientation="vertical"
                        android:padding="10dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="PINS (MALE)"
                            android:textColor="@color/m3_on_surface_variant"
                            android:textSize="10sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tvBoxJointPinsReadout"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:text="11"
                            android:textColor="@color/m3_on_surface"
                            android:textSize="20sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <!-- Sockets -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:layout_weight="1"
                        android:background="@drawable/card_m3_high"
                        android:orientation="vertical"
                        android:padding="10dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="SOCKETS (FEM)"
                            android:textColor="@color/m3_on_surface_variant"
                            android:textSize="10sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tvBoxJointSocketsReadout"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:text="10"
                            android:textColor="@color/m3_on_surface"
                            android:textSize="20sp"
                            android:textStyle="bold" />
                    </LinearLayout>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:background="@drawable/card_m3_high"
                    android:orientation="vertical"
                    android:padding="12dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="FINGER WIDTH / NOTCH"
                        android:textColor="@color/m3_on_surface_variant"
                        android:textSize="10sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvBoxJointFingerWidthReadout"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="1/4&quot; (0.250 in)"
                        android:textColor="@color/m3_on_surface"
                        android:textSize="18sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <!-- Pass count & Step Off -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="6dp"
                        android:layout_weight="1"
                        android:background="@drawable/card_m3_high"
                        android:orientation="vertical"
                        android:padding="10dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="CUT PASSES"
                            android:textColor="@color/m3_on_surface_variant"
                            android:textSize="10sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tvBoxJointPassesReadout"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="2 passes"
                            android:textColor="@color/m3_on_surface"
                            android:textSize="15sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:layout_weight="1"
                        android:background="@drawable/card_m3_high"
                        android:orientation="vertical"
                        android:padding="10dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="STEP-OFF INDEX"
                            android:textColor="@color/m3_on_surface_variant"
                            android:textSize="10sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tvBoxJointStepOffReadout"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="1/2&quot; (0.500 in)"
                            android:textColor="@color/m3_on_surface"
                            android:textSize="15sp"
                            android:textStyle="bold" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>

        </LinearLayout>
    </ScrollView>

</LinearLayout>