<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/stageRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/stage_bg">

    <FrameLayout
        android:id="@+id/mirrorLayer"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <com.kimrosil.cuescroll.PrompterScrollView
            android:id="@+id/scroll"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:overScrollMode="never"
            android:scrollbars="none">

            <TextView
                android:id="@+id/tvScript"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-medium"
                android:lineSpacingMultiplier="1.2"
                android:textColor="@color/stage_text"
                android:textSize="40sp" />
        </com.kimrosil.cuescroll.PrompterScrollView>
    </FrameLayout>

    <View
        android:id="@+id/readBand"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:background="@drawable/stage_band" />

    <ImageView
        android:id="@+id/markerLeft"
        android:layout_width="18dp"
        android:layout_height="26dp"
        android:layout_gravity="start|top"
        android:importantForAccessibility="no"
        android:src="@drawable/ic_marker_left" />

    <ImageView
        android:id="@+id/markerRight"
        android:layout_width="18dp"
        android:layout_height="26dp"
        android:layout_gravity="end|top"
        android:importantForAccessibility="no"
        android:src="@drawable/ic_marker_right" />

    <ProgressBar
        android:id="@+id/progress"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="3dp"
        android:layout_gravity="top"
        android:max="1000"
        android:progressDrawable="@drawable/progress_stage" />

    <LinearLayout
        android:id="@+id/topBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:layout_margin="10dp"
        android:background="@drawable/stage_panel_bg"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="6dp">

        <ImageButton
            android:id="@+id/btnBack"
            style="@style/StageIconButton"
            android:contentDescription="@string/back"
            android:src="@drawable/ic_back"
            android:tint="@color/stage_text" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="8dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:fontFamily="monospace"
                android:maxLines="1"
                android:textColor="@color/stage_text"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:background="@drawable/badge_idle"
                android:drawablePadding="6dp"
                android:fontFamily="monospace"
                android:letterSpacing="0.14"
                android:paddingStart="8dp"
                android:paddingTop="3dp"
                android:paddingEnd="10dp"
                android:paddingBottom="3dp"
                android:textColor="@color/stage_text"
                android:textSize="11sp"
                android:textStyle="bold" />
        </LinearLayout>

        <ImageButton
            android:id="@+id/btnEdit"
            style="@style/StageIconButton"
            android:contentDescription="@string/edit"
            android:src="@drawable/ic_edit"
            android:tint="@color/stage_text" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/controlPanel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_margin="10dp"
        android:background="@drawable/stage_panel_bg"
        android:orientation="vertical"
        android:padding="10dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvWpm"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="monospace"
                    android:textColor="@color/stage_text"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="monospace"
                    android:letterSpacing="0.12"
                    android:text="PACE WPM"
                    android:textColor="@color/stage_label"
                    android:textSize="10sp" />
            </LinearLayout>

            <View
                android:layout_width="1dp"
                android:layout_height="30dp"
                android:layout_gravity="center_vertical"
                android:background="@color/stage_outline" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvRemain"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="monospace"
                    android:textColor="@color/stage_amber"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="monospace"
                    android:letterSpacing="0.12"
                    android:text="REMAINING"
                    android:textColor="@color/stage_label"
                    android:textSize="10sp" />
            </LinearLayout>

            <View
                android:layout_width="1dp"
                android:layout_height="30dp"
                android:layout_gravity="center_vertical"
                android:background="@color/stage_outline" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvElapsed"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="monospace"
                    android:textColor="@color/stage_text"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="monospace"
                    android:letterSpacing="0.12"
                    android:text="ELAPSED"
                    android:textColor="@color/stage_label"
                    android:textSize="10sp" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="@drawable/stage_chip"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="3dp">

                <ImageButton
                    android:id="@+id/btnSpeedDown"
                    style="@style/StageIconButton"
                    android:contentDescription="Slower"
                    android:src="@drawable/ic_minus"
                    android:tint="@color/stage_text" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tvSpeed"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="monospace"
                        android:textColor="@color/stage_text"
                        android:textSize="18sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="monospace"
                        android:letterSpacing="0.12"
                        android:text="SPEED"
                        android:textColor="@color/stage_label"
                        android:textSize="10sp" />
                </LinearLayout>

                <ImageButton
                    android:id="@+id/btnSpeedUp"
                    style="@style/StageIconButton"
                    android:contentDescription="Faster"
                    android:src="@drawable/ic_plus"
                    android:tint="@color/stage_text" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:background="@drawable/stage_chip"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="3dp">

                <ImageButton
                    android:id="@+id/btnSizeDown"
                    style="@style/StageIconButton"
                    android:contentDescription="Smaller text"
                    android:src="@drawable/ic_minus"
                    android:tint="@color/stage_text" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tvSize"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="monospace"
                        android:textColor="@color/stage_text"
                        android:textSize="18sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="monospace"
                        android:letterSpacing="0.12"
                        android:text="SIZE"
                        android:textColor="@color/stage_label"
                        android:textSize="10sp" />
                </LinearLayout>

                <ImageButton
                    android:id="@+id/btnSizeUp"
                    style="@style/StageIconButton"
                    android:contentDescription="Larger text"
                    android:src="@drawable/ic_plus"
                    android:tint="@color/stage_text" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageButton
                android:id="@+id/btnRestart"
                style="@style/StageIconButton"
                android:contentDescription="@string/restart"
                android:src="@drawable/ic_restart"
                android:tint="@color/stage_text" />

            <ImageButton
                android:id="@+id/btnMirror"
                style="@style/StageIconButton"
                android:layout_marginStart="8dp"
                android:contentDescription="@string/mirror"
                android:src="@drawable/ic_mirror"
                android:tint="@color/stage_text" />

            <ImageButton
                android:id="@+id/btnColor"
                style="@style/StageIconButton"
                android:layout_marginStart="8dp"
                android:contentDescription="Text colour"
                android:src="@drawable/ic_palette"
                android:tint="@color/stage_text" />

            <TextView
                android:id="@+id/btnPlay"
                style="@style/CueButtonText"
                android:layout_width="0dp"
                android:layout_height="52dp"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:background="@drawable/btn_stage_play"
                android:clickable="true"
                android:drawableStart="@drawable/ic_play"
                android:drawablePadding="8dp"
                android:drawableTint="@color/on_ruby"
                android:focusable="true"
                android:paddingStart="16dp"
                android:paddingEnd="26dp"
                android:text="@string/play"
                android:textColor="@color/on_ruby"
                android:textSize="16sp" />
        </LinearLayout>
    </LinearLayout>

    <TextView
        android:id="@+id/tvCountdown"
        android:layout_width="160dp"
        android:layout_height="160dp"
        android:layout_gravity="center"
        android:background="@drawable/countdown_bg"
        android:fontFamily="monospace"
        android:gravity="center"
        android:textColor="@color/stage_amber"
        android:textSize="88sp"
        android:textStyle="bold"
        android:visibility="gone" />
</FrameLayout>
