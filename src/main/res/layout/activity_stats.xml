<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/m3_surface"
    android:fitsSystemWindows="true">

    <!-- Top App Bar / Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="16dp"
        android:background="@color/m3_surface_container">

        <Button
            android:id="@+id/btnBack"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:text="←"
            android:textSize="20sp"
            android:textColor="@color/m3_on_surface"
            android:background="?android:attr/selectableItemBackgroundBorderless" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Sanctuary Ledger"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="@color/m3_on_surface" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Mindfulness &amp; Contemplation Stats"
                android:textSize="12sp"
                android:textColor="@color/m3_on_surface_variant" />
        </LinearLayout>

        <Button
            android:id="@+id/btnShareStats"
            android:layout_width="wrap_content"
            android:layout_height="38dp"
            android:text="Share"
            android:textSize="13sp"
            android:textColor="@color/m3_on_primary"
            android:background="@drawable/btn_m3_primary"
            android:paddingHorizontal="14dp" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:padding="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Stats Metric Cards Grid -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="12dp">

                <!-- Mindful Minutes Card -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginEnd="6dp"
                    android:padding="14dp"
                    android:background="@drawable/card_m3"
                    android:orientation="vertical"
                    android:gravity="center">

                    <TextView
                        android:id="@+id/tvStatMinutes"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0"
                        android:textSize="26sp"
                        android:textStyle="bold"
                        android:textColor="@color/m3_primary" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Mindful Minutes"
                        android:textSize="12sp"
                        android:textColor="@color/m3_on_surface_variant" />
                </LinearLayout>

                <!-- Sessions Card -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="6dp"
                    android:padding="14dp"
                    android:background="@drawable/card_m3"
                    android:orientation="vertical"
                    android:gravity="center">

                    <TextView
                        android:id="@+id/tvStatSessions"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0"
                        android:textSize="26sp"
                        android:textStyle="bold"
                        android:textColor="@color/m3_primary" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Zen Sessions"
                        android:textSize="12sp"
                        android:textColor="@color/m3_on_surface_variant" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="16dp">

                <!-- Pebbles Dropped Card -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginEnd="6dp"
                    android:padding="14dp"
                    android:background="@drawable/card_m3"
                    android:orientation="vertical"
                    android:gravity="center">

                    <TextView
                        android:id="@+id/tvStatPebbles"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0"
                        android:textSize="24sp"
                        android:textStyle="bold"
                        android:textColor="@color/m3_primary" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Pebbles Dropped"
                        android:textSize="12sp"
                        android:textColor="@color/m3_on_surface_variant" />
                </LinearLayout>

                <!-- Cairns Balanced Card -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="6dp"
                    android:padding="14dp"
                    android:background="@drawable/card_m3"
                    android:orientation="vertical"
                    android:gravity="center">

                    <TextView
                        android:id="@+id/tvStatCairns"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0"
                        android:textSize="24sp"
                        android:textStyle="bold"
                        android:textColor="@color/m3_primary" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Cairns Balanced"
                        android:textSize="12sp"
                        android:textColor="@color/m3_on_surface_variant" />
                </LinearLayout>
            </LinearLayout>

            <!-- Aphorisms Header -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Collected Zen Aphorisms"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="@color/m3_on_surface"
                android:layout_marginBottom="8dp" />

            <!-- Container for Unlocked Quotes -->
            <LinearLayout
                android:id="@+id/llAphorismsContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginBottom="24dp" />

            <!-- Privacy & Offline Guarantee -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="100% Offline Sanctuary • Zero Trackers • Pure Native Craft"
                android:textSize="11sp"
                android:gravity="center"
                android:textColor="@color/m3_on_surface_variant"
                android:layout_marginBottom="16dp" />

        </LinearLayout>
    </ScrollView>
</LinearLayout>
