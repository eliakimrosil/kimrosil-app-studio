<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/card_surface"
    android:padding="20dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/title_firebase_config"
        android:textSize="18sp"
        android:textStyle="bold"
        android:textColor="@color/text_primary"
        android:layout_marginBottom="6dp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/desc_firebase_config"
        android:textSize="12sp"
        android:textColor="@color/text_secondary"
        android:lineSpacingExtra="2dp"
        android:layout_marginBottom="14dp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="FIREBASE PROJECT ID"
        android:textSize="11sp"
        android:textStyle="bold"
        android:textColor="@color/text_tertiary"
        android:layout_marginBottom="4dp" />

    <EditText
        android:id="@+id/etFirebaseProjectId"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:hint="@string/hint_firebase_project_id"
        android:textSize="13sp"
        android:textColor="@color/text_primary"
        android:textColorHint="@color/text_tertiary"
        android:background="@drawable/edittext_bg"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:inputType="textUri"
        android:maxLines="1"
        android:layout_marginBottom="12dp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="FIREBASE WEB API KEY"
        android:textSize="11sp"
        android:textStyle="bold"
        android:textColor="@color/text_tertiary"
        android:layout_marginBottom="4dp" />

    <EditText
        android:id="@+id/etFirebaseApiKey"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:hint="@string/hint_firebase_api_key"
        android:textSize="13sp"
        android:textColor="@color/text_primary"
        android:textColorHint="@color/text_tertiary"
        android:background="@drawable/edittext_bg"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:inputType="textPassword"
        android:maxLines="1"
        android:layout_marginBottom="12dp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="GOOGLE WEB CLIENT ID"
        android:textSize="11sp"
        android:textStyle="bold"
        android:textColor="@color/text_tertiary"
        android:layout_marginBottom="4dp" />

    <EditText
        android:id="@+id/etGoogleClientId"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:hint="@string/hint_google_client_id"
        android:textSize="13sp"
        android:textColor="@color/text_primary"
        android:textColorHint="@color/text_tertiary"
        android:background="@drawable/edittext_bg"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:inputType="textUri"
        android:maxLines="1"
        android:layout_marginBottom="20dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="end">

        <Button
            android:id="@+id/btnCancelFirebaseConfig"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:minWidth="80dp"
            android:text="@string/action_cancel"
            android:textSize="14sp"
            android:textColor="@color/text_secondary"
            android:background="@drawable/btn_secondary"
            android:layout_marginEnd="10dp" />

        <Button
            android:id="@+id/btnSaveFirebaseConfig"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:minWidth="100dp"
            android:text="Save Config"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="@color/text_on_accent"
            android:background="@drawable/btn_primary" />
    </LinearLayout>

</LinearLayout>
