<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/dialog_background"
    android:orientation="vertical">

    <!-- Modal Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingBottom="12dp">

        <ImageView
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/ic_dumbbell" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvManageRoutineTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-black"
                android:letterSpacing="0.04"
                android:text="MANAGE PUSH ROUTINE"
                android:textColor="@color/m3_on_surface"
                android:textSize="17sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-medium"
                android:text="Reorder, edit sets/reps, add or remove exercises"
                android:textColor="@color/m3_on_surface_variant"
                android:textSize="11sp" />
        </LinearLayout>
    </LinearLayout>

    <!-- Scrollable Exercise List -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:maxHeight="420dp"
        android:scrollbars="none">

        <LinearLayout
            android:id="@+id/llManageExerciseList"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingTop="4dp"
            android:paddingBottom="6dp" />
    </ScrollView>

    <!-- Bottom Actions -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:orientation="vertical">

        <!-- Add Exercise Button -->
        <Button
            android:id="@+id/btnAddExerciseFromManage"
            style="?android:attr/borderlessButtonStyle"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:background="@drawable/btn_action"
            android:fontFamily="sans-serif-black"
            android:letterSpacing="0.04"
            android:minHeight="48dp"
            android:stateListAnimator="@animator/btn_press_scale"
            android:text="+ ADD NEW EXERCISE"
            android:textColor="@color/m3_on_primary"
            android:textSize="13sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnResetSplitDefaults"
                style="?android:attr/borderlessButtonStyle"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_marginEnd="6dp"
                android:layout_weight="1"
                android:background="@drawable/bg_topbar_button"
                android:fontFamily="sans-serif-bold"
                android:minHeight="48dp"
                android:stateListAnimator="@animator/btn_press_scale"
                android:text="Reset Defaults"
                android:textColor="@color/m3_tertiary"
                android:textSize="12sp" />

            <Button
                android:id="@+id/btnCloseManageRoutine"
                style="?android:attr/borderlessButtonStyle"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:background="@drawable/bg_topbar_button"
                android:fontFamily="sans-serif-black"
                android:minHeight="48dp"
                android:stateListAnimator="@animator/btn_press_scale"
                android:text="DONE"
                android:textColor="@color/m3_on_surface"
                android:textSize="12sp" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
