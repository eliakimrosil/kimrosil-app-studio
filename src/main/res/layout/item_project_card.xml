<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="8dp"
    android:background="@color/m3_surface_container"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="12dp">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvCardProjectName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Door Name"
            android:textColor="@color/m3_on_surface"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvCardProjectDetails"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="Shim: +1.20 mm | Deflection: 3.0 mm"
            android:textColor="@color/m3_on_surface_variant"
            android:textSize="12sp" />
    </LinearLayout>

    <Button
        android:id="@+id/btnCardOpen"
        style="?android:attr/buttonStyleSmall"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Inspect" />
</LinearLayout>