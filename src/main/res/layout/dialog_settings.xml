<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/bg_card"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Title -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Settings &amp; EIA Standards"
            android:textColor="@color/text_primary"
            android:textSize="18sp"
            android:textStyle="bold"
            android:layout_marginBottom="12dp" />

        <!-- Theme Selection Card -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Appearance Theme"
            android:textColor="@color/text_secondary"
            android:textSize="12sp"
            android:textStyle="bold"
            android:layout_marginBottom="6dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="16dp">

            <Button
                android:id="@+id/btnThemeDark"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:background="@drawable/bg_btn_secondary"
                android:text="Dark"
                android:textColor="@color/text_primary"
                android:textSize="12sp"
                android:contentDescription="Select dark workbench theme" />

            <Space
                android:layout_width="6dp"
                android:layout_height="match_parent" />

            <Button
                android:id="@+id/btnThemeLight"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:background="@drawable/bg_btn_secondary"
                android:text="Light"
                android:textColor="@color/text_primary"
                android:textSize="12sp"
                android:contentDescription="Select light blueprint theme" />

            <Space
                android:layout_width="6dp"
                android:layout_height="match_parent" />

            <Button
                android:id="@+id/btnThemeAuto"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:background="@drawable/bg_btn_secondary"
                android:text="Auto"
                android:textColor="@color/text_primary"
                android:textSize="12sp"
                android:contentDescription="Follow system appearance theme" />
        </LinearLayout>

        <!-- EIA Standard Decade Series Card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_card_elevated"
            android:orientation="vertical"
            android:padding="10dp"
            android:layout_marginBottom="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="EIA Standard Preferred Values Reference"
                android:textColor="@color/text_primary"
                android:textSize="12sp"
                android:textStyle="bold"
                android:layout_marginBottom="4dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="• E12 Series (±10%): 10, 12, 15, 18, 22, 27, 33, 39, 47, 56, 68, 82\n\n• E24 Series (±5%): Includes E12 plus 11, 13, 16, 20, 24, 30, 36, 43, 51, 62, 75, 91\n\n• E96 Series (±1%): 96 decade values calculated via 10^(n/96) spanning 100 to 976 for precision film resistors.\n\n• SMD Codes: 3-digit (AB × 10^C), 4-digit (ABC × 10^D), 'R' acts as decimal (4R7 = 4.7 Ω)."
                android:textColor="@color/text_secondary"
                android:textSize="11sp"
                android:lineSpacingExtra="2dp" />
        </LinearLayout>

        <!-- About KimRosil App Studio Card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_card_elevated"
            android:orientation="vertical"
            android:padding="10dp"
            android:layout_marginBottom="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="KimRosil App Studio Company"
                android:textColor="@color/text_primary"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Offline-first Android freeware portfolio. Pure native framework performance without third-party bloatware, tracking, or network dependencies.\n\nWeb Portal: https://apps.kimrosil.com/ohmband/"
                android:textColor="@color/text_secondary"
                android:textSize="11sp"
                android:layout_marginTop="4dp" />
        </LinearLayout>

        <!-- Close Button -->
        <Button
            android:id="@+id/btnDialogClose"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:background="@drawable/bg_btn_primary"
            android:text="Close"
            android:textColor="@color/text_inverse"
            android:textSize="14sp"
            android:textStyle="bold"
            android:contentDescription="Close settings dialog" />

    </LinearLayout>
</ScrollView>
