<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_card_tactical"
    android:orientation="vertical"
    android:padding="20dp">

    <!-- Modal Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:layout_marginBottom="16dp">

        <ImageView
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:src="@drawable/ic_settings"
            android:tint="@color/m3_primary"
            android:contentDescription="@null" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:text="@string/settings_title"
            android:textColor="@color/m3_on_surface"
            android:textSize="18sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnCloseSettings"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:background="@drawable/bg_button_stepper"
            android:paddingHorizontal="16dp"
            android:text="@string/close_button"
            android:textColor="@color/m3_on_surface"
            android:textSize="13sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Appearance Theme Section -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/theme_appearance"
        android:textColor="@color/m3_primary"
        android:textSize="12sp"
        android:textStyle="bold"
        android:letterSpacing="0.05"
        android:layout_marginBottom="8dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="16dp">

        <Button
            android:id="@+id/btnThemeAuto"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:layout_marginEnd="4dp"
            android:background="@drawable/bg_chip_selected"
            android:text="@string/theme_system"
            android:textColor="@color/m3_on_primary"
            android:textSize="12sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnThemeLight"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:layout_marginHorizontal="2dp"
            android:background="@drawable/bg_chip_unselected"
            android:text="@string/theme_light"
            android:textColor="@color/m3_on_surface"
            android:textSize="12sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnThemeDark"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:layout_marginStart="4dp"
            android:background="@drawable/bg_chip_unselected"
            android:text="@string/theme_dark"
            android:textColor="@color/m3_on_surface"
            android:textSize="12sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Haptics Toggle Section -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:layout_marginBottom="16dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/haptics_label"
            android:textColor="@color/m3_on_surface"
            android:textSize="14sp"
            android:textStyle="bold" />

        <Switch
            android:id="@+id/switchHaptics"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:checked="true" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@drawable/divider_hairline"
        android:layout_marginBottom="16dp" />

    <!-- About KimRosil App Studio Card -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_card_tactical"
        android:orientation="vertical"
        android:padding="14dp"
        android:layout_marginBottom="12dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/about_studio_title"
            android:textColor="@color/m3_primary"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/about_studio_desc"
            android:textColor="@color/m3_on_surface_variant"
            android:textSize="12sp"
            android:lineSpacingExtra="2dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/version_label"
            android:textColor="@color/m3_text_muted"
            android:textSize="11sp" />

        <TextView
            android:id="@+id/tvPrivacyPolicyLink"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:gravity="center_vertical"
            android:text="@string/privacy_policy_label"
            android:textColor="@color/m3_primary"
            android:textSize="12sp"
            android:textStyle="bold" />
    </LinearLayout>

</LinearLayout>
