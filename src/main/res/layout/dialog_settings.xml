<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/card_sanctuary"
    android:padding="20dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="FlowStep Settings"
            android:textColor="@color/textPrimary"
            android:textSize="20sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="100% Offline-First by KimRosil App Studio"
            android:textColor="@color/m3_primary"
            android:textSize="13sp" />

        <!-- Theme Setting -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="Appearance Theme"
            android:textColor="@color/textPrimary"
            android:textSize="14sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnThemeAuto"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_weight="1"
                android:background="@drawable/chip_active"
                android:text="Auto"
                android:textAllCaps="false"
                android:textColor="@color/textPrimary"
                android:textSize="13sp" />

            <Button
                android:id="@+id/btnThemeLight"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:background="@drawable/chip_inactive"
                android:text="Light"
                android:textAllCaps="false"
                android:textColor="@color/textSecondary"
                android:textSize="13sp" />

            <Button
                android:id="@+id/btnThemeDark"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:background="@drawable/chip_inactive"
                android:text="Dark"
                android:textAllCaps="false"
                android:textColor="@color/textSecondary"
                android:textSize="13sp" />
        </LinearLayout>

        <!-- Optional Gemini Cloud AI -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="Optional Cloud AI (Gemini 3.8 Flash)"
            android:textColor="@color/textPrimary"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="Bring-Your-Own-Key. If blank or offline, FlowStep operates 100% offline using built-in deterministic heuristic rules."
            android:textColor="@color/textSecondary"
            android:textSize="12sp" />

        <EditText
            android:id="@+id/etApiKey"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:background="@drawable/edittext_calm"
            android:hint="Paste Google Gemini API Key (optional)"
            android:inputType="textPassword"
            android:textColor="@color/textPrimary"
            android:textColorHint="@color/m3_outline"
            android:textSize="14sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnSaveApiKey"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_weight="1"
                android:background="@drawable/btn_action"
                android:text="Save Key"
                android:textAllCaps="false"
                android:textColor="@color/btnTextColor"
                android:textSize="13sp" />

            <Button
                android:id="@+id/btnClearApiKey"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:background="@drawable/btn_m3_outlined"
                android:text="Clear / Use Offline"
                android:textAllCaps="false"
                android:textColor="@color/textSecondary"
                android:textSize="13sp" />
        </LinearLayout>

        <!-- Close button -->
        <Button
            android:id="@+id/btnCloseSettings"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginTop="22dp"
            android:background="@drawable/card_m3"
            android:text="Done"
            android:textAllCaps="false"
            android:textColor="@color/textPrimary"
            android:textSize="14sp" />
    </LinearLayout>
</ScrollView>
