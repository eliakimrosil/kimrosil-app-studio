<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/card_surface">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- Top Header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="16dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Settings"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="@color/text_primary" />

            <Button
                android:id="@+id/btnCloseSettings"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:minWidth="36dp"
                android:text="✕"
                android:textSize="14sp"
                android:textColor="@color/text_secondary"
                android:background="@drawable/btn_icon" />
        </LinearLayout>

        <!-- Section 1: Appearance / Theme Mode -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="APPEARANCE"
            android:textSize="11sp"
            android:textStyle="bold"
            android:textColor="@color/text_tertiary"
            android:letterSpacing="0.08"
            android:layout_marginBottom="8dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:orientation="horizontal"
            android:background="@drawable/card_surface_accent"
            android:padding="3dp"
            android:layout_marginBottom="20dp">

            <Button
                android:id="@+id/btnThemeAuto"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:text="◐ Auto"
                android:textSize="12sp"
                android:textStyle="bold"
                android:textColor="@color/text_primary"
                android:background="@drawable/chip_inactive" />

            <Button
                android:id="@+id/btnThemeLight"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:text="☀ Light"
                android:textSize="12sp"
                android:textStyle="bold"
                android:textColor="@color/text_primary"
                android:background="@drawable/chip_inactive"
                android:layout_marginStart="3dp"
                android:layout_marginEnd="3dp" />

            <Button
                android:id="@+id/btnThemeDark"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:text="🌙 Dark"
                android:textSize="12sp"
                android:textStyle="bold"
                android:textColor="@color/text_primary"
                android:background="@drawable/chip_inactive" />
        </LinearLayout>

        <!-- Section 2: Mini Google Profile & Cloud Sync -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="GOOGLE ACCOUNT &amp; SYNC"
            android:textSize="11sp"
            android:textStyle="bold"
            android:textColor="@color/text_tertiary"
            android:letterSpacing="0.08"
            android:layout_marginBottom="8dp" />

        <!-- Mini Profile Card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@drawable/card_surface_accent"
            android:padding="12dp"
            android:layout_marginBottom="10dp">

            <!-- Mini Avatar Container -->
            <FrameLayout
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:layout_marginEnd="12dp">

                <TextView
                    android:id="@+id/tvSettingsAvatar"
                    android:layout_width="38dp"
                    android:layout_height="38dp"
                    android:gravity="center"
                    android:text="👤"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="@color/primary_accent"
                    android:background="@drawable/chip_active" />

                <ImageView
                    android:id="@+id/ivSettingsAvatar"
                    android:layout_width="38dp"
                    android:layout_height="38dp"
                    android:scaleType="centerCrop"
                    android:visibility="gone" />
            </FrameLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvSettingsUserName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Not Signed In"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:textColor="@color/text_primary" />

                <TextView
                    android:id="@+id/tvSettingsUserEmail"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Sign in to sync habits across devices"
                    android:textSize="11sp"
                    android:textColor="@color/text_secondary"
                    android:maxLines="1"
                    android:ellipsize="end" />

                <TextView
                    android:id="@+id/tvSettingsSyncStatus"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="● Offline Mode"
                    android:textSize="10sp"
                    android:textColor="@color/text_tertiary"
                    android:layout_marginTop="2dp" />
            </LinearLayout>
        </LinearLayout>

        <!-- Account Action Buttons -->
        <LinearLayout
            android:id="@+id/layoutSettingsSignedInActions"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="20dp"
            android:visibility="gone">

            <Button
                android:id="@+id/btnSettingsSwitchAccount"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_weight="1"
                android:text="Switch Account"
                android:textSize="12sp"
                android:textStyle="bold"
                android:textColor="@color/text_primary"
                android:background="@drawable/btn_secondary"
                android:layout_marginEnd="6dp" />

            <Button
                android:id="@+id/btnSettingsSignOut"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_weight="1"
                android:text="Sign Out"
                android:textSize="12sp"
                android:textColor="@color/cat_body"
                android:background="@drawable/btn_icon" />
        </LinearLayout>

        <Button
            android:id="@+id/btnSettingsSignIn"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:text="Sign in with Google Account"
            android:textSize="13sp"
            android:textStyle="bold"
            android:textColor="@color/text_on_accent"
            android:background="@drawable/btn_primary"
            android:layout_marginBottom="20dp" />

        <!-- Section 3: About KR Habit -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="ABOUT"
            android:textSize="11sp"
            android:textStyle="bold"
            android:textColor="@color/text_tertiary"
            android:letterSpacing="0.08"
            android:layout_marginBottom="8dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/card_surface_accent"
            android:padding="14dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="KR Habit v1.2.3"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="@color/text_primary" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Offline-first habit tracking with seamless Google Account cloud synchronization. Built with pure native Android framework components."
                android:textSize="12sp"
                android:textColor="@color/text_secondary"
                android:lineSpacingExtra="2dp"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="10dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="GPLv3 Open Source"
                    android:textSize="10sp"
                    android:textStyle="bold"
                    android:textColor="@color/primary_accent"
                    android:background="@drawable/chip_active"
                    android:paddingHorizontal="8dp"
                    android:paddingVertical="3dp"
                    android:layout_marginEnd="6dp" />

                <TextView
                    android:id="@+id/tvSettingsWebLink"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="apps.kimrosil.com/kr-habit"
                    android:textSize="10sp"
                    android:textColor="@color/text_secondary"
                    android:background="@drawable/chip_inactive"
                    android:paddingHorizontal="8dp"
                    android:paddingVertical="3dp" />
            </LinearLayout>
        </LinearLayout>

    </LinearLayout>
</ScrollView>
