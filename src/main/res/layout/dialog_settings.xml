<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/bg_card"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Title -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Settings &amp; NEC Standards"
            android:textColor="@color/text_primary"
            android:textSize="18sp"
            android:textStyle="bold"
            android:layout_marginBottom="12dp" />

        <!-- Theme Selection Card -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Appearance Theme"
            android:textColor="@color/text_secondary"
            android:textSize="12sp"
            android:textStyle="bold"
            android:layout_marginBottom="6dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="16dp">

            <Button
                android:id="@+id/btnThemeDark"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:background="@drawable/bg_btn_secondary"
                android:text="Dark"
                android:textColor="@color/text_primary"
                android:textSize="12sp"
                android:contentDescription="Select dark industrial theme" />

            <Space
                android:layout_width="6dp"
                android:layout_height="match_parent" />

            <Button
                android:id="@+id/btnThemeLight"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:background="@drawable/bg_btn_secondary"
                android:text="Light"
                android:textColor="@color/text_primary"
                android:textSize="12sp"
                android:contentDescription="Select light blueprint theme" />

            <Space
                android:layout_width="6dp"
                android:layout_height="match_parent" />

            <Button
                android:id="@+id/btnThemeAuto"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:background="@drawable/bg_btn_secondary"
                android:text="Auto"
                android:textColor="@color/text_primary"
                android:textSize="12sp"
                android:contentDescription="Follow system appearance theme" />
        </LinearLayout>

        <!-- NEC Fill Rules Card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_card_elevated"
            android:orientation="vertical"
            android:padding="10dp"
            android:layout_marginBottom="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="NEC Chapter 9 Table 1 Fill Rules"
                android:textColor="@color/text_primary"
                android:textSize="12sp"
                android:textStyle="bold"
                android:layout_marginBottom="4dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="• 1 Conductor: 53% max allowable cross-sectional fill.\n\n• 2 Conductors: 31% max allowable fill.\n\n• 3+ Conductors: 40% max allowable fill.\n\n• 60% Nipple Rule (Note 4): For conduits not exceeding 24 in. (600 mm), 60% fill is permitted without ampacity derating.\n\n• Jam Ratio Warning: When pulling 3 cables through raceways where D/d is between 2.8 and 3.2, cables can jam abreast and rupture insulation."
                android:textColor="@color/text_secondary"
                android:textSize="11sp"
                android:lineSpacingExtra="2dp" />
        </LinearLayout>

        <!-- About KimRosil App Studio Card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_card_elevated"
            android:orientation="vertical"
            android:padding="10dp"
            android:layout_marginBottom="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="KimRosil App Studio Company"
                android:textColor="@color/text_primary"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Offline-first Android freeware portfolio. Pure native framework performance without third-party bloatware, tracking, or network dependencies.\n\nWeb Portal: https://apps.kimrosil.com/conduitfill/"
                android:textColor="@color/text_secondary"
                android:textSize="11sp"
                android:layout_marginTop="4dp" />
        </LinearLayout>

        <!-- Close Button -->
        <Button
            android:id="@+id/btnDialogClose"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:background="@drawable/bg_btn_primary"
            android:text="Close"
            android:textColor="@color/text_inverse"
            android:textSize="14sp"
            android:textStyle="bold"
            android:contentDescription="Close settings dialog" />

    </LinearLayout>
</ScrollView>
