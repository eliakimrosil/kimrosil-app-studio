<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="@color/m3_surface">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Up-Navigation Toolbar / Header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="16dp">

            <Button
                android:id="@+id/btnBack"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:minHeight="48dp"
                android:text="&lt; Back"
                android:textSize="13sp"
                android:textColor="@color/m3_on_surface"
                android:background="@drawable/bg_card_outline"
                android:contentDescription="Return to Workbench Deck"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:layout_marginEnd="12dp" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Planing Parameter Inspector"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="@color/m3_on_surface" />
        </LinearLayout>

        <!-- Species Parameter Card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_card_container"
            android:padding="14dp"
            android:layout_marginBottom="14dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="SPECIES &amp; JANKA SPECIFICATION"
                android:textSize="11sp"
                android:textStyle="bold"
                android:textColor="@color/m3_on_surface_variant"
                android:layout_marginBottom="8dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Species Name:"
                android:textSize="13sp"
                android:textColor="@color/m3_on_surface"
                android:layout_marginBottom="2dp" />

            <EditText
                android:id="@+id/etSpeciesName"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:minHeight="48dp"
                android:background="@drawable/bg_input_field"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:textSize="14sp"
                android:textColor="@color/m3_on_surface"
                android:contentDescription="Edit species name"
                android:layout_marginBottom="8dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Janka Hardness Rating (lbf):"
                android:textSize="13sp"
                android:textColor="@color/m3_on_surface"
                android:layout_marginBottom="2dp" />

            <EditText
                android:id="@+id/etJankaInput"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:minHeight="48dp"
                android:inputType="number"
                android:background="@drawable/bg_input_field"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:textSize="14sp"
                android:textColor="@color/m3_on_surface"
                android:contentDescription="Input numeric timber hardness rating" />
        </LinearLayout>

        <!-- Angle Tuning Card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_card_container"
            android:padding="14dp"
            android:layout_marginBottom="14dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="PLANE BED &amp; HONING PITCH"
                android:textSize="11sp"
                android:textStyle="bold"
                android:textColor="@color/m3_on_surface_variant"
                android:layout_marginBottom="6dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Effective Cutting Wedge:"
                    android:textSize="13sp"
                    android:textColor="@color/m3_on_surface" />

                <TextView
                    android:id="@+id/tvDetailAngleValue"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="45° Bed / Hone"
                    android:textStyle="bold"
                    android:textSize="13sp"
                    android:textColor="@color/m3_primary" />
            </LinearLayout>

            <SeekBar
                android:id="@+id/sbDetailCuttingAngle"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:minHeight="48dp"
                android:contentDescription="Adjust effective cutting wedge angle" />
        </LinearLayout>

        <!-- Calculated Guidance & Mechanics Readout -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_hero_card"
            android:padding="14dp"
            android:layout_marginBottom="16dp">

            <TextView
                android:id="@+id/tvCalculatedGuidance"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Analyzing fiber dynamics..."
                android:textSize="13sp"
                android:lineSpacingExtra="3dp"
                android:textColor="@color/m3_on_surface" />
        </LinearLayout>

        <!-- Action Controls: Save & Export -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnSaveDetail"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:minHeight="48dp"
                android:layout_weight="1"
                android:text="Save Record"
                android:textSize="13sp"
                android:textColor="@color/m3_on_primary"
                android:background="@drawable/bg_button_tool"
                android:contentDescription="Save updated parameter configurations"
                android:layout_marginEnd="8dp" />

            <Button
                android:id="@+id/btnExportShare"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:minHeight="48dp"
                android:layout_weight="1"
                android:text="Export &amp; Share"
                android:textSize="13sp"
                android:textColor="@color/m3_on_surface"
                android:background="@drawable/bg_card_outline"
                android:contentDescription="Export setup to clipboard or share sheet" />
        </LinearLayout>

    </LinearLayout>
</ScrollView>