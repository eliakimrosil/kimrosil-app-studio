<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/card_surface"
    android:padding="20dp">

    <!-- Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="16dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Google Account"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="@color/text_primary" />

        <Button
            android:id="@+id/btnCloseSyncDialog"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:minWidth="38dp"
            android:text="✕"
            android:textSize="14sp"
            android:textColor="@color/text_secondary"
            android:background="@drawable/btn_icon"
            android:stateListAnimator="@null"
            android:elevation="0dp" />
    </LinearLayout>

    <!-- User Account Profile Card -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@drawable/card_surface_subtle"
        android:padding="14dp"
        android:layout_marginBottom="14dp">

        <!-- Avatar Container: Photo or Initial Fallback -->
        <FrameLayout
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginEnd="12dp">

            <TextView
                android:id="@+id/tvUserAvatar"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:gravity="center"
                android:text="👤"
                android:textSize="20sp"
                android:textStyle="bold"
                android:textColor="@color/text_primary"
                android:background="@drawable/bg_avatar_placeholder" />

            <ImageView
                android:id="@+id/ivUserAvatar"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:scaleType="centerCrop"
                android:visibility="gone" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvUserName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Not Signed In"
                android:textSize="15sp"
                android:textStyle="bold"
                android:textColor="@color/text_primary" />

            <TextView
                android:id="@+id/tvUserEmail"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Sign in to sync habits across all your devices"
                android:textSize="12sp"
                android:textColor="@color/text_secondary"
                android:maxLines="1"
                android:ellipsize="end" />
        </LinearLayout>
    </LinearLayout>

    <!-- Sync Status Details -->
    <TextView
        android:id="@+id/tvSyncStatusDetails"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Offline Mode • Local SQLite active"
        android:textSize="12sp"
        android:textColor="@color/text_tertiary"
        android:layout_marginBottom="14dp" />

    <!-- Container for Signed-Out State -->
    <LinearLayout
        android:id="@+id/layoutSignedOutActions"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <Button
            android:id="@+id/btnPickGoogleAccountDevice"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:text="Select Google Account on Device"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="@color/text_on_accent"
            android:background="@drawable/btn_primary"
            android:stateListAnimator="@null"
            android:elevation="0dp"
            android:layout_marginBottom="12dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Or sync using your Google email address:"
            android:textSize="12sp"
            android:textColor="@color/text_secondary"
            android:layout_marginBottom="6dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <EditText
                android:id="@+id/etGoogleAccountEmail"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_weight="1"
                android:background="@drawable/edittext_bg"
                android:paddingHorizontal="12dp"
                android:hint="eliakimrosilarts@gmail.com"
                android:inputType="textEmailAddress"
                android:textSize="13sp"
                android:textColor="@color/text_primary"
                android:textColorHint="@color/text_tertiary"
                android:layout_marginEnd="8dp" />

            <Button
                android:id="@+id/btnConnectManualEmail"
                android:layout_width="wrap_content"
                android:layout_height="44dp"
                android:paddingHorizontal="16dp"
                android:text="Connect"
                android:textSize="13sp"
                android:textStyle="bold"
                android:textColor="@color/text_on_accent"
                android:background="@drawable/btn_primary"
                android:stateListAnimator="@null"
                android:elevation="0dp" />
        </LinearLayout>
    </LinearLayout>

    <!-- Container for Signed-In State -->
    <LinearLayout
        android:id="@+id/layoutSignedInActions"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:visibility="gone">

        <Button
            android:id="@+id/btnSwitchGoogleAccount"
            android:layout_width="match_parent"
            android:layout_height="46dp"
            android:text="Switch Google Account"
            android:textSize="13sp"
            android:textStyle="bold"
            android:textColor="@color/text_primary"
            android:background="@drawable/btn_secondary"
            android:stateListAnimator="@null"
            android:elevation="0dp"
            android:layout_marginBottom="8dp" />

        <Button
            android:id="@+id/btnGoogleSignOut"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:text="Sign Out (Keep Local Only)"
            android:textSize="13sp"
            android:textColor="@color/cat_body"
            android:background="@drawable/btn_icon"
            android:stateListAnimator="@null"
            android:elevation="0dp" />
    </LinearLayout>

</LinearLayout>
