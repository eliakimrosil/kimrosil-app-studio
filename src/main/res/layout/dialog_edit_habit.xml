<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/card_surface"
    android:padding="20dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Edit Habit"
        android:textSize="18sp"
        android:textStyle="bold"
        android:textColor="@color/text_primary"
        android:layout_marginBottom="16dp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="HABIT NAME"
        android:textSize="11sp"
        android:textStyle="bold"
        android:textColor="@color/text_tertiary"
        android:layout_marginBottom="4dp" />

    <EditText
        android:id="@+id/etEditHabitTitle"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:hint="@string/hint_habit_title"
        android:textSize="14sp"
        android:textColor="@color/text_primary"
        android:textColorHint="@color/text_tertiary"
        android:background="@drawable/edittext_bg"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:inputType="textCapSentences"
        android:maxLines="1"
        android:layout_marginBottom="14dp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="CATEGORY"
        android:textSize="11sp"
        android:textStyle="bold"
        android:textColor="@color/text_tertiary"
        android:layout_marginBottom="4dp" />

    <Spinner
        android:id="@+id/spinnerEditCategory"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:background="@drawable/edittext_bg"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:layout_marginBottom="14dp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="NOTES OR ROUTINE CUE"
        android:textSize="11sp"
        android:textStyle="bold"
        android:textColor="@color/text_tertiary"
        android:layout_marginBottom="4dp" />

    <EditText
        android:id="@+id/etEditHabitDesc"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:hint="@string/hint_habit_desc"
        android:textSize="14sp"
        android:textColor="@color/text_primary"
        android:textColorHint="@color/text_tertiary"
        android:background="@drawable/edittext_bg"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:inputType="textCapSentences"
        android:maxLines="1"
        android:layout_marginBottom="20dp" />

    <!-- Action Buttons -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="end">

        <Button
            android:id="@+id/btnCancelEdit"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:minWidth="80dp"
            android:text="@string/action_cancel"
            android:textSize="14sp"
            android:textColor="@color/text_secondary"
            android:background="@drawable/btn_secondary"
            android:stateListAnimator="@null"
            android:elevation="0dp"
            android:layout_marginEnd="10dp" />

        <Button
            android:id="@+id/btnSaveEditHabit"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:minWidth="100dp"
            android:text="@string/action_save"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="@color/text_on_accent"
            android:background="@drawable/btn_primary"
            android:stateListAnimator="@null"
            android:elevation="0dp" />
    </LinearLayout>

</LinearLayout>
