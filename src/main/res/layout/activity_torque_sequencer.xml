<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:scrollbars="none"
    android:background="@color/m3_surface">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Up-Navigation Toolbar -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingBottom="12dp">

            <Button
                android:id="@+id/btnToolbarBack"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:text="&lt; Back"
                android:textSize="12sp"
                android:background="@drawable/bg_technical_button"
                android:textColor="@color/m3_on_surface"
                android:layout_marginEnd="12dp"
                android:contentDescription="Return to flange specification selector" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvSequencerTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="ASME B16.5 4&quot; (150#)"
                    android:textSize="17sp"
                    android:textStyle="bold"
                    android:textColor="@color/m3_on_surface" />

                <TextView
                    android:id="@+id/tvSequencerSubtitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Socket: 1-1/16&quot; | Stud: 5/8&quot;"
                    android:textSize="11sp"
                    android:textColor="@color/m3_on_surface_variant" />
            </LinearLayout>
        </LinearLayout>

        <!-- Stage Stepper Jump Bar -->
        <LinearLayout
            android:id="@+id/llPassJumpBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="10dp">

            <Button
                android:id="@+id/btnJumpPass1"
                android:layout_width="0dp"
                android:layout_height="36dp"
                android:layout_weight="1"
                android:text="P1 (30%)"
                android:textSize="10sp"
                android:textStyle="bold"
                android:background="@drawable/bg_chip_selected"
                android:textColor="@color/m3_on_primary"
                android:layout_marginEnd="3dp"
                android:contentDescription="Jump to Pass 1: 30 percent target torque" />

            <Button
                android:id="@+id/btnJumpPass2"
                android:layout_width="0dp"
                android:layout_height="36dp"
                android:layout_weight="1"
                android:text="P2 (60%)"
                android:textSize="10sp"
                android:textStyle="bold"
                android:background="@drawable/bg_chip_unselected"
                android:textColor="@color/m3_on_surface"
                android:layout_marginEnd="3dp"
                android:contentDescription="Jump to Pass 2: 60 percent target torque" />

            <Button
                android:id="@+id/btnJumpPass3"
                android:layout_width="0dp"
                android:layout_height="36dp"
                android:layout_weight="1"
                android:text="P3 (100%)"
                android:textSize="10sp"
                android:textStyle="bold"
                android:background="@drawable/bg_chip_unselected"
                android:textColor="@color/m3_on_surface"
                android:layout_marginEnd="3dp"
                android:contentDescription="Jump to Pass 3: 100 percent target torque" />

            <Button
                android:id="@+id/btnJumpPass4"
                android:layout_width="0dp"
                android:layout_height="36dp"
                android:layout_weight="1"
                android:text="P4 (Check)"
                android:textSize="10sp"
                android:textStyle="bold"
                android:background="@drawable/bg_chip_unselected"
                android:textColor="@color/m3_on_surface"
                android:contentDescription="Jump to Pass 4: 100 percent final rotational check" />
        </LinearLayout>

        <!-- Current Pass Indicator Badge -->
        <TextView
            android:id="@+id/tvPassBadge"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Pass 1: 30% Target (Star Sequence)"
            android:textSize="12sp"
            android:textStyle="bold"
            android:textColor="@color/m3_on_primary"
            android:background="@drawable/bg_badge_primary"
            android:padding="8dp"
            android:gravity="center"
            android:layout_marginBottom="12dp"
            android:contentDescription="Current tightening pass description badge" />

        <!-- Radial Flange Canvas Gauge -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_workshop_card"
            android:padding="12dp"
            android:layout_marginBottom="14dp">

            <com.kimrosil.flangematch.FlangeDiagramView
                android:id="@+id/flangeHUD"
                android:layout_width="match_parent"
                android:layout_height="280dp"
                android:layout_gravity="center"
                android:contentDescription="Interactive circular bolt sequence HUD" />
        </LinearLayout>

        <!-- Active Bolt HUD Readout -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_workshop_card"
            android:padding="16dp"
            android:layout_marginBottom="14dp">

            <TextView
                android:id="@+id/tvActiveBoltTelemetry"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="TIGHTEN BOLT #1"
                android:textSize="22sp"
                android:textStyle="bold"
                android:textColor="@color/color_amber_active" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="8dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Stage Torque Setting:"
                    android:textSize="13sp"
                    android:textColor="@color/m3_on_surface_variant" />

                <TextView
                    android:id="@+id/tvStageTorqueReadout"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="18.0 ft-lb"
                    android:textSize="22sp"
                    android:textStyle="bold"
                    android:textColor="@color/m3_primary" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvProgressReadout"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Bolt 1 of 8 (Completed: 0/8)"
                android:textSize="12sp"
                android:textColor="@color/m3_on_surface_variant" />
        </LinearLayout>

        <!-- Stepper Controls Deck -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="10dp">

            <Button
                android:id="@+id/btnPrevBolt"
                android:layout_width="0dp"
                android:layout_height="52dp"
                android:layout_weight="1"
                android:layout_marginEnd="6dp"
                android:text="&lt; PREV BOLT"
                android:background="@drawable/bg_technical_button"
                android:textColor="@color/m3_on_surface"
                android:textStyle="bold"
                android:contentDescription="Go to previous bolt in current sequence" />

            <Button
                android:id="@+id/btnNextBolt"
                android:layout_width="0dp"
                android:layout_height="52dp"
                android:layout_weight="1"
                android:layout_marginStart="6dp"
                android:text="NEXT BOLT &gt;"
                android:background="@drawable/bg_primary_tactile_button"
                android:textColor="@color/m3_on_primary"
                android:textStyle="bold"
                android:contentDescription="Mark current bolt complete and advance to next bolt" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="14dp">

            <Button
                android:id="@+id/btnResetPass"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:minWidth="90dp"
                android:text="Reset Stage"
                android:textSize="11sp"
                android:background="@drawable/bg_technical_button"
                android:textColor="@color/m3_on_surface_variant"
                android:layout_marginEnd="8dp"
                android:contentDescription="Reset progress for current pass" />

            <Button
                android:id="@+id/btnConfirmPass"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:text="CONFIRM STAGE &gt;"
                android:background="@drawable/bg_technical_button"
                android:textColor="@color/m3_on_surface"
                android:textStyle="bold"
                android:contentDescription="Confirm current pass tightening and advance stage" />
        </LinearLayout>

        <!-- Completion Banner -->
        <LinearLayout
            android:id="@+id/cardCompletionBanner"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_completion_card"
            android:padding="16dp"
            android:visibility="gone"
            android:layout_marginBottom="24dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="100% FLANGE TORQUE VERIFIED"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="@color/color_verified_green"
                android:layout_marginBottom="4dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="All 4 tightening stages (30%, 60%, 100%, and 100% rotational check) executed cleanly according to ASME PCC-1 guidelines. Session saved in offline database."
                android:textSize="12sp"
                android:textColor="@color/m3_on_surface"
                android:layout_marginBottom="14dp" />

            <Button
                android:id="@+id/btnShareLog"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:text="EXPORT INSPECTION CERTIFICATE"
                android:background="@drawable/bg_primary_tactile_button"
                android:textColor="@color/m3_on_primary"
                android:textStyle="bold"
                android:layout_marginBottom="8dp"
                android:contentDescription="Share inspection verification certificate text" />

            <Button
                android:id="@+id/btnExportCsv"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:text="EXPORT INSPECTION CSV"
                android:background="@drawable/bg_technical_button"
                android:textColor="@color/m3_on_surface"
                android:contentDescription="Export inspection log as CSV formatted data" />
        </LinearLayout>

    </LinearLayout>
</ScrollView>