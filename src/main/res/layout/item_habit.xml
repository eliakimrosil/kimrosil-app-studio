<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/cardHabitItem"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/card_surface"
    android:padding="16dp"
    android:layout_marginBottom="12dp">

    <!-- Top Row: Reminder Badge, Frequency & Streak Counter -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="8dp">

        <TextView
            android:id="@+id/tvReminderBadge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🔔 08:00 AM"
            android:textSize="11sp"
            android:textStyle="bold"
            android:textColor="@color/primary_accent"
            android:background="@drawable/chip_active"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:paddingTop="3dp"
            android:paddingBottom="3dp"
            android:layout_marginEnd="8dp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/tvFrequencyTarget"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Daily"
            android:textSize="12sp"
            android:textColor="@color/text_tertiary" />

        <TextView
            android:id="@+id/tvStreakBadge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🔥 0d"
            android:textSize="13sp"
            android:textStyle="bold"
            android:textColor="@color/metric_streak" />
    </LinearLayout>

    <!-- Middle Row: Habit Title, Description & Big Check-In Button -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="12dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:paddingEnd="12dp">

            <TextView
                android:id="@+id/tvHabitTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Drink 2L Water"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="@color/text_primary"
                android:maxLines="2"
                android:ellipsize="end" />

            <TextView
                android:id="@+id/tvHabitDesc"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Hydrate throughout morning work sprint"
                android:textSize="12sp"
                android:textColor="@color/text_secondary"
                android:maxLines="1"
                android:ellipsize="end"
                android:layout_marginTop="2dp" />
        </LinearLayout>

        <!-- Big Tactile Check-In Button -->
        <Button
            android:id="@+id/btnCheckIn"
            android:layout_width="54dp"
            android:layout_height="50dp"
            android:minWidth="48dp"
            android:minHeight="48dp"
            android:text="✓"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="@color/text_secondary"
            android:background="@drawable/btn_checkin_pending"
            android:stateListAnimator="@null"
            android:elevation="0dp" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/border_hairline"
        android:layout_marginBottom="10dp" />

    <!-- Bottom Row: Loop Habit Strength Score & 14-Day Activity Dots Container -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Strength: "
            android:textSize="11sp"
            android:textColor="@color/text_tertiary" />

        <TextView
            android:id="@+id/tvStrengthScore"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="85%"
            android:textSize="12sp"
            android:textStyle="bold"
            android:textColor="@color/metric_strength"
            android:layout_marginEnd="12dp" />

        <!-- 14-Day Micro Heatmap Container -->
        <LinearLayout
            android:id="@+id/layoutMicroHeatmap"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="end|center_vertical"
            android:orientation="horizontal" />
    </LinearLayout>

</LinearLayout>
