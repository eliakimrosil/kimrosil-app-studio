<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/cardHabitItem"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/card_surface"
    android:padding="16dp"
    android:layout_marginBottom="12dp">

    <!-- Top Row: Frequency/Reminder & Streak Flame Counter (krhabit.jpg) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="8dp">

        <TextView
            android:id="@+id/tvFrequencyTarget"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Daily"
            android:textSize="13sp"
            android:textColor="@color/text_secondary" />

        <TextView
            android:id="@+id/tvStreakBadge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🔥 1d"
            android:textSize="13sp"
            android:textStyle="bold"
            android:textColor="@color/metric_streak" />
    </LinearLayout>

    <!-- Middle Row: Habit Title, Cue & Circular Check-In Button -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="12dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:paddingEnd="12dp">

            <TextView
                android:id="@+id/tvHabitTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Deep Focus Reading"
                android:textSize="17sp"
                android:textStyle="bold"
                android:textColor="@color/text_primary"
                android:maxLines="2"
                android:ellipsize="end" />

            <TextView
                android:id="@+id/tvHabitDesc"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="20 minutes reading before sleep"
                android:textSize="13sp"
                android:textColor="@color/text_secondary"
                android:maxLines="1"
                android:ellipsize="end"
                android:layout_marginTop="3dp" />
        </LinearLayout>

        <!-- Circular Check-In Button (48x48dp matching krhabit.jpg) -->
        <Button
            android:id="@+id/btnCheckIn"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:minWidth="48dp"
            android:minHeight="48dp"
            android:text="✓"
            android:textSize="22sp"
            android:textStyle="bold"
            android:textColor="@color/btn_pending_icon"
            android:background="@drawable/btn_checkin_circle_pending"
            android:stateListAnimator="@null"
            android:elevation="0dp" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/border_hairline"
        android:layout_marginBottom="12dp" />

    <!-- Bottom Row: Strength Score & Continuous Capsule Progress Bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Strength: "
            android:textSize="12sp"
            android:textColor="@color/text_secondary" />

        <TextView
            android:id="@+id/tvStrengthScore"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="7%"
            android:textSize="12sp"
            android:textStyle="bold"
            android:textColor="@color/metric_strength"
            android:layout_marginEnd="12dp" />

        <!-- Continuous Capsule Progress Bar (Matching krhabit.jpg) -->
        <ProgressBar
            android:id="@+id/pbStrength"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="0dp"
            android:layout_height="8dp"
            android:layout_weight="1"
            android:max="100"
            android:progress="7"
            android:progressDrawable="@drawable/capsule_progress_bar" />
    </LinearLayout>

</LinearLayout>
