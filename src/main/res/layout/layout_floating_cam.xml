<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/pipRoot"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:clipToOutline="true"
    android:elevation="8dp">

    <!-- Camera Preview Container -->
    <FrameLayout
        android:id="@+id/pipCameraContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/bg_floating_cam_standby"
        android:clipToOutline="true">

        <!-- Camera Video Preview Surface (Full Frame) -->
        <TextureView
            android:id="@+id/pipCameraView"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <!-- Header / Drag Bar & Action Controls (Floating Overlay on Top) -->
        <HorizontalScrollView
            android:id="@+id/pipHeaderScroll"
            android:layout_width="match_parent"
            android:layout_height="32dp"
            android:layout_gravity="top"
            android:background="@drawable/bg_floating_cam_header"
            android:fillViewport="true"
            android:scrollbars="none">

            <LinearLayout
                android:id="@+id/pipHeader"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="6dp"
                android:paddingEnd="6dp">

                <TextView
                    android:id="@+id/pipBadge"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:gravity="center_vertical"
                    android:letterSpacing="0.04"
                    android:paddingStart="2dp"
                    android:paddingEnd="4dp"
                    android:text="●"
                    android:textColor="#00E5FF"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <View
                    android:id="@+id/pipHeaderSpacer"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:minWidth="6dp" />

                <!-- Flip Front/Back Camera -->
                <TextView
                    android:id="@+id/pipBtnFlip"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:background="@drawable/btn_pip_action"
                    android:clickable="true"
                    android:contentDescription="Flip Camera"
                    android:focusable="true"
                    android:gravity="center"
                    android:text="⇄"
                    android:textColor="#FFFFFF"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <!-- Cycle Aspect Ratio & Mask (3:4 ➔ 16:9 ➔ 1:1 ➔ ◯) -->
                <TextView
                    android:id="@+id/pipBtnShape"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_marginStart="3dp"
                    android:background="@drawable/btn_pip_action"
                    android:clickable="true"
                    android:contentDescription="Cycle Aspect Ratio"
                    android:focusable="true"
                    android:gravity="center"
                    android:text="▯"
                    android:textColor="#00E5FF"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <!-- Start / Stop Broadcast (Go Live) -->
                <TextView
                    android:id="@+id/pipBtnBroadcast"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_marginStart="3dp"
                    android:background="@drawable/btn_pip_broadcast_standby"
                    android:clickable="true"
                    android:contentDescription="Start Broadcast"
                    android:focusable="true"
                    android:gravity="center"
                    android:text="▶"
                    android:textColor="#EF4444"
                    android:textSize="12sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </HorizontalScrollView>
    </FrameLayout>
</FrameLayout>
