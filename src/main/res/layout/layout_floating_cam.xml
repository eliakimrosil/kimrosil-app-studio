<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/pipRoot"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:clipToOutline="true"
    android:elevation="8dp">

    <!-- Camera Preview Container -->
    <FrameLayout
        android:id="@+id/pipCameraContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/bg_floating_cam_standby"
        android:clipToOutline="true">

        <!-- Camera Video Preview Surface (Full Frame) -->
        <TextureView
            android:id="@+id/pipCameraView"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <!-- Header / Drag Bar & Action Controls (Floating Overlay on Top) -->
        <LinearLayout
            android:id="@+id/pipHeader"
            android:layout_width="match_parent"
            android:layout_height="34dp"
            android:layout_gravity="top"
            android:background="@drawable/bg_floating_cam_header"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="6dp"
            android:paddingEnd="6dp">

            <TextView
                android:id="@+id/pipBadge"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:gravity="center_vertical"
                android:letterSpacing="0.04"
                android:paddingStart="2dp"
                android:paddingEnd="2dp"
                android:text="●"
                android:textColor="#00E5FF"
                android:textSize="12sp"
                android:textStyle="bold" />

            <View
                android:id="@+id/pipHeaderSpacer"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1" />

            <!-- Rotate Floating Camera (0° / 90° / 180° / 270°) -->
            <TextView
                android:id="@+id/pipBtnRotate"
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:background="@drawable/btn_pip_action"
                android:clickable="true"
                android:contentDescription="Rotate Camera"
                android:focusable="true"
                android:gravity="center"
                android:text="↻"
                android:textColor="#00E5FF"
                android:textSize="15sp"
                android:textStyle="bold" />

            <!-- Flip Front/Back Camera -->
            <TextView
                android:id="@+id/pipBtnFlip"
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:layout_marginStart="4dp"
                android:background="@drawable/btn_pip_action"
                android:clickable="true"
                android:contentDescription="Flip Camera"
                android:focusable="true"
                android:gravity="center"
                android:text="⇄"
                android:textColor="#FFFFFF"
                android:textSize="13sp"
                android:textStyle="bold" />

            <!-- Cycle Aspect Ratio & Mask (3:4 ➔ 16:9 ➔ 1:1 ➔ ◯) -->
            <TextView
                android:id="@+id/pipBtnShape"
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:layout_marginStart="4dp"
                android:background="@drawable/btn_pip_action"
                android:clickable="true"
                android:contentDescription="Cycle Aspect Ratio"
                android:focusable="true"
                android:gravity="center"
                android:text="▯"
                android:textColor="#00E5FF"
                android:textSize="12sp"
                android:textStyle="bold" />

            <!-- Cycle Window Size (Compact / Studio / Large) -->
            <TextView
                android:id="@+id/pipBtnSize"
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:layout_marginStart="4dp"
                android:background="@drawable/btn_pip_action"
                android:clickable="true"
                android:contentDescription="Cycle Window Size"
                android:focusable="true"
                android:gravity="center"
                android:text="⛶"
                android:textColor="#FFFFFF"
                android:textSize="11sp"
                android:textStyle="bold" />

            <!-- Dock / Minimize into Edge Bubble -->
            <TextView
                android:id="@+id/pipBtnDock"
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:layout_marginStart="4dp"
                android:background="@drawable/btn_pip_action"
                android:clickable="true"
                android:contentDescription="Dock to Edge Bubble"
                android:focusable="true"
                android:gravity="center"
                android:text="⇲"
                android:textColor="#38BDF8"
                android:textSize="13sp"
                android:textStyle="bold" />

            <!-- Close / Hide Overlay -->
            <TextView
                android:id="@+id/pipBtnClose"
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:layout_marginStart="4dp"
                android:background="@drawable/btn_pip_action"
                android:clickable="true"
                android:contentDescription="Close Facecam"
                android:focusable="true"
                android:gravity="center"
                android:text="✕"
                android:textColor="#FF6B6B"
                android:textSize="12sp"
                android:textStyle="bold" />
        </LinearLayout>
    </FrameLayout>

    <!-- Docked Bubble Container (Visible only when minimized into bubble) -->
    <LinearLayout
        android:id="@+id/pipBubbleContainer"
        android:layout_width="54dp"
        android:layout_height="54dp"
        android:background="@drawable/bg_floating_cam_bubble_standby"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center"
        android:orientation="vertical"
        android:visibility="gone">

        <TextView
            android:id="@+id/pipBubbleIcon"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="📷"
            android:textSize="18sp" />

        <TextView
            android:id="@+id/pipBubbleBadge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:letterSpacing="0.05"
            android:text="CAM"
            android:textColor="#00E5FF"
            android:textSize="9sp"
            android:textStyle="bold" />
    </LinearLayout>
</FrameLayout>
